<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Proposed new terms - AI Gene Review</title>
    {% include "_site_style.html.j2" %}
</head>
<body>
<div class="page">
    <div class="panel">
        <div class="crumbs"><a href="index.html">Feedback to resources</a></div>
        <h1>Proposed new terms</h1>
        <p class="muted">{{ terms | length }} proposals from the top-level <code>proposed_new_terms</code>
            of gene and module reviews. <a href="proposed-new-terms.tsv">Download TSV</a>.</p>
        <input class="search" type="search" placeholder="Filter proposals" aria-label="Filter proposals" data-search>
        <div class="table-wrap"><table data-table>
            <thead><tr><th>Proposed term</th><th>Parent</th><th>From</th><th>Definition and justification</th></tr></thead>
            <tbody>
            {% for t in terms %}
            <tr>
                <td>{{ t.proposed_name }}</td>
                <td>{% if t.proposed_parent_label %}{{ t.proposed_parent_label }}<br>{% endif %}<span class="id">{{ t.proposed_parent_id }}</span></td>
                <td>{{ t.gene_symbol or t.review_id }}<br><span class="id">{{ t.taxon_label }}</span></td>
                <td>{% if t.proposed_definition %}<p>{{ t.proposed_definition }}</p>{% endif %}
                    {% if t.justification %}<details><summary>Justification</summary><p>{{ t.justification }}</p></details>{% endif %}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table></div>
    </div>
</div>
<script>
    const body = document.querySelector("[data-table]").tBodies[0];
    document.querySelector("[data-search]").addEventListener("input", (event) => {
        const query = event.target.value.toLowerCase();
        for (const row of body.rows) row.hidden = !row.textContent.toLowerCase().includes(query);
    });
</script>
</body>
</html>

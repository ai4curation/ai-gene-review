<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GO-CAM reviews - AI Gene Review</title>
    {% include "_gocam_style.html.j2" %}
</head>
<body>
<div class="page">
    <div class="panel">
        <div class="crumbs"><a href="{{ home_href }}">AI Gene Review</a></div>
        <h1>GO-CAM reviews</h1>
        <p class="muted">Reviews of production GO-CAM models. Each reviewed activity (annoton) is checked
            against GO-CAM best practice and against the gene's own annotation review.
            {{ rows | length }} of {{ cached_models }} cached models have been reviewed.
            Click a column header to sort.</p>
        <div class="stats">
            <div><strong>{{ rows | length }}</strong>models reviewed</div>
            <div><strong class="verdict-OK">{{ totals.OK }}</strong>activities OK</div>
            <div><strong class="verdict-UNCERTAIN">{{ totals.UNCERTAIN }}</strong>uncertain</div>
            <div><strong class="verdict-WRONG">{{ totals.WRONG }}</strong>wrong</div>
            <div><strong>{{ total_defects }}</strong>source defects reported</div>
        </div>
    </div>
    <div class="panel">
        <input class="search" type="search" placeholder="Filter models" aria-label="Filter models" data-search>
        <div class="table-wrap">
        <table data-table>
            <thead>
            <tr>
                <th data-sort="text">Model</th>
                <th data-sort="text">Taxon</th>
                <th data-sort="text">Status</th>
                <th class="num" data-sort="num">Activities</th>
                <th class="num" data-sort="num">OK</th>
                <th class="num" data-sort="num">Uncertain</th>
                <th class="num" data-sort="num">Wrong</th>
                <th class="num" data-sort="num">Conflicts</th>
                <th class="num" data-sort="num">Defects</th>
                <th class="num" data-sort="num">Modules</th>
            </tr>
            </thead>
            <tbody>
            {% for row in rows %}
            <tr>
                <td><a href="{{ row.href }}">{{ row.title }}</a><br><span class="id">{{ row.model_id }}</span></td>
                <td>{{ row.taxon }}</td>
                <td>{{ row.status }}</td>
                <td class="num">{{ row.activities }}</td>
                <td class="num verdict-OK">{{ row.counts.OK }}</td>
                <td class="num verdict-UNCERTAIN">{{ row.counts.UNCERTAIN }}</td>
                <td class="num verdict-WRONG">{{ row.counts.WRONG }}</td>
                <td class="num">{{ row.conflicts }}</td>
                <td class="num">{{ row.defects }}</td>
                <td class="num">{{ row.modules }}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
    </div>
</div>
<script>
    const table = document.querySelector("[data-table]");
    const body = table.tBodies[0];
    document.querySelector("[data-search]").addEventListener("input", (event) => {
        const query = event.target.value.toLowerCase();
        for (const row of body.rows) {
            row.hidden = !row.textContent.toLowerCase().includes(query);
        }
    });
    table.querySelectorAll("th[data-sort]").forEach((header, column) => {
        let ascending = true;
        header.addEventListener("click", () => {
            const numeric = header.dataset.sort === "num";
            const value = (row) => row.cells[column].textContent.trim();
            const rows = Array.from(body.rows).sort((a, b) => numeric
                ? Number(value(a)) - Number(value(b))
                : value(a).localeCompare(value(b)));
            if (!ascending) rows.reverse();
            ascending = !ascending;
            rows.forEach((row) => body.appendChild(row));
        });
    });
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Annotation rules - AI Gene Review</title>
    {% include "_site_style.html.j2" %}
</head>
<body>
<div class="page">
    <div class="panel">
        <div class="crumbs"><a href="../../index.html">AI Gene Review</a></div>
        <h1>Annotation rules</h1>
        <p class="muted">Rules curated in this repository, and reviews of the UniProt rules that
            produce electronic annotations.</p>
    </div>

    <div class="panel" id="curated">
        <h2>Curated rules ({{ rules | length }})</h2>
        <p class="muted">Each rule couples sequence-feature conditions with taxon or module context and
            names the InterPro2GO mapping or UniProt rule it replaces.</p>
        <div class="table-wrap"><table>
            <thead><tr><th>Rule</th><th>Status</th><th>Annotates</th><th>Replaces</th><th class="num">Gene reviews</th></tr></thead>
            <tbody>
            {% for r in rules %}
            <tr>
                <td><a href="{{ r.href }}">{{ r.id }}</a><br>{{ r.title }}</td>
                <td>{{ r.status }}</td>
                <td>{% for a in r.consequents %}{{ a.go_label }} <span class="id">{{ a.go_id }}</span>{% if not loop.last %}<br>{% endif %}{% endfor %}</td>
                <td>{% for x in r.replaces %}{{ x.source_type }} <span class="id">{{ x.source_id }}</span>{% if not loop.last %}<br>{% endif %}{% endfor %}</td>
                <td class="num">{{ r.gene_reviews }}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table></div>
    </div>

    <div class="panel" id="external">
        <h2>Reviews of external rules</h2>
        <ul>
            <li><a href="../../rules/arba/index.html">ARBA rule reviews</a> ({{ arba_reviews }})</li>
            {% if unirule_reviews %}<li>UniRule rule reviews ({{ unirule_reviews }})</li>{% endif %}
            {% if has_function_requirements %}<li><a href="../projects/FUNCTION_REQUIREMENT_RULES.html">Function requirement rules</a></li>{% endif %}
        </ul>
    </div>
</div>
</body>
</html>

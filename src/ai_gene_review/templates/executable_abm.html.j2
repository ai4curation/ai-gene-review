<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ payload.model_title or payload.title }} — Agent-Based Trafficking Model</title>
    <style>
        :root {
            --bg: #f8fafc;
            --panel: #ffffff;
            --border: #e2e8f0;
            --ink: #0f172a;
            --muted: #475569;
            --accent: #0f766e;
            --accent-soft: #ccfbf1;
            --on: #15803d;
            --on-bg: #dcfce7;
            --off: #64748b;
            --off-bg: #f1f5f9;
            --ko: #b91c1c;
            --ko-bg: #fee2e2;
            --warn: #b45309;
            --warn-bg: #fef3c7;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: var(--bg);
            color: var(--ink);
            line-height: 1.5;
        }
        .wrap {
            max-width: 1240px;
            margin: 0 auto;
            padding: 1.5rem;
        }
        .crumbs {
            font-size: 0.875rem;
            color: var(--muted);
            margin-bottom: 0.75rem;
        }
        .crumbs a {
            color: var(--accent);
            text-decoration: none;
        }
        .crumbs a:hover { text-decoration: underline; }
        header {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 1.25rem 1.5rem;
            margin-bottom: 1.25rem;
        }
        .badges {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-bottom: 0.5rem;
        }
        .badge {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.15rem 0.55rem;
            border-radius: 999px;
            background: var(--accent-soft);
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }
        .badge.secondary {
            background: var(--off-bg);
            color: var(--muted);
        }
        h1 {
            margin: 0 0 0.4rem 0;
            font-size: 1.5rem;
        }
        .desc {
            margin: 0;
            color: var(--muted);
            font-size: 0.95rem;
        }
        .meta-links {
            margin-top: 0.75rem;
            font-size: 0.85rem;
            color: var(--muted);
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }
        .meta-links a {
            color: var(--accent);
            text-decoration: none;
        }
        .grid {
            display: grid;
            grid-template-columns: 340px 1fr;
            gap: 1.25rem;
            align-items: start;
        }
        @media (max-width: 960px) {
            .grid { grid-template-columns: 1fr; }
        }
        .card {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 1.1rem 1.25rem;
            margin-bottom: 1.25rem;
        }
        .card h2 {
            margin: 0 0 0.75rem 0;
            font-size: 1.05rem;
        }
        .scenario-btn {
            display: block;
            width: 100%;
            text-align: left;
            padding: 0.65rem 0.8rem;
            margin-bottom: 0.5rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: #fff;
            cursor: pointer;
            transition: border-color 0.15s, background 0.15s;
        }
        .scenario-btn:hover {
            border-color: var(--accent);
        }
        .scenario-btn.active {
            border-color: var(--accent);
            background: #f0fdfa;
        }
        .scenario-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 600;
            font-size: 0.9rem;
        }
        .verdict {
            font-size: 0.72rem;
            padding: 0.1rem 0.45rem;
            border-radius: 999px;
        }
        .verdict.pass { background: var(--on-bg); color: var(--on); }
        .verdict.fail { background: var(--ko-bg); color: var(--ko); }
        .scenario-sub {
            font-size: 0.8rem;
            color: var(--muted);
            margin-top: 0.25rem;
        }
        .controls-bar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.6rem;
            padding: 0.65rem 0.85rem;
            background: var(--off-bg);
            border-radius: 8px;
            margin-bottom: 1rem;
        }
        .btn {
            border: 1px solid var(--border);
            background: #fff;
            color: var(--ink);
            padding: 0.35rem 0.7rem;
            border-radius: 6px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
        }
        .btn.primary {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }
        .step-slider {
            flex: 1;
            min-width: 140px;
        }
        .stages-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(235px, 1fr));
            gap: 0.85rem;
        }
        .stage-box {
            border: 2px solid var(--border);
            border-radius: 10px;
            padding: 0.75rem 0.85rem;
            background: #fff;
            cursor: pointer;
            transition: transform 0.1s, border-color 0.15s;
            position: relative;
        }
        .stage-box:hover {
            transform: translateY(-1px);
            border-color: var(--accent);
        }
        .stage-box.disabled {
            border-color: #fca5a5;
            background: #fff5f5;
        }
        .stage-box.regulator {
            border-style: dashed;
        }
        .stage-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 0.4rem;
            margin-bottom: 0.3rem;
        }
        .stage-title {
            font-weight: 600;
            font-size: 0.86rem;
            line-height: 1.25;
        }
        .stage-count {
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--accent);
            white-space: nowrap;
        }
        .stage-box.disabled .stage-count {
            color: var(--ko);
        }
        .stage-loc {
            font-size: 0.74rem;
            color: var(--muted);
            margin-bottom: 0.4rem;
        }
        .bar-track {
            height: 7px;
            background: var(--off-bg);
            border-radius: 999px;
            overflow: hidden;
            margin-bottom: 0.45rem;
        }
        .bar-fill {
            height: 100%;
            background: var(--accent);
            transition: width 0.15s;
        }
        .particle-well {
            min-height: 34px;
            display: flex;
            flex-wrap: wrap;
            gap: 3px;
            align-content: flex-start;
            padding: 4px;
            background: #f8fafc;
            border-radius: 6px;
            border: 1px solid #f1f5f9;
        }
        .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--accent);
        }
        .stage-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 0.4rem;
            font-size: 0.72rem;
            color: var(--muted);
        }
        .lock-pill {
            padding: 0.08rem 0.4rem;
            border-radius: 4px;
            font-weight: 600;
        }
        .lock-pill.on { background: var(--on-bg); color: var(--on); }
        .lock-pill.off { background: var(--ko-bg); color: var(--ko); }
        .lock-pill.auto { background: var(--off-bg); color: var(--muted); }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.83rem;
        }
        th, td {
            text-align: left;
            padding: 0.45rem 0.55rem;
            border-bottom: 1px solid var(--border);
        }
        th {
            color: var(--muted);
            font-weight: 600;
            background: #f8fafc;
        }
        code {
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 0.8rem;
            background: var(--off-bg);
            padding: 0.1rem 0.3rem;
            border-radius: 4px;
        }
        .chart-svg {
            width: 100%;
            height: 210px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: #fff;
        }
        .expect-box {
            font-size: 0.82rem;
            padding: 0.65rem 0.8rem;
            border-radius: 8px;
            background: #f8fafc;
            border: 1px solid var(--border);
            margin-top: 0.75rem;
        }
    </style>
</head>
<body>
<div class="wrap">
    <nav class="crumbs">
        {% if modules_index_href %}<a href="{{ modules_index_href }}">Modules</a> · {% endif %}
        <a href="{{ module_href }}">{{ module_title }}</a> ·
        <a href="{{ index_href }}">Executable models</a> ·
        <span>{{ payload.model_id }}</span>
    </nav>

    <header>
        <div class="badges">
            <span class="badge">Agent-Based Model</span>
            <span class="badge secondary">Derived from module</span>
            <span class="badge secondary">{{ payload.stages | length }} elements · {{ payload.transitions | length }} transitions</span>
        </div>
        <h1>{{ payload.model_title or payload.title }}</h1>
        {% if payload.description %}
        <p class="desc">{{ payload.description }}</p>
        {% endif %}
        <div class="meta-links">
            <span>Module: <a href="{{ module_href }}">{{ module_title }}</a></span>
            <span>Source YAML: <a href="{{ source_url }}"><code>{{ source_path }}</code></a></span>
        </div>
    </header>

    <div class="grid">
        <aside>
            <div class="card">
                <h2>Curated Scenarios</h2>
                <button class="scenario-btn" id="btn-baseline" data-scenario="__baseline__">
                    <div class="scenario-head">
                        <span>Unperturbed baseline</span>
                        <span class="verdict pass">WT</span>
                    </div>
                    <div class="scenario-sub">Default module parameters ({{ payload.parameters.n_agents }} cargo agents)</div>
                </button>
                {% for sc in payload.scenarios %}
                <button class="scenario-btn" data-scenario="{{ sc.id }}">
                    <div class="scenario-head">
                        <span>{{ sc.label }}</span>
                        {% if sc.passed %}
                        <span class="verdict pass">PASS</span>
                        {% else %}
                        <span class="verdict fail">FAIL</span>
                        {% endif %}
                    </div>
                    {% if sc.description %}
                    <div class="scenario-sub">{{ sc.description }}</div>
                    {% endif %}
                </button>
                {% endfor %}

                <div class="expect-box" id="scenario-details">
                    Click a scenario above or click any compartment card to toggle perturbations (Auto → Locked ON → Locked OFF).
                </div>
            </div>
        </aside>

        <main>
            <div class="card">
                <h2>Compartment Trafficking &amp; Discrete Cargo Routing</h2>
                <div class="controls-bar">
                    <button class="btn primary" id="btn-play">Pause</button>
                    <button class="btn" id="btn-prev">Step -1</button>
                    <button class="btn" id="btn-next">Step +1</button>
                    <button class="btn" id="btn-reset">Reset Locks</button>
                    <input type="range" class="step-slider" id="step-slider" min="0" max="{{ payload.parameters.n_steps }}" value="{{ payload.parameters.n_steps }}">
                    <span id="step-label" style="font-family: monospace; font-size: 0.85rem; font-weight: 600;">
                        t = {{ payload.parameters.n_steps }} / {{ payload.parameters.n_steps }}
                    </span>
                </div>

                <div class="stages-grid" id="stages-container"></div>
            </div>

            <div class="card">
                <h2>Cargo Occupancy Trajectory (t = 0 .. {{ payload.parameters.n_steps }})</h2>
                <svg class="chart-svg" id="trajectory-chart" viewBox="0 0 720 200"></svg>
                <div id="chart-legend" style="display:flex; flex-wrap:wrap; gap:0.75rem; margin-top:0.5rem; font-size:0.78rem;"></div>
            </div>

            <div class="card">
                <h2>Derived Transition Rules &amp; Effective Flux Rates</h2>
                <table>
                    <thead>
                        <tr>
                            <th>From Stage</th>
                            <th>To Stage</th>
                            <th>Predicate</th>
                            <th>Modulators / Competing Branches</th>
                            <th>Effective Rate</th>
                        </tr>
                    </thead>
                    <tbody id="transitions-tbody"></tbody>
                </table>
            </div>
        </main>
    </div>
</div>

<script type="application/json" id="model-data">{{ payload_json | safe }}</script>
<script>
(function() {
    const data = JSON.parse(document.getElementById("model-data").textContent);
    const params = data.parameters;
    const COLORS = ["#0f766e", "#2563eb", "#d97706", "#dc2626", "#7c3aed", "#0891b2", "#4f46e5", "#be123c"];

    let currentSettings = {};
    let currentRemoved = [];
    let currentScenario = data.scenarios.length > 0 ? data.scenarios[0].id : "__baseline__";
    let currentStep = params.n_steps;
    let timer = null;
    let simResult = null;

    function escHtml(s) {
        return String(s == null ? "" : s)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");
    }

    const flowInputsByTarget = {};
    const competingInhibitorsByTarget = {};
    for (const st of data.stages) {
        flowInputsByTarget[st.id] = new Set();
        competingInhibitorsByTarget[st.id] = new Set();
    }
    for (const t of data.transitions) {
        if (!flowInputsByTarget[t.target]) flowInputsByTarget[t.target] = new Set();
        flowInputsByTarget[t.target].add(t.source);
        if (!competingInhibitorsByTarget[t.target]) competingInhibitorsByTarget[t.target] = new Set();
        for (const inh of t.competing_inhibitors || []) {
            competingInhibitorsByTarget[t.target].add(inh);
        }
    }

    function evalAbmLogic(expr, active, flowInputs, competingInhibitors, removedSet, targetId) {
        if (!expr || typeof expr !== "object") return true;
        if (typeof expr.element === "string") {
            const v = expr.element;
            if (removedSet && targetId && removedSet.has(v + "->" + targetId)) {
                return !(flowInputs && flowInputs.has(v));
            }
            if (competingInhibitors && competingInhibitors.has(v)) return false;
            if (flowInputs && flowInputs.has(v)) return true;
            return Boolean(active[v]);
        }
        if (Array.isArray(expr.none_of)) {
            return !expr.none_of.some(sub =>
                evalAbmLogic(sub, active, flowInputs, competingInhibitors, removedSet, targetId)
            );
        }
        if (Array.isArray(expr.all_of)) {
            return expr.all_of.every(sub =>
                evalAbmLogic(sub, active, flowInputs, competingInhibitors, removedSet, targetId)
            );
        }
        if (Array.isArray(expr.any_of)) {
            return expr.any_of.some(sub =>
                evalAbmLogic(sub, active, flowInputs, competingInhibitors, removedSet, targetId)
            );
        }
        return true;
    }

    function resolveActive(settings, removedSet) {
        const active = {};
        for (const st of data.stages) {
            if (Object.prototype.hasOwnProperty.call(settings, st.id)) {
                active[st.id] = Boolean(settings[st.id]);
            } else {
                active[st.id] = Boolean(st.default_active);
            }
        }
        const maxIter = Math.max(1, data.stages.length + 1);
        for (let iter = 0; iter < maxIter; iter++) {
            let changed = false;
            for (const st of data.stages) {
                if (Object.prototype.hasOwnProperty.call(settings, st.id)) continue;
                let nextVal;
                if (st.activation_logic) {
                    const logicOk = evalAbmLogic(
                        st.activation_logic,
                        active,
                        flowInputsByTarget[st.id],
                        competingInhibitorsByTarget[st.id],
                        removedSet,
                        st.id
                    );
                    nextVal = Boolean(st.default_active) && Boolean(logicOk);
                } else {
                    let gatedOff = false;
                    for (const r of st.gate_activators || []) {
                        if (!removedSet.has(r + "->" + st.id) && !active[r]) gatedOff = true;
                    }
                    for (const r of st.gate_inhibitors || []) {
                        if (!removedSet.has(r + "->" + st.id) && active[r]) gatedOff = true;
                    }
                    nextVal = gatedOff ? false : Boolean(st.default_active);
                }
                if (active[st.id] !== nextVal) {
                    active[st.id] = nextVal;
                    changed = true;
                }
            }
            if (!changed) break;
        }
        return active;
    }

    function simulate(settings, removedList) {
        const removedSet = new Set((removedList || []).map(c => c.source + "->" + c.target));
        const elementActive = resolveActive(settings, removedSet);
        const counts = {};
        for (const st of data.stages) counts[st.id] = 0;

        const activeEntries = data.entry_stages.filter(id => elementActive[id]);
        if (activeEntries.length > 0) {
            const share = Math.floor(params.n_agents / activeEntries.length);
            const rem = params.n_agents % activeEntries.length;
            activeEntries.forEach((id, idx) => {
                counts[id] = share + (idx < rem ? 1 : 0);
            });
        }

        const outgoingBySource = {};
        for (const st of data.stages) outgoingBySource[st.id] = [];

        const effectiveRates = data.transitions.map((t, idx) => {
            if (removedSet.has(t.source + "->" + t.target)) {
                return { ...t, effective_rate: 0 };
            }
            if (!elementActive[t.source] || !elementActive[t.target]) {
                return { ...t, effective_rate: 0 };
            }
            if (t.activation_logic) {
                const logicOk = evalAbmLogic(
                    t.activation_logic,
                    elementActive,
                    flowInputsByTarget[t.target],
                    competingInhibitorsByTarget[t.target],
                    removedSet,
                    t.target
                );
                if (!logicOk) {
                    return { ...t, effective_rate: 0 };
                }
            } else {
                for (const r of t.gate_activators || []) {
                    if (!removedSet.has(r + "->" + t.target) && !elementActive[r]) {
                        return { ...t, effective_rate: 0 };
                    }
                }
                for (const r of t.gate_inhibitors || []) {
                    if (!removedSet.has(r + "->" + t.target) && elementActive[r]) {
                        return { ...t, effective_rate: 0 };
                    }
                }
            }
            let rate = t.base_rate;
            for (const inh of t.competing_inhibitors || []) {
                if (!removedSet.has(inh + "->" + t.target) && elementActive[inh]) {
                    rate *= params.competing_inhibitor_factor;
                }
            }
            for (const mod of t.positive_modulators || []) {
                if (removedSet.has(mod + "->" + t.target)) continue;
                if (elementActive[mod]) {
                    rate *= params.positive_regulator_boost;
                } else if (!t.activation_logic) {
                    rate = 0;
                }
            }
            if (rate > 0) {
                outgoingBySource[t.source].push({ idx, t, eff: rate });
            }
            return { ...t, effective_rate: rate };
        });

        const trajectory = [{ ...counts }];
        const peakCounts = { ...counts };

        for (let step = 0; step < params.n_steps; step++) {
            const nextCounts = { ...counts };
            for (const st of data.stages) {
                const u = st.id;
                const current = counts[u];
                if (current <= 0) continue;
                const outgoing = outgoingBySource[u] || [];
                if (outgoing.length === 0) continue;
                const sumRates = outgoing.reduce((acc, item) => acc + item.eff, 0);
                if (sumRates <= 0) continue;
                const leaveFrac = Math.min(params.max_leave_fraction, sumRates);
                const totalLeaving = Math.min(current, Math.ceil(current * leaveFrac));
                if (totalLeaving <= 0) continue;

                const exact = outgoing.map(item => ({
                    idx: item.idx,
                    target: item.t.target,
                    val: totalLeaving * (item.eff / sumRates),
                    floor: Math.floor(totalLeaving * (item.eff / sumRates))
                }));
                let rem = totalLeaving - exact.reduce((acc, x) => acc + x.floor, 0);
                if (rem > 0) {
                    const ranked = [...exact].sort((a, b) => (b.val - b.floor) - (a.val - a.floor) || (a.idx - b.idx));
                    for (let k = 0; k < rem; k++) ranked[k].floor += 1;
                }
                for (const item of exact) {
                    if (item.floor > 0) {
                        nextCounts[u] -= item.floor;
                        nextCounts[item.target] += item.floor;
                    }
                }
            }
            Object.assign(counts, nextCounts);
            trajectory.push({ ...counts });
            for (const k of Object.keys(counts)) {
                if (counts[k] > peakCounts[k]) peakCounts[k] = counts[k];
            }
        }
        return { elementActive, effectiveRates, trajectory, finalCounts: counts, peakCounts };
    }

    function renderStages() {
        const container = document.getElementById("stages-container");
        container.innerHTML = "";
        const stepCounts = simResult.trajectory[currentStep] || simResult.finalCounts;

        data.stages.forEach((st, idx) => {
            const isEnabled = simResult.elementActive[st.id];
            const count = stepCounts[st.id] || 0;
            const pct = Math.min(100, Math.round((count / Math.max(1, params.n_agents)) * 100));
            const pinned = Object.prototype.hasOwnProperty.call(currentSettings, st.id)
                ? (currentSettings[st.id] ? "on" : "off")
                : "auto";

            const card = document.createElement("div");
            card.className = "stage-box" + (!isEnabled ? " disabled" : "") + (!st.is_flow_stage ? " regulator" : "");
            card.title = "Click to cycle perturbation state (Auto -> Locked OFF -> Locked ON)";

            let dotsHtml = "";
            if (st.is_flow_stage) {
                const nDots = Math.min(50, Math.ceil(count / 2));
                const color = COLORS[idx % COLORS.length];
                for (let d = 0; d < nDots; d++) {
                    dotsHtml += `<span class="dot" style="background:${color}"></span>`;
                }
            }

            card.innerHTML = `
                <div class="stage-top">
                    <div class="stage-title">${escHtml(st.label)}</div>
                    <div class="stage-count">${st.is_flow_stage ? count : (isEnabled ? "ON" : "OFF")}</div>
                </div>
                <div class="stage-loc">
                    <code>${escHtml(st.id)}</code>
                    ${st.location_label ? " · " + escHtml(st.location_label) : ""}
                </div>
                ${st.is_flow_stage ? `
                <div class="bar-track"><div class="bar-fill" style="width:${pct}%;background:${COLORS[idx % COLORS.length]}"></div></div>
                <div class="particle-well">${dotsHtml}</div>
                ` : `<div class="stage-loc">Regulatory node (gates target transitions)</div>`}
                <div class="stage-footer">
                    <span>${st.is_flow_stage ? ("Peak: " + simResult.peakCounts[st.id] + " · Final: " + simResult.finalCounts[st.id]) : "Regulator"}</span>
                    <span class="lock-pill ${pinned}">${pinned === "auto" ? "Auto" : (pinned === "on" ? "Locked ON" : "KO / OFF")}</span>
                </div>
            `;

            card.addEventListener("click", () => {
                if (!Object.prototype.hasOwnProperty.call(currentSettings, st.id)) {
                    currentSettings[st.id] = false;
                } else if (currentSettings[st.id] === false) {
                    currentSettings[st.id] = true;
                } else {
                    delete currentSettings[st.id];
                }
                currentScenario = "__custom__";
                recompute();
            });
            container.appendChild(card);
        });
    }

    function renderChart() {
        const svg = document.getElementById("trajectory-chart");
        const legend = document.getElementById("chart-legend");
        const W = 720, H = 200, padL = 38, padR = 16, padT = 14, padB = 24;
        const plotW = W - padL - padR;
        const plotH = H - padT - padB;

        let html = `<line x1="${padL}" y1="${padT + plotH}" x2="${padL + plotW}" y2="${padT + plotH}" stroke="#cbd5e1"/>`;
        html += `<line x1="${padL}" y1="${padT}" x2="${padL}" y2="${padT + plotH}" stroke="#cbd5e1"/>`;
        html += `<text x="6" y="${padT + 10}" font-size="10" fill="#64748b">${params.n_agents}</text>`;
        html += `<text x="14" y="${padT + plotH}" font-size="10" fill="#64748b">0</text>`;

        const stepX = padL + (currentStep / Math.max(1, params.n_steps)) * plotW;
        html += `<line x1="${stepX}" y1="${padT}" x2="${stepX}" y2="${padT + plotH}" stroke="#94a3b8" stroke-dasharray="3,3"/>`;

        legend.innerHTML = "";
        data.stages.forEach((st, idx) => {
            if (!st.is_flow_stage) return;
            const color = COLORS[idx % COLORS.length];
            const pts = simResult.trajectory.map((snap, sIdx) => {
                const x = padL + (sIdx / Math.max(1, params.n_steps)) * plotW;
                const y = padT + plotH - ((snap[st.id] || 0) / Math.max(1, params.n_agents)) * plotH;
                return `${x.toFixed(1)},${y.toFixed(1)}`;
            }).join(" ");
            html += `<polyline fill="none" stroke="${color}" stroke-width="2.2" points="${pts}"/>`;
            const item = document.createElement("span");
            item.innerHTML = `<span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:${color};margin-right:4px;"></span><code>${escHtml(st.id)}</code> (${simResult.finalCounts[st.id]})`;
            legend.appendChild(item);
        });
        svg.innerHTML = html;
    }

    function renderTransitions() {
        const tbody = document.getElementById("transitions-tbody");
        tbody.innerHTML = "";
        simResult.effectiveRates.forEach(tr => {
            const mods = [];
            (tr.competing_inhibitors || []).forEach(c => mods.push(`- ${c}`));
            (tr.positive_modulators || []).forEach(p => mods.push(`+ ${p}`));
            (tr.gate_inhibitors || []).forEach(g => mods.push(`gate -${g}`));
            if (tr.activation_logic) mods.push(`logic: ${JSON.stringify(tr.activation_logic)}`);
            const row = document.createElement("tr");
            row.innerHTML = `
                <td><code>${escHtml(tr.source)}</code></td>
                <td><code>${escHtml(tr.target)}</code></td>
                <td><code>${escHtml(tr.predicate)}</code></td>
                <td>${mods.length ? mods.map(m => `<code>${escHtml(m)}</code>`).join(" ") : "—"}</td>
                <td><strong>${tr.effective_rate.toFixed(3)}</strong> <span style="color:#64748b">(base ${tr.base_rate})</span></td>
            `;
            tbody.appendChild(row);
        });
    }

    function updateScenarioButtons() {
        document.querySelectorAll(".scenario-btn").forEach(btn => {
            btn.classList.toggle("active", btn.getAttribute("data-scenario") === currentScenario);
        });
        const box = document.getElementById("scenario-details");
        const sc = data.scenarios.find(s => s.id === currentScenario);
        if (sc) {
            const orderText = (sc.expected_outcome_order || []).length
                ? `<div><strong>Expected terminal order:</strong> <code>${sc.expected_outcome_order.map(escHtml).join(" &gt; ")}</code></div>`
                : "";
            box.innerHTML = `
                <div><strong>Scenario:</strong> ${escHtml(sc.label)}</div>
                ${sc.description ? `<div style="margin-top:4px;color:#475569;">${escHtml(sc.description)}</div>` : ""}
                ${orderText}
            `;
        } else if (currentScenario === "__baseline__") {
            box.innerHTML = `<div><strong>Unperturbed baseline:</strong> All flow stages enabled with default module kinetics.</div>`;
        } else {
            box.innerHTML = `<div><strong>Custom perturbation:</strong> Locked settings <code>${escHtml(JSON.stringify(currentSettings))}</code></div>`;
        }
    }

    function recompute() {
        simResult = simulate(currentSettings, currentRemoved);
        document.getElementById("step-slider").value = String(currentStep);
        document.getElementById("step-label").textContent = `t = ${currentStep} / ${params.n_steps}`;
        updateScenarioButtons();
        renderStages();
        renderChart();
        renderTransitions();
    }

    function selectScenario(scId) {
        currentScenario = scId;
        if (scId === "__baseline__") {
            currentSettings = {};
            currentRemoved = [];
        } else {
            const sc = data.scenarios.find(s => s.id === scId);
            if (sc) {
                currentSettings = { ...(sc.settings || {}) };
                currentRemoved = [...(sc.removed_connections || [])];
            }
        }
        currentStep = params.n_steps;
        recompute();
    }

    document.querySelectorAll(".scenario-btn").forEach(btn => {
        btn.addEventListener("click", () => selectScenario(btn.getAttribute("data-scenario")));
    });

    document.getElementById("step-slider").addEventListener("input", e => {
        currentStep = parseInt(e.target.value, 10);
        recompute();
    });

    document.getElementById("btn-prev").addEventListener("click", () => {
        currentStep = Math.max(0, currentStep - 1);
        recompute();
    });

    document.getElementById("btn-next").addEventListener("click", () => {
        currentStep = Math.min(params.n_steps, currentStep + 1);
        recompute();
    });

    document.getElementById("btn-reset").addEventListener("click", () => {
        selectScenario("__baseline__");
    });

    const playBtn = document.getElementById("btn-play");
    function stopAnim() {
        if (timer) {
            clearInterval(timer);
            timer = null;
        }
        playBtn.textContent = "Play";
    }
    playBtn.addEventListener("click", () => {
        if (timer) {
            stopAnim();
        } else {
            if (currentStep >= params.n_steps) currentStep = 0;
            playBtn.textContent = "Pause";
            timer = setInterval(() => {
                if (currentStep < params.n_steps) {
                    currentStep += 1;
                    recompute();
                } else {
                    stopAnim();
                }
            }, 140);
        }
    });

    stopAnim();
    selectScenario(currentScenario);
})();
</script>
</body>
</html>

{% if source_provenance %}
<small class="source-provenance">
    {% if source_provenance.local_changes %}<strong>Local changes</strong>{% if source_provenance.commit or source_provenance.history_incomplete %} · {% endif %}{% endif %}
    {% if source_provenance.commit %}
    {% if source_provenance.local_changes %}Last committed source:{% else %}Source last changed:{% endif %}
    <time datetime="{{ source_provenance.committed_at }}">{{ source_provenance.display_date }}</time>
    · <a href="{{ source_provenance.commit_url }}" aria-label="View source change {{ source_provenance.commit }}">{{ source_provenance.commit[:12] }}</a>
    · <a href="{{ source_provenance.source_url }}">{% if source_provenance.local_changes %}View committed source{% else %}View source{% endif %}</a>
    {% elif source_provenance.history_incomplete %}Source history unavailable (shallow checkout)
    {% endif %}
</small>
{% endif %}

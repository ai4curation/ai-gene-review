<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/ai-gene-review/assets/favicon.svg">
    <title>ARBA Rule Reviews Index</title>
    <style>
        * { box-sizing: border-box; }
        body { font-family: system-ui, sans-serif; margin: 0; padding: 24px; color: #243447; background: #f5f7fb; line-height: 1.5; }
        main { max-width: 1500px; margin: auto; }
        a { color: #3459a5; }
        h1 { margin-bottom: 8px; }
        .table-container { overflow-x: auto; background: white; border: 1px solid #dce3ed; border-radius: 8px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 12px; text-align: left; vertical-align: top; border-bottom: 1px solid #dce3ed; }
        th { background: #3459a5; color: white; }
        tbody tr:hover { background: #f5f7fb; }
        .description { min-width: 300px; }
        .rule-id { white-space: nowrap; }
        .term { margin-bottom: 8px; }
    </style>
</head>
<body>
<main>
    <nav><a href="../../index.html">AI Gene Review</a></nav>
    <h1>ARBA Rule Reviews Index</h1>
    <p><strong>{{ reviews | length }}</strong> rule reviews. Includes reviews in progress; status and decisions reflect the source YAML.</p>
    <p>Condition-set counts describe the sets recorded in each review, which may omit the full rule.</p>
    <div class="table-container">
    <table>
        <thead><tr><th scope="col">Rule ID</th><th scope="col">Description</th><th scope="col">GO Terms</th><th scope="col">Status</th><th scope="col">Action</th><th scope="col">Parsimony</th><th scope="col">Literature</th><th scope="col">Recorded condition sets</th><th scope="col">Confidence</th></tr></thead>
        <tbody>
        {% for entry in reviews %}
        {% set rule = entry.data %}
        <tr>
            <td class="rule-id"><a href="{{ entry.href }}">{{ rule.id }}</a><br><a href="{{ entry.yaml_href }}">YAML</a></td>
            <td class="description">{{ rule.description | default('') }}</td>
            <td>{% for term in rule.get('rule', {}).get('go_annotations', []) %}<div class="term"><a href="https://www.ebi.ac.uk/QuickGO/term/{{ term.go_id }}">{{ term.go_id }}</a> {{ term.go_label | default('') }}</div>{% endfor %}</td>
            <td>{{ rule.status | default('Not recorded') }}</td>
            <td>{{ rule.action | default('Not recorded') }}</td>
            <td>{{ rule.get('parsimony', {}).get('assessment', 'Not recorded') }}</td>
            <td>{{ rule.get('literature_support', {}).get('assessment', 'Not recorded') }}</td>
            <td>{% set conditions = rule.get('rule', {}).get('condition_sets', []) %}{{ conditions if conditions is number else conditions | length }}</td>
            <td>{{ '%.2f' | format(rule.confidence) if rule.get('confidence') is not none else 'Not recorded' }}</td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    <p>Generated from cached review YAML by <code>just rules-index</code>.</p>
</main>
</body>
</html>

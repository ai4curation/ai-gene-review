<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ payload.model_title or payload.title }} — Constraint-Based Flux Model</title>
    <style>
        :root {
            --bg: #f8fafc;
            --panel: #ffffff;
            --border: #e2e8f0;
            --ink: #0f172a;
            --muted: #475569;
            --accent: #0369a1;
            --accent-soft: #e0f2fe;
            --on: #15803d;
            --on-bg: #dcfce7;
            --off: #64748b;
            --off-bg: #f1f5f9;
            --ko: #b91c1c;
            --ko-bg: #fee2e2;
            --warn: #b45309;
            --warn-bg: #fef3c7;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: var(--bg);
            color: var(--ink);
            line-height: 1.5;
        }
        .wrap {
            max-width: 1280px;
            margin: 0 auto;
            padding: 1.5rem;
        }
        .crumbs {
            font-size: 0.875rem;
            color: var(--muted);
            margin-bottom: 0.75rem;
        }
        .crumbs a {
            color: var(--accent);
            text-decoration: none;
        }
        .crumbs a:hover { text-decoration: underline; }
        header {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 1.25rem 1.5rem;
            margin-bottom: 1.25rem;
        }
        .badges {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-bottom: 0.5rem;
        }
        .badge {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.15rem 0.55rem;
            border-radius: 999px;
            background: var(--accent-soft);
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }
        .badge.secondary {
            background: var(--off-bg);
            color: var(--muted);
        }
        h1 {
            margin: 0 0 0.4rem 0;
            font-size: 1.5rem;
        }
        .desc {
            margin: 0;
            color: var(--muted);
            font-size: 0.95rem;
        }
        .meta-links {
            margin-top: 0.75rem;
            font-size: 0.85rem;
            color: var(--muted);
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }
        .meta-links a {
            color: var(--accent);
            text-decoration: none;
        }
        .grid {
            display: grid;
            grid-template-columns: 350px 1fr;
            gap: 1.25rem;
            align-items: start;
        }
        @media (max-width: 960px) {
            .grid { grid-template-columns: 1fr; }
        }
        .card {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 1.1rem 1.25rem;
            margin-bottom: 1.25rem;
        }
        .card h2 {
            margin: 0 0 0.75rem 0;
            font-size: 1.05rem;
        }
        .scenario-btn {
            display: block;
            width: 100%;
            text-align: left;
            padding: 0.65rem 0.8rem;
            margin-bottom: 0.5rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: #fff;
            cursor: pointer;
            transition: border-color 0.15s, background 0.15s;
        }
        .scenario-btn:hover {
            border-color: var(--accent);
        }
        .scenario-btn.active {
            border-color: var(--accent);
            background: #f0f9ff;
        }
        .scenario-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 600;
            font-size: 0.9rem;
        }
        .verdict {
            font-size: 0.72rem;
            padding: 0.1rem 0.45rem;
            border-radius: 999px;
        }
        .verdict.pass { background: var(--on-bg); color: var(--on); }
        .verdict.fail { background: var(--ko-bg); color: var(--ko); }
        .scenario-sub {
            font-size: 0.8rem;
            color: var(--muted);
            margin-top: 0.25rem;
        }
        .controls-bar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.75rem;
            padding: 0.65rem 0.85rem;
            background: var(--off-bg);
            border-radius: 8px;
            margin-bottom: 1rem;
        }
        .btn {
            border: 1px solid var(--border);
            background: #fff;
            color: var(--ink);
            padding: 0.35rem 0.7rem;
            border-radius: 6px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
        }
        .btn.primary {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }
        .kpi-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
            gap: 0.75rem;
            margin-bottom: 1rem;
        }
        .kpi-box {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 0.6rem 0.8rem;
            background: #f8fafc;
        }
        .kpi-label {
            font-size: 0.74rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }
        .kpi-val {
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--accent);
        }
        .reactions-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(265px, 1fr));
            gap: 0.85rem;
        }
        .rxn-box {
            border: 2px solid var(--border);
            border-radius: 10px;
            padding: 0.8rem 0.9rem;
            background: #fff;
            cursor: pointer;
            transition: transform 0.1s, border-color 0.15s;
            position: relative;
        }
        .rxn-box:hover {
            transform: translateY(-1px);
            border-color: var(--accent);
        }
        .rxn-box.zero-flux {
            border-color: #cbd5e1;
            background: #f8fafc;
        }
        .rxn-box.blocked {
            border-color: #fca5a5;
            background: #fff5f5;
        }
        .rxn-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 0.4rem;
            margin-bottom: 0.25rem;
        }
        .rxn-title {
            font-weight: 600;
            font-size: 0.88rem;
            line-height: 1.25;
        }
        .rxn-flux {
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 1rem;
            font-weight: 700;
            color: var(--accent);
            white-space: nowrap;
        }
        .rxn-box.blocked .rxn-flux, .rxn-box.zero-flux .rxn-flux {
            color: var(--off);
        }
        .rxn-meta {
            font-size: 0.74rem;
            color: var(--muted);
            margin-bottom: 0.35rem;
        }
        .chem-line {
            font-size: 0.75rem;
            background: #f1f5f9;
            padding: 0.25rem 0.45rem;
            border-radius: 5px;
            margin-bottom: 0.4rem;
            color: #334155;
        }
        .bar-track {
            height: 8px;
            background: var(--off-bg);
            border-radius: 999px;
            overflow: hidden;
            margin-bottom: 0.4rem;
            position: relative;
        }
        .bar-bound {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            background: #bae6fd;
        }
        .bar-fill {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            background: var(--accent);
            transition: width 0.15s;
        }
        .rxn-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 0.35rem;
            font-size: 0.72rem;
            color: var(--muted);
        }
        .lock-pill {
            padding: 0.08rem 0.4rem;
            border-radius: 4px;
            font-weight: 600;
        }
        .lock-pill.on { background: var(--on-bg); color: var(--on); }
        .lock-pill.off { background: var(--ko-bg); color: var(--ko); }
        .lock-pill.half { background: var(--warn-bg); color: var(--warn); }
        .lock-pill.auto { background: var(--off-bg); color: var(--muted); }
        .gpr-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
            gap: 0.65rem;
        }
        .gpr-chip {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 0.55rem 0.7rem;
            background: #fff;
            cursor: pointer;
            font-size: 0.78rem;
            transition: border-color 0.15s;
        }
        .gpr-chip:hover { border-color: var(--accent); }
        .gpr-chip.ko {
            border-color: #fca5a5;
            background: #fff5f5;
        }
        .gpr-chip.half {
            border-color: #fcd34d;
            background: #fffbeb;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.83rem;
        }
        th, td {
            text-align: left;
            padding: 0.45rem 0.55rem;
            border-bottom: 1px solid var(--border);
        }
        th {
            color: var(--muted);
            font-weight: 600;
            background: #f8fafc;
        }
        code {
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 0.79rem;
            background: var(--off-bg);
            padding: 0.1rem 0.3rem;
            border-radius: 4px;
        }
        .chart-svg {
            width: 100%;
            height: 220px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: #fff;
        }
        .expect-box {
            font-size: 0.82rem;
            padding: 0.65rem 0.8rem;
            border-radius: 8px;
            background: #f8fafc;
            border: 1px solid var(--border);
            margin-top: 0.75rem;
        }
    </style>
</head>
<body>
<div class="wrap">
    <nav class="crumbs">
        {% if modules_index_href %}<a href="{{ modules_index_href }}">Modules</a> · {% endif %}
        <a href="{{ module_href }}">{{ module_title }}</a> ·
        <a href="{{ index_href }}">Executable models</a> ·
        <span>{{ payload.model_id }}</span>
    </nav>

    <header>
        <div class="badges">
            <span class="badge">Constraint-Based Model (FBA / pFBA / E-Flux)</span>
            <span class="badge secondary">Derived from module</span>
            <span class="badge secondary">{{ payload.reactions | length }} reactions · {{ payload.gpr_elements | length }} GPR elements · {{ payload.transitions | length }} transitions</span>
        </div>
        <h1>{{ payload.model_title or payload.title }}</h1>
        {% if payload.description %}
        <p class="desc">{{ payload.description }}</p>
        {% endif %}
        <div class="meta-links">
            <span>Module: <a href="{{ module_href }}">{{ module_title }}</a></span>
            <span>Source YAML: <a href="{{ source_url }}"><code>{{ source_path }}</code></a></span>
        </div>
    </header>

    <div class="grid">
        <aside>
            <div class="card">
                <h2>Curated Flux Scenarios</h2>
                <button class="scenario-btn" id="btn-baseline" data-scenario="__baseline__">
                    <div class="scenario-head">
                        <span>Unperturbed WT baseline</span>
                        <span class="verdict pass">WT</span>
                    </div>
                    <div class="scenario-sub">Default enzyme bounds (uptake = {{ payload.parameters.uptake_rate }})</div>
                </button>
                {% for sc in payload.scenarios %}
                <button class="scenario-btn" data-scenario="{{ sc.id }}">
                    <div class="scenario-head">
                        <span>{{ sc.label }}</span>
                        {% if sc.passed %}
                        <span class="verdict pass">PASS</span>
                        {% else %}
                        <span class="verdict fail">FAIL</span>
                        {% endif %}
                    </div>
                    {% if sc.description %}
                    <div class="scenario-sub">{{ sc.description }}</div>
                    {% endif %}
                </button>
                {% endfor %}

                <div class="expect-box" id="scenario-details">
                    Select a scenario above, or click any reaction / GPR enzyme card to cycle E-Flux capacity (Auto → KO 0% → 50% E-Flux → Locked 100%).
                </div>
            </div>
        </aside>

        <main>
            <div class="card">
                <h2>Steady-State Mass-Balance &amp; Parsimonious Flux Distribution (S·v = 0)</h2>
                <div class="controls-bar">
                    <button class="btn primary" id="btn-reset">Reset to WT Baseline</button>
                    <label for="uptake-slider" style="font-size:0.83rem;font-weight:600;">Substrate Uptake Budget:</label>
                    <input type="range" id="uptake-slider" min="0" max="200" step="5" value="{{ payload.parameters.uptake_rate }}" style="flex:1;min-width:140px;">
                    <span id="uptake-label" style="font-family:monospace;font-size:0.85rem;font-weight:700;">{{ payload.parameters.uptake_rate }}</span>
                </div>

                <div class="kpi-row">
                    <div class="kpi-box">
                        <div class="kpi-label">Total Substrate Uptake</div>
                        <div class="kpi-val" id="kpi-uptake">0.0</div>
                    </div>
                    <div class="kpi-box">
                        <div class="kpi-label">Terminal Product Export</div>
                        <div class="kpi-val" id="kpi-export">0.0</div>
                    </div>
                    <div class="kpi-box">
                        <div class="kpi-label">Parsimonious L1 Flux (∑|v|)</div>
                        <div class="kpi-val" id="kpi-l1">0.0</div>
                    </div>
                    <div class="kpi-box">
                        <div class="kpi-label">Max Mass-Balance Residual</div>
                        <div class="kpi-val" id="kpi-residual" style="color:var(--on);">0.0000</div>
                    </div>
                </div>

                <div class="reactions-grid" id="reactions-container"></div>
            </div>

            {% if payload.gpr_elements %}
            <div class="card">
                <h2>AST-Compiled GPR Isozyme, Variant &amp; Complex Subunit Controls (E-Flux)</h2>
                <p class="desc" style="margin-bottom:0.75rem;font-size:0.82rem;">
                    Click any enzyme variant, isozyme annoton (<code>any_of</code> = additive capacity), or protein-complex subunit (<code>all_of</code> = minimum subunit capacity) to toggle knockouts or 50% E-Flux attenuation.
                </p>
                <div class="gpr-grid" id="gpr-container"></div>
            </div>
            {% endif %}

            <div class="card">
                <h2>Reaction Flux vs. Enzyme Capacity Bounds (v vs. UB)</h2>
                <svg class="chart-svg" id="flux-chart" viewBox="0 0 740 220"></svg>
            </div>

            <div class="card">
                <h2>Stoichiometric Metabolite Handoffs &amp; Transition Fluxes</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Upstream Reaction</th>
                            <th>Downstream Reaction</th>
                            <th>Shared Metabolite(s)</th>
                            <th>Edge Bound (UB)</th>
                            <th>Steady-State Flux</th>
                        </tr>
                    </thead>
                    <tbody id="transitions-tbody"></tbody>
                </table>
            </div>
        </main>
    </div>
</div>

<script type="application/json" id="model-data">{{ payload_json | safe }}</script>
<script>
(function() {
    const data = JSON.parse(document.getElementById("model-data").textContent);
    const params = data.parameters;
    const EPS = 1e-6;
    const COLORS = ["#0369a1", "#0f766e", "#2563eb", "#d97706", "#7c3aed", "#0891b2", "#4f46e5", "#be123c"];

    let currentSettings = {};
    let currentRemoved = [];
    let currentScenario = data.scenarios.length > 0 ? data.scenarios[0].id : "__baseline__";
    let currentUptake = params.uptake_rate;
    let simResult = null;

    function escHtml(s) {
        return String(s == null ? "" : s)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");
    }

    function evalGprAst(expr, rawLevels, resolvedOut) {
        if (!expr || typeof expr !== "object") return 1.0;
        if (typeof expr.element === "string") {
            const eid = expr.element;
            const direct = Object.prototype.hasOwnProperty.call(rawLevels, eid) ? rawLevels[eid] : 1.0;
            const subCap = expr.sub_logic ? evalGprAst(expr.sub_logic, rawLevels, resolvedOut) : 1.0;
            const val = Math.max(0.0, direct * subCap);
            resolvedOut[eid] = val;
            return val;
        }
        if (Array.isArray(expr.all_of) && expr.all_of.length > 0) {
            const subs = expr.all_of.map(s => evalGprAst(s, rawLevels, resolvedOut));
            return Math.min(...subs);
        }
        if (Array.isArray(expr.any_of) && expr.any_of.length > 0) {
            const subs = expr.any_of.map(s => evalGprAst(s, rawLevels, resolvedOut));
            return subs.reduce((a, b) => a + b, 0) / subs.length;
        }
        return 1.0;
    }

    function evalFbaLogic(expr, active, flowInputs, competingInhibitors, removedSet, targetId) {
        if (!expr || typeof expr !== "object") return true;
        if (typeof expr.element === "string") {
            const v = expr.element;
            if (removedSet && targetId && removedSet.has(v + "->" + targetId)) {
                return !(flowInputs && flowInputs.has(v));
            }
            if (competingInhibitors && competingInhibitors.has(v)) return false;
            if (flowInputs && flowInputs.has(v)) return true;
            return Boolean(active[v]);
        }
        if (Array.isArray(expr.none_of)) {
            return !expr.none_of.some(sub =>
                evalFbaLogic(sub, active, flowInputs, competingInhibitors, removedSet, targetId)
            );
        }
        if (Array.isArray(expr.all_of)) {
            return expr.all_of.every(sub =>
                evalFbaLogic(sub, active, flowInputs, competingInhibitors, removedSet, targetId)
            );
        }
        if (Array.isArray(expr.any_of)) {
            return expr.any_of.some(sub =>
                evalFbaLogic(sub, active, flowInputs, competingInhibitors, removedSet, targetId)
            );
        }
        return true;
    }

    function waterfillAllocate(totalToAllocate, caps, weights) {
        const n = caps.length;
        const alloc = new Array(n).fill(0.0);
        let rem = Math.min(totalToAllocate, caps.reduce((acc, c) => acc + Math.max(0.0, c), 0.0));
        if (rem <= EPS || n === 0) return alloc;

        let openIdxs = [];
        for (let i = 0; i < n; i++) {
            if (caps[i] > EPS && weights[i] > 0.0) openIdxs.push(i);
        }
        while (rem > EPS && openIdxs.length > 0) {
            const wSum = openIdxs.reduce((acc, i) => acc + weights[i], 0.0);
            if (wSum <= 0.0) break;
            let saturatedAny = false;
            const shares = {};
            for (const i of openIdxs) {
                const room = caps[i] - alloc[i];
                const desire = rem * (weights[i] / wSum);
                if (desire >= room - 1e-12) {
                    alloc[i] = caps[i];
                    rem -= room;
                    saturatedAny = true;
                } else {
                    shares[i] = desire;
                }
            }
            if (saturatedAny) {
                openIdxs = openIdxs.filter(i => (caps[i] - alloc[i]) > EPS);
            } else {
                for (const i of openIdxs) alloc[i] += shares[i];
                rem = 0.0;
                break;
            }
        }
        return alloc;
    }

    function simulate(settings, removedList, uptakeRate) {
        const removedSet = new Set((removedList || []).map(c => c.source + "->" + c.target));
        const rawGprLevels = {};
        for (const g of data.gpr_elements || []) {
            if (Object.prototype.hasOwnProperty.call(settings, g.id)) {
                const v = settings[g.id];
                rawGprLevels[g.id] = typeof v === "boolean" ? (v ? 1.0 : 0.0) : Math.max(0.0, Number(v));
            } else {
                rawGprLevels[g.id] = g.default_active ? 1.0 : 0.0;
            }
        }

        const gprCapacities = {};
        for (const r of data.reactions) {
            if (!r.is_flow_stage) continue;
            let cap = r.gpr_logic ? evalGprAst(r.gpr_logic, rawGprLevels, gprCapacities) : 1.0;
            if (Object.prototype.hasOwnProperty.call(settings, r.id)) {
                const v = settings[r.id];
                const factor = typeof v === "boolean" ? (v ? 1.0 : 0.0) : Math.max(0.0, Number(v));
                cap *= factor;
            }
            gprCapacities[r.id] = cap;
        }
        for (const g of data.gpr_elements || []) {
            if (!Object.prototype.hasOwnProperty.call(gprCapacities, g.id)) {
                gprCapacities[g.id] = rawGprLevels[g.id];
            }
        }

        const flowInputsByTarget = {};
        const compInhByTarget = {};
        for (const r of data.reactions) {
            flowInputsByTarget[r.id] = new Set(r.flow_inputs || []);
            compInhByTarget[r.id] = new Set(r.competing_inhibitors || []);
        }

        const active = {};
        for (const r of data.reactions) {
            if (Object.prototype.hasOwnProperty.call(settings, r.id)) {
                const v = settings[r.id];
                active[r.id] = typeof v === "boolean" ? v : Number(v) > EPS;
            } else if (r.is_flow_stage && (gprCapacities[r.id] || 0) <= EPS) {
                active[r.id] = false;
            } else {
                active[r.id] = Boolean(r.default_active);
            }
        }

        for (let iter = 0; iter < data.reactions.length + 1; iter++) {
            let changed = false;
            for (const r of data.reactions) {
                if (Object.prototype.hasOwnProperty.call(settings, r.id)) continue;
                let nextVal;
                if (r.is_flow_stage && (gprCapacities[r.id] || 0) <= EPS) {
                    nextVal = false;
                } else if (r.activation_logic) {
                    nextVal = Boolean(r.default_active) && evalFbaLogic(
                        r.activation_logic,
                        active,
                        flowInputsByTarget[r.id],
                        compInhByTarget[r.id],
                        removedSet,
                        r.id
                    );
                } else {
                    let gatedOff = false;
                    for (const ga of r.gate_activators || []) {
                        if (!removedSet.has(ga + "->" + r.id) && !active[ga]) gatedOff = true;
                    }
                    for (const gi of r.gate_inhibitors || []) {
                        if (!removedSet.has(gi + "->" + r.id) && active[gi]) gatedOff = true;
                    }
                    nextVal = gatedOff ? false : Boolean(r.default_active);
                }
                if (active[r.id] !== nextVal) {
                    active[r.id] = nextVal;
                    changed = true;
                }
            }
            if (!changed) break;
        }

        const reactionBounds = {};
        for (const r of data.reactions) {
            if (!r.is_flow_stage || !active[r.id]) {
                reactionBounds[r.id] = 0.0;
                continue;
            }
            let ub = r.upper_bound * (gprCapacities[r.id] ?? 1.0);
            for (const inh of r.competing_inhibitors || []) {
                if (!removedSet.has(inh + "->" + r.id) && active[inh]) {
                    ub *= params.competing_inhibitor_factor;
                }
            }
            for (const mod of r.positive_modulators || []) {
                if (removedSet.has(mod + "->" + r.id)) continue;
                if (active[mod]) {
                    ub *= params.positive_regulator_boost;
                } else if (!r.activation_logic) {
                    ub = 0.0;
                }
            }
            reactionBounds[r.id] = Math.max(0.0, ub);
        }

        const outgoingBySrc = {};
        const incomingByTgt = {};
        const activeFlowOutCount = {};
        for (const r of data.reactions) {
            outgoingBySrc[r.id] = [];
            incomingByTgt[r.id] = [];
            activeFlowOutCount[r.id] = 0;
        }

        const edgeUbs = data.transitions.map((t, idx) => {
            if (removedSet.has(t.source + "->" + t.target)) return 0.0;
            activeFlowOutCount[t.source] = (activeFlowOutCount[t.source] || 0) + 1;
            if (!active[t.source] || !active[t.target]) return 0.0;
            if (t.activation_logic) {
                if (!evalFbaLogic(t.activation_logic, active, flowInputsByTarget[t.target], compInhByTarget[t.target], removedSet, t.target)) {
                    return 0.0;
                }
            } else {
                for (const ga of t.gate_activators || []) {
                    if (!removedSet.has(ga + "->" + t.target) && !active[ga]) return 0.0;
                }
                for (const gi of t.gate_inhibitors || []) {
                    if (!removedSet.has(gi + "->" + t.target) && active[gi]) return 0.0;
                }
            }
            let eUb = Math.min(reactionBounds[t.source], reactionBounds[t.target]);
            for (const inh of t.competing_inhibitors || []) {
                if (!removedSet.has(inh + "->" + t.target) && active[inh]) {
                    eUb *= params.competing_inhibitor_factor;
                }
            }
            for (const mod of t.positive_modulators || []) {
                if (removedSet.has(mod + "->" + t.target)) continue;
                if (active[mod]) {
                    eUb *= params.positive_regulator_boost;
                } else if (!t.activation_logic) {
                    eUb = 0.0;
                }
            }
            eUb = Math.max(0.0, eUb);
            if (eUb > EPS) {
                outgoingBySrc[t.source].push({ idx, t, eUb });
                incomingByTgt[t.target].push(idx);
            }
            return eUb;
        });

        const flowRxns = data.reactions.filter(r => r.is_flow_stage);
        const effTermSet = new Set(
            flowRxns
                .filter(r => r.is_terminal || (activeFlowOutCount[r.id] || 0) === 0)
                .map(r => r.id)
        );

        const downstreamCap = {};
        const parsimonyCost = {};
        for (const r of flowRxns) {
            if (effTermSet.has(r.id)) {
                downstreamCap[r.id] = reactionBounds[r.id];
                parsimonyCost[r.id] = 1.0 + (r.is_optional_branch ? 2.0 : 0.0);
            } else {
                downstreamCap[r.id] = 0.0;
                parsimonyCost[r.id] = 1e6;
            }
        }

        for (let iter = 0; iter < flowRxns.length + 2; iter++) {
            let changed = false;
            for (let k = flowRxns.length - 1; k >= 0; k--) {
                const r = flowRxns[k];
                if (effTermSet.has(r.id)) continue;
                const outs = outgoingBySrc[r.id] || [];
                let newCap = 0.0;
                let newCost = 1e6;
                if (outs.length > 0) {
                    const edgeCaps = outs.map(o => Math.min(o.eUb, downstreamCap[o.t.target] || 0.0));
                    newCap = Math.min(reactionBounds[r.id], edgeCaps.reduce((a, b) => a + b, 0.0));
                    const openCosts = outs
                        .filter((o, i) => edgeCaps[i] > EPS)
                        .map(o => parsimonyCost[o.t.target]);
                    const stepPen = 1.0 + (r.is_optional_branch ? 2.0 : 0.0);
                    newCost = openCosts.length > 0 ? stepPen + Math.min(...openCosts) : 1e6;
                }
                if (Math.abs(downstreamCap[r.id] - newCap) > 1e-9 || Math.abs(parsimonyCost[r.id] - newCost) > 1e-9) {
                    downstreamCap[r.id] = newCap;
                    parsimonyCost[r.id] = newCost;
                    changed = true;
                }
            }
            if (!changed) break;
        }

        const rxnFlux = {};
        for (const r of data.reactions) rxnFlux[r.id] = 0.0;
        const edgeFlux = new Array(data.transitions.length).fill(0.0);

        const entryIds = data.entry_reactions.filter(id => (downstreamCap[id] || 0) > EPS);
        if (entryIds.length > 0 && uptakeRate > 0) {
            const eCaps = entryIds.map(id => downstreamCap[id]);
            const eWeights = entryIds.map(id => downstreamCap[id] / Math.max(1.0, parsimonyCost[id] || 1.0));
            const eAlloc = waterfillAllocate(uptakeRate, eCaps, eWeights);
            entryIds.forEach((id, i) => { rxnFlux[id] = eAlloc[i]; });
        }

        const entrySet = new Set(data.entry_reactions);
        for (let iter = 0; iter < flowRxns.length + 2; iter++) {
            const targetAllocated = {};
            for (const r of flowRxns) targetAllocated[r.id] = 0.0;
            for (const r of flowRxns) {
                if (!entrySet.has(r.id)) {
                    const inc = incomingByTgt[r.id] || [];
                    rxnFlux[r.id] = Math.min(
                        downstreamCap[r.id] || 0.0,
                        inc.reduce((acc, idx) => acc + edgeFlux[idx], 0.0)
                    );
                }
                const uFlux = rxnFlux[r.id];
                if (effTermSet.has(r.id)) continue;
                const outs = outgoingBySrc[r.id] || [];
                if (outs.length === 0 || uFlux <= EPS) {
                    outs.forEach(o => { edgeFlux[o.idx] = 0.0; });
                    continue;
                }
                const caps = outs.map(o => {
                    const remTgt = Math.max(0.0, (downstreamCap[o.t.target] || 0.0) - (targetAllocated[o.t.target] || 0.0));
                    return Math.min(o.eUb, remTgt);
                });
                const weights = outs.map((o, i) => caps[i] / Math.max(1.0, parsimonyCost[o.t.target] || 1.0));
                const alloc = waterfillAllocate(uFlux, caps, weights);
                outs.forEach((o, i) => {
                    edgeFlux[o.idx] = alloc[i];
                    targetAllocated[o.t.target] = (targetAllocated[o.t.target] || 0.0) + alloc[i];
                });
                const actualOut = alloc.reduce((a, b) => a + b, 0.0);
                if (actualOut < uFlux - 1e-9) rxnFlux[r.id] = actualOut;
            }
        }

        for (let sweep = 0; sweep < flowRxns.length; sweep++) {
            for (let k = flowRxns.length - 1; k >= 0; k--) {
                const r = flowRxns[k];
                if (!effTermSet.has(r.id)) {
                    const outs = outgoingBySrc[r.id] || [];
                    rxnFlux[r.id] = outs.reduce((acc, o) => acc + edgeFlux[o.idx], 0.0);
                }
                if (!entrySet.has(r.id)) {
                    const inc = incomingByTgt[r.id] || [];
                    const inSum = inc.reduce((acc, idx) => acc + edgeFlux[idx], 0.0);
                    if (inSum > rxnFlux[r.id] + 1e-9 && inSum > 0) {
                        const scale = rxnFlux[r.id] / inSum;
                        inc.forEach(idx => { edgeFlux[idx] *= scale; });
                    }
                }
            }
        }

        let maxResidual = 0.0;
        for (const r of flowRxns) {
            const incSum = entrySet.has(r.id)
                ? rxnFlux[r.id]
                : (incomingByTgt[r.id] || []).reduce((acc, idx) => acc + edgeFlux[idx], 0.0);
            const outSum = effTermSet.has(r.id)
                ? rxnFlux[r.id]
                : (outgoingBySrc[r.id] || []).reduce((acc, o) => acc + edgeFlux[o.idx], 0.0);
            maxResidual = Math.max(maxResidual, Math.abs(incSum - outSum));
        }

        const transitionFluxes = data.transitions.map((t, idx) => ({
            ...t,
            upper_bound: edgeUbs[idx],
            flux: edgeFlux[idx]
        }));

        const totalUptake = data.entry_reactions.reduce((acc, id) => acc + (rxnFlux[id] || 0.0), 0.0);
        const totalExport = Array.from(effTermSet).reduce((acc, id) => acc + (rxnFlux[id] || 0.0), 0.0);
        const totalL1 = Object.values(rxnFlux).reduce((a, b) => a + b, 0.0);

        return {
            elementActive: active,
            gprCapacities,
            reactionBounds,
            downstreamCap,
            reactionFluxes: rxnFlux,
            transitionFluxes,
            totalUptake,
            totalExport,
            totalL1,
            maxResidual
        };
    }

    function cycleSetting(id) {
        if (!Object.prototype.hasOwnProperty.call(currentSettings, id)) {
            currentSettings[id] = false;
        } else if (currentSettings[id] === false || currentSettings[id] === 0) {
            currentSettings[id] = 0.5;
        } else if (currentSettings[id] === 0.5) {
            currentSettings[id] = true;
        } else {
            delete currentSettings[id];
        }
        currentScenario = "__custom__";
        recompute();
    }

    function pillState(id) {
        if (!Object.prototype.hasOwnProperty.call(currentSettings, id)) {
            return { cls: "auto", text: "Auto" };
        }
        const v = currentSettings[id];
        if (v === false || v === 0) return { cls: "off", text: "KO (0%)" };
        if (typeof v === "number" && v < 1.0) return { cls: "half", text: `E-Flux (${Math.round(v * 100)}%)` };
        return { cls: "on", text: "Locked ON" };
    }

    function renderReactions() {
        const container = document.getElementById("reactions-container");
        container.innerHTML = "";
        const maxScale = Math.max(100, currentUptake);

        data.reactions.forEach((r, idx) => {
            const flux = simResult.reactionFluxes[r.id] || 0.0;
            const ub = simResult.reactionBounds[r.id] || 0.0;
            const isEnabled = simResult.elementActive[r.id];
            const fluxPct = Math.min(100, Math.round((flux / maxScale) * 100));
            const ubPct = Math.min(100, Math.round((ub / maxScale) * 100));
            const pill = pillState(r.id);

            const card = document.createElement("div");
            card.className = "rxn-box" + (!isEnabled || ub <= EPS ? " blocked" : (flux <= EPS ? " zero-flux" : ""));
            card.title = "Click to cycle E-Flux state (Auto -> KO 0% -> 50% E-Flux -> Locked 100%)";

            const chemStr = (r.substrates && r.substrates.length) || (r.products && r.products.length)
                ? `${(r.substrates || []).join(" + ") || "input"} → ${(r.products || []).join(" + ") || "output"}`
                : "";
            const genesStr = (r.representative_genes || []).slice(0, 4).join(", ");

            card.innerHTML = `
                <div class="rxn-top">
                    <div class="rxn-title">${escHtml(r.label)}</div>
                    <div class="rxn-flux">${r.is_flow_stage ? flux.toFixed(1) : (isEnabled ? "ON" : "OFF")}</div>
                </div>
                <div class="rxn-meta">
                    <code>${escHtml(r.id)}</code>
                    ${r.location_label ? " · " + escHtml(r.location_label) : ""}
                    ${r.is_optional_branch ? " · <em>optional branch</em>" : ""}
                </div>
                ${chemStr ? `<div class="chem-line">${escHtml(chemStr)}</div>` : ""}
                ${r.is_flow_stage ? `
                <div class="bar-track">
                    <div class="bar-bound" style="width:${ubPct}%"></div>
                    <div class="bar-fill" style="width:${fluxPct}%;background:${COLORS[idx % COLORS.length]}"></div>
                </div>
                ` : ""}
                <div class="rxn-meta">
                    ${genesStr ? `<strong>Enzymes:</strong> ${escHtml(genesStr)}<br>` : ""}
                    ${r.gpr_rule_text && r.gpr_rule_text !== r.id ? `<strong>GPR:</strong> <code>${escHtml(r.gpr_rule_text)}</code>` : ""}
                </div>
                <div class="rxn-footer">
                    <span>${r.is_flow_stage ? `UB: ${ub.toFixed(1)} · DownCap: ${(simResult.downstreamCap[r.id] || 0).toFixed(1)}` : "Regulator"}</span>
                    <span class="lock-pill ${pill.cls}">${escHtml(pill.text)}</span>
                </div>
            `;
            card.addEventListener("click", () => cycleSetting(r.id));
            container.appendChild(card);
        });
    }

    function renderGprElements() {
        const container = document.getElementById("gpr-container");
        if (!container) return;
        container.innerHTML = "";
        (data.gpr_elements || []).forEach(g => {
            const cap = simResult.gprCapacities[g.id] ?? 1.0;
            const pill = pillState(g.id);
            const chip = document.createElement("div");
            chip.className = "gpr-chip" + (cap <= EPS ? " ko" : (cap < 0.99 ? " half" : ""));
            const genes = (g.representative_genes || []).slice(0, 3).join(", ");
            chip.innerHTML = `
                <div style="display:flex;justify-content:space-between;align-items:center;gap:0.35rem;">
                    <strong>${escHtml(g.label)}</strong>
                    <span class="lock-pill ${pill.cls}">${Math.round(cap * 100)}%</span>
                </div>
                <div style="color:#475569;margin-top:2px;">
                    <code>${escHtml(g.id)}</code> · <span style="text-transform:uppercase;font-size:0.68rem;">${escHtml(g.kind)}</span>
                    → <code>${escHtml(g.reaction_id)}</code>
                </div>
                ${genes ? `<div style="color:#64748b;margin-top:2px;font-size:0.72rem;">${escHtml(genes)}</div>` : ""}
            `;
            chip.addEventListener("click", () => cycleSetting(g.id));
            container.appendChild(chip);
        });
    }

    function renderChart() {
        const svg = document.getElementById("flux-chart");
        const flowRxns = data.reactions.filter(r => r.is_flow_stage);
        const W = 740, H = 220, padL = 44, padR = 16, padT = 18, padB = 46;
        const plotW = W - padL - padR;
        const plotH = H - padT - padB;
        const maxVal = Math.max(100, currentUptake, ...flowRxns.map(r => simResult.reactionBounds[r.id] || 0));

        let html = `<line x1="${padL}" y1="${padT + plotH}" x2="${padL + plotW}" y2="${padT + plotH}" stroke="#cbd5e1"/>`;
        html += `<line x1="${padL}" y1="${padT}" x2="${padL}" y2="${padT + plotH}" stroke="#cbd5e1"/>`;
        html += `<text x="6" y="${padT + 10}" font-size="10" fill="#64748b">${maxVal.toFixed(0)}</text>`;
        html += `<text x="18" y="${padT + plotH}" font-size="10" fill="#64748b">0</text>`;

        const n = Math.max(1, flowRxns.length);
        const slotW = plotW / n;
        const barW = Math.min(48, slotW * 0.62);

        flowRxns.forEach((r, idx) => {
            const ub = simResult.reactionBounds[r.id] || 0.0;
            const flux = simResult.reactionFluxes[r.id] || 0.0;
            const x = padL + idx * slotW + (slotW - barW) / 2;
            const ubH = (ub / maxVal) * plotH;
            const fluxH = (flux / maxVal) * plotH;
            const color = COLORS[idx % COLORS.length];

            html += `<rect x="${x.toFixed(1)}" y="${(padT + plotH - ubH).toFixed(1)}" width="${barW.toFixed(1)}" height="${ubH.toFixed(1)}" fill="#e0f2fe" stroke="#7dd3fc" rx="3"/>`;
            html += `<rect x="${x.toFixed(1)}" y="${(padT + plotH - fluxH).toFixed(1)}" width="${barW.toFixed(1)}" height="${fluxH.toFixed(1)}" fill="${color}" rx="3"/>`;
            html += `<text x="${(x + barW / 2).toFixed(1)}" y="${(padT + plotH - fluxH - 4).toFixed(1)}" text-anchor="middle" font-size="10" font-weight="600" fill="#0f172a">${flux.toFixed(1)}</text>`;
            const shortId = r.id.length > 16 ? r.id.slice(0, 15) + "…" : r.id;
            html += `<text x="${(x + barW / 2).toFixed(1)}" y="${padT + plotH + 16}" text-anchor="middle" font-size="9.5" fill="#475569">${escHtml(shortId)}</text>`;
        });
        svg.innerHTML = html;
    }

    function renderTransitions() {
        const tbody = document.getElementById("transitions-tbody");
        tbody.innerHTML = "";
        simResult.transitionFluxes.forEach(tr => {
            const mets = (tr.shared_metabolites || []).join(", ") || tr.description || "—";
            const row = document.createElement("tr");
            row.innerHTML = `
                <td><code>${escHtml(tr.source)}</code></td>
                <td><code>${escHtml(tr.target)}</code></td>
                <td>${escHtml(mets)}</td>
                <td>${tr.upper_bound.toFixed(1)}</td>
                <td><strong>${tr.flux.toFixed(2)}</strong></td>
            `;
            tbody.appendChild(row);
        });
    }

    function updateScenarioButtons() {
        document.querySelectorAll(".scenario-btn").forEach(btn => {
            btn.classList.toggle("active", btn.getAttribute("data-scenario") === currentScenario);
        });
        const box = document.getElementById("scenario-details");
        const sc = data.scenarios.find(s => s.id === currentScenario);
        if (sc) {
            const activeText = (sc.expected_active || []).length
                ? `<div><strong>Expected active:</strong> <code>${sc.expected_active.map(escHtml).join(", ")}</code></div>`
                : "";
            const inactiveText = (sc.expected_inactive || []).length
                ? `<div><strong>Expected zero-flux:</strong> <code>${sc.expected_inactive.map(escHtml).join(", ")}</code></div>`
                : "";
            const orderText = (sc.expected_outcome_order || []).length
                ? `<div><strong>Expected flux order:</strong> <code>${sc.expected_outcome_order.map(escHtml).join(" &gt; ")}</code></div>`
                : "";
            box.innerHTML = `
                <div><strong>Scenario:</strong> ${escHtml(sc.label)}</div>
                ${sc.description ? `<div style="margin-top:4px;color:#475569;">${escHtml(sc.description)}</div>` : ""}
                <div style="margin-top:6px;">${activeText}${inactiveText}${orderText}</div>
            `;
        } else if (currentScenario === "__baseline__") {
            box.innerHTML = `<div><strong>Unperturbed WT baseline:</strong> All enzymes and GPR branches enabled with default module upper bounds.</div>`;
        } else {
            box.innerHTML = `<div><strong>Custom E-Flux perturbation:</strong> Settings <code>${escHtml(JSON.stringify(currentSettings))}</code></div>`;
        }
    }

    function recompute() {
        simResult = simulate(currentSettings, currentRemoved, currentUptake);
        document.getElementById("uptake-label").textContent = `${currentUptake}`;
        document.getElementById("kpi-uptake").textContent = simResult.totalUptake.toFixed(2);
        document.getElementById("kpi-export").textContent = simResult.totalExport.toFixed(2);
        document.getElementById("kpi-l1").textContent = simResult.totalL1.toFixed(2);
        document.getElementById("kpi-residual").textContent = simResult.maxResidual.toFixed(4);
        updateScenarioButtons();
        renderReactions();
        renderGprElements();
        renderChart();
        renderTransitions();
    }

    function selectScenario(scId) {
        currentScenario = scId;
        if (scId === "__baseline__") {
            currentSettings = {};
            currentRemoved = [];
        } else {
            const sc = data.scenarios.find(s => s.id === scId);
            if (sc) {
                currentSettings = { ...(sc.settings || {}) };
                currentRemoved = [...(sc.removed_connections || [])];
            }
        }
        recompute();
    }

    document.querySelectorAll(".scenario-btn").forEach(btn => {
        btn.addEventListener("click", () => selectScenario(btn.getAttribute("data-scenario")));
    });

    document.getElementById("uptake-slider").addEventListener("input", e => {
        currentUptake = parseFloat(e.target.value);
        recompute();
    });

    document.getElementById("btn-reset").addEventListener("click", () => {
        currentUptake = params.uptake_rate;
        document.getElementById("uptake-slider").value = String(currentUptake);
        selectScenario("__baseline__");
    });

    selectScenario(currentScenario);
})();
</script>
</body>
</html>

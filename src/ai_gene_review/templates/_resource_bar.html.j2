{#- Project resource bar: one pill per ``manifest`` entry (slides, artifacts, ...).
    Expects ``resources`` from render_projects.manifest_resources. Styles
    (.resource-bar) live in the including template's <head>. -#}
{% if resources %}
<nav class="resource-bar" aria-label="Project resources">
    {% for r in resources %}<a class="rk-{{ r.kind }}" href="{{ r.href }}"{% if r.external %} target="_blank" rel="noopener"{% endif %} title="{{ r.label }}{% if r.description %} ({{ r.description }}){% endif %}{% if r.external %}, opens an external page{% endif %}">{{ r.label }}{% if r.description %} <span class="note">{{ r.description }}</span>{% endif %}{% if r.external %} <span class="ext" aria-label="opens an external page">&#8599;</span>{% endif %}</a>
    {% endfor %}
</nav>
{% endif %}

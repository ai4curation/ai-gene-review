# Run in this directory. Python standard library only; no package dependencies.
fetch:
    curl --fail --location https://files.rcsb.org/download/8H52.pdb --output data/8H52.pdb
    curl --fail --location https://files.rcsb.org/download/3N29.pdb --output data/3N29.pdb

analyze:
    uv run --python 3.12 python scripts/ligand_contacts.py --pdb data/8H52.pdb --chain A --ligand NAP --first-residue 1 --last-residue 30 --cutoff 4.0 --output results/8H52-NADP-contacts.json
    uv run --python 3.12 python scripts/ligand_contacts.py --pdb data/3N29.pdb --chain A --ligand PLP --first-residue 35 --last-residue 45 --cutoff 4.0 --output results/3N29-PLP-control.json

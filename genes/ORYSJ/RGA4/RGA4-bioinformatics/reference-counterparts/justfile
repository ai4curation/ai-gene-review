root := justfile_directory() / "../../../../.."

analyze:
    cd "{{root}}" && uv run python projects/ORPHAN_CURATED/analyze_report.py projects/ORPHAN_CURATED/reports/orphan-curated.csv --accession F7J0M4 --fetch --rerun

snapshot:
    cd "{{root}}" && uv run python projects/ORPHAN_CURATED/fetch_record_evidence.py F7J0M4 F7J0M6 --proteome UP000059680  --history-versions 17 38 48 --output genes/ORYSJ/RGA4/RGA4-record-evidence.yaml

analyze:
    uv run python scripts/primer_matches.py --primers data/PMID31134357-TableS1.xlsx --protein-record ../SLAC1-uniprot.txt --protein-record ../../SAPK10/SAPK10-uniprot.txt --embl-record data/AK106615.embl --output results/primer-protein-matches.tsv

# Source files are preserved unchanged; this recipe refreshes them from their providers.
fetch:
    uv run python scripts/download_input.py https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6536566/supplementaryFiles data/PMID31134357-TableS1.xlsx --member 12284_2019_297_MOESM8_ESM.xlsx
    uv run python scripts/download_input.py https://www.ebi.ac.uk/ena/browser/api/embl/AK106615 data/AK106615.embl

out := "results.json"

# Large downloads (PAO1 proteome, SJTE-1 GenBank) are re-fetched, not committed (see .gitignore)
fetch:
    test -s data/pao1_proteome.fasta || (curl -s "https://rest.uniprot.org/uniprotkb/stream?query=proteome:UP000002438&format=fasta&compressed=true" | gunzip > data/pao1_proteome.fasta)
    test -s data/NZ_CP015876.1.gbk || curl -s "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=nuccore&id=NZ_CP015876.1&rettype=gbwithparts&retmode=text" > data/NZ_CP015876.1.gbk

analyze out=out:
    uv run --project ../../../.. python analyze.py --query data/query.fasta --refs data/refs.fasta --hmms data/PF02308.hmm data/PF13194.hmm --pao1 data/pao1_proteome.fasta --gbk data/NZ_CP015876.1.gbk --dashboard data/dashboard_call.json --output {{out}}

all: fetch analyze

# Run from this directory. Choose a new output directory to preserve prior runs.
live repo_root="../../../.." output="rerun-live":
    uv run --project . python check_quickgo.py --config config.yaml --repo-root "{{repo_root}}" --output "{{output}}"

replay repo_root="../../../.." output="rerun-replay":
    uv run --project . python check_quickgo.py --config config.yaml --repo-root "{{repo_root}}" --observations results/manifest.yaml --output "{{output}}"

pagination repo_root="../../../.." output="rerun-pagination":
    uv run --project . python check_quickgo.py --config config.yaml --repo-root "{{repo_root}}" --query lman2 --page-size 5 --output "{{output}}"

    {
      "id": "GO:0043029",
      "isObsolete": false,
      "name": "T cell homeostasis",
      "definition": {
        "text": "The process of regulating the proliferation and elimination of T cells such that the total number of T cells within a whole or part of an organism is stable over time in the absence of an outside stimulus.",
        "xrefs": [
          {
            "dbCode": "ISBN",
            "dbId": "0781735149"
          }
        ]
      },
      "comment": "Note that this term represents the return of T cell levels to stable numbers following an immune response as well as the proliferation and elimination of T cells required to maintain stable numbers in the absence of an outside stimulus.",

analyze:
    uv run --locked python extract_sequence.py data/assay.embl embl data/assay-sequence.fasta
    uv run --locked python align_products.py data/assay-sequence.fasta data/human-products.fasta --positions 96,112,217,228,234,622,623,624,625,626,627,628 --output results/ctnnd1.json

check-other-gene:
    uv run --locked python align_products.py data/test-human.fasta data/test-mouse.fasta --positions 1,100,500 --output results/ctnnb1-control.json

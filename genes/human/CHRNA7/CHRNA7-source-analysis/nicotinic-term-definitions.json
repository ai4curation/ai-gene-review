  "GO:0042472": {
    "id": "GO:0042472",
    "isObsolete": false,
    "name": "inner ear morphogenesis",
    "definition": {
      "text": "The process in which the anatomical structures of the inner ear are generated and organized. The inner ear is the structure in vertebrates that contains the organs of balance and hearing. It consists of soft hollow sensory structures (the membranous labyrinth) containing fluid (endolymph) surrounded by fluid (perilymph) and encased in a bony cavity (the bony labyrinth). It consists of two chambers, the sacculus and utriculus, from which arise the cochlea and semicircular canals respectively.",
      "xrefs": [
        {
          "dbCode": "ISBN",
          "dbId": "0192801023"
        }

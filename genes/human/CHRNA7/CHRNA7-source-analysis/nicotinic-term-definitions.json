  "GO:0060079": {
    "id": "GO:0060079",
    "isObsolete": false,
    "name": "excitatory postsynaptic potential",
    "definition": {
      "text": "A process that leads to a temporary increase in postsynaptic potential due to the flow of positively charged ions into the postsynaptic cell. The flow of ions that causes an EPSP is an excitatory postsynaptic current (EPSC) and makes it easier for the neuron to fire an action potential."
    },
    "synonyms": [
      {
        "name": "regulation of EPSP",
        "type": "related"
      },
      {
        "name": "regulation of excitatory post-synaptic membrane potential",
        "type": "exact"

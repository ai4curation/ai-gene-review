replay:
    uv run --frozen python replay.py --check results.json
    uv run --frozen python replay.py --accession Q6DN12 --paint-only --check comparison-MCTP2.json

regenerate:
    uv run --frozen python replay.py --output results.json
    uv run --frozen python replay.py --accession Q6DN12 --paint-only --output comparison-MCTP2.json

config := "config.json"
out := "results"
publications := "../../../../publications"

run:
    python3 audit_interactions.py --config {{config}} --output-dir {{out}} --publications-dir {{publications}}

check:
    python3 -c 'from pathlib import Path; p = Path("audit_interactions.py"); compile(p.read_text(), str(p), "exec")'
    python3 audit_interactions.py --config {{config}} --output-dir {{out}} --publications-dir {{publications}}

show:
    column -s $'\t' -t < {{out}}/uniprot_identities.tsv
    column -s $'\t' -t < {{out}}/bioplex_LNP1_14-3-3_source_rows.tsv
    column -s $'\t' -t < {{out}}/hpa_localization_snapshot.tsv

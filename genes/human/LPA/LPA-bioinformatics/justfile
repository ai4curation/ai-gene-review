set shell := ["bash", "-euo", "pipefail", "-c"]

python := "uv run python"
accessions := "P08519 P00747 P00734 P14210"

default: all

fetch:
    {{python}} scripts/fetch_official_records.py --accessions {{accessions}} --output-dir raw

analyze: fetch
    {{python}} scripts/analyze_protease_domains.py --input-dir raw --reference P00747 --targets P08519 P00734 P14210 --output-dir outputs

all: analyze

check:
    {{python}} scripts/check_outputs.py --input-dir raw --output-dir outputs --expected-accessions {{accessions}}

clean-generated:
    rm -rf raw outputs

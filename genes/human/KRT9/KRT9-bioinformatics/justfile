# KRT9 bioinformatics analysis. `just all` reruns everything from the data/ snapshot.
all:
    uv run run_all.py

# refetch every input from UniProt, ClinVar, gnomAD, InterPro, AlphaFold DB, PANTHER and RCSB first
refresh:
    uv run run_all.py --refresh

fetch:
    uv run 00_fetch.py
architecture:
    uv run 01_architecture.py
    uv run 01_architecture.py --keratin-gene KRT14 --tag control_KRT14
variants:
    uv run 02_variants.py
statistics:
    uv run 03_statistics.py
conservation:
    uv run 04_conservation.py
structure:
    uv run 05_structure.py
tables:
    uv run 06_report_tables.py

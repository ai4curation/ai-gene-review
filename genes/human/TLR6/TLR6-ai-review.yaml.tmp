    label: signal transduction
  evidence_type: TAS
  original_reference_id: PMID:10231569
  qualifier: involved_in
  review:
    summary: TAS from the TLR6 cloning paper.
    action: ACCEPT
    reason: General but correct; constitutively active TLR6 signals to NF-kB and JNK.

# Reproduce the LDHD variant/structure analysis. `just all` refetches inputs and reruns everything.
all: fetch analyze

fetch:
    uv run python fetch_data.py

analyze:
    uv run python isoform_exons.py > /dev/null
    uv run python structure_survey.py > /dev/null
    uv run python analyze_variants.py > /dev/null
    uv run python population_variants.py > /dev/null
    uv run python topology_scan.py > /dev/null
    uv run python mitocarta_lookup.py > /dev/null

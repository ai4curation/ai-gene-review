default: compare

# Uses the immutable FASTA snapshots checked into this directory.
compare:
    uv run --no-project --python 3.12 python compare_fasta.py data/AY692226-cds.fasta data/Q5JSL3.fasta results/DOCK11.json

# Download fresh records separately: this does not overwrite the frozen inputs.
refresh:
    mkdir -p fresh
    curl --fail --location 'https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=nuccore&id=AY692226.1&rettype=fasta_cds_aa&retmode=text' -o fresh/AY692226-cds.fasta
    curl --fail --location 'https://rest.uniprot.org/uniprotkb/Q5JSL3.fasta' -o fresh/Q5JSL3.fasta
    uv run --no-project --python 3.12 python compare_fasta.py fresh/AY692226-cds.fasta fresh/Q5JSL3.fasta fresh/comparison.json

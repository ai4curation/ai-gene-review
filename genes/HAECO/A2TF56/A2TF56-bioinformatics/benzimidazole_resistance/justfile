set shell := ["bash", "-euo", "pipefail", "-c"]

fasta := "data/beta_tubulin_sequences.fasta"
output := "results/resistance_sites.csv"

all: resistance-sites

resistance-sites:
    mkdir -p results
    python3 scripts/check_resistance_sites.py \
        --fasta {{fasta}} \
        --target A2TF56_EF198865_ABM92348 \
        --positions 167 198 200 \
        > {{output}}

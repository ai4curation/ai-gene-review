set shell := ["bash", "-euo", "pipefail", "-c"]

fasta := "data/beta_tubulin_sequences.fasta"
output := "results/resistance_sites.csv"
check_script := "../../../A2TF56/A2TF56-bioinformatics/benzimidazole_resistance/scripts/check_resistance_sites.py"

all: resistance-sites

resistance-sites:
    mkdir -p results
    python3 {{check_script}} \
        --fasta {{fasta}} \
        --target Q25022_M76491_AAA29168 \
        --positions 167 198 200 \
        > {{output}}

all:
    uv run python prepare.py --json ../CG33090-uniprot-source.json --swiss ../CG33090-reference-Q7KT91-uniprot.txt ../CG33090-reference-Q9HCG7-uniprot.txt --output inputs/sequences.fasta
    mafft --globalpair --maxiterate 1000 inputs/sequences.fasta > outputs/global.fasta 2> outputs/global-stderr.txt
    mafft --localpair --maxiterate 1000 inputs/sequences.fasta > outputs/local.fasta 2> outputs/local-stderr.txt
    uv run python analyze.py outputs/global.fasta --reference Q9HCG7 --sites 527 677 --output outputs/global-sites.json
    uv run python analyze.py outputs/local.fasta --reference Q9HCG7 --sites 527 677 --output outputs/local-sites.json
    uv run python analyze.py outputs/global.fasta --reference Q7KT91 --sites 132 445 505 937 --output outputs/isoform-coverage.json
    uv run python compare.py inputs/sequences.fasta --reference Q7KT91 --output outputs/exact-suffix.json

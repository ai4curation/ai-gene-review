  "comments": [
    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000256",
              "source": "ARBA",
              "id": "ARBA00034296"
            },
            {
              "evidenceCode": "ECO:0000256",
              "source": "RuleBase",
              "id": "RU000352"
            }
          ],
          "value": "Tubulin is the major constituent of microtubules, a cylinder consisting of laterally associated linear protofilaments composed of alpha- and beta-tubulin heterodimers. Microtubules grow by the addition of GTP-tubulin dimers to the microtubule end, where a stabilizing cap forms. Below the cap, tubulin dimers are in GDP-bound state, owing to GTPase activity of alpha-tubulin"
        }
      ],
      "commentType": "FUNCTION"
    },
    {
      "commentType": "COFACTOR",
      "cofactors": [
        {
          "name": "Mg(2+)",
          "evidences": [

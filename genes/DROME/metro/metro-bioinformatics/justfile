# Requires MAFFT 7.526 on PATH; Python uses only the standard library.
fetch:
    uv run python fetch.py --out data A1Z8G0 P15454 Q16774 P31016 Q00013

analyze:
    uv run python analyze.py --data data --reference P15454 --positions 9 10 11 12 13 14 15 16 35 39 40 41 42 51 70 79 80 81 101 --out results
    uv run python analyze.py --data data --reference Q16774 --positions 17 18 37 103 --out results/human-reference-control

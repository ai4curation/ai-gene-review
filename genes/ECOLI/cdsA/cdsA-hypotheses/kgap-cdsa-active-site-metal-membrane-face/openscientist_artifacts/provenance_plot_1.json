airs])\n    d=np.linalg.norm(ap(aP,R,pc,qc)-aQ,axis=1); cut=max(4.0,np.percentile(d,75))\n    new=[p for p,dd in zip(pairs,d) if dd<=cut]\n    print(f\"iter{it}: n={len(cur)} RMSD={r:.2f}A -> keep {len(new)}\")\n    if len(new)==len(cur) or len(new)<70: break\n    cur=new\nP=np.array([af_ca[e] for e,t in cur]);Q=np.array([tm_ca[t] for e,t in cur]);R,pc,qc=kab(P,Q)\ncore=np.sqrt((np.linalg.norm(ap(P,R,pc,qc)-Q,axis=1)**2).mean())\nprint(f\"\\nFINAL superposition: {len(cur)}/{len(pairs)} CA pairs, core RMSD = {core:.2f} A\")\nexyz={e:ap(af_ca[e][None],R,pc,qc)[0] for e in af_ca}\necz={e:float(exyz[e][2]) for e in af_ca}\nprint(\"Bilayer -14.9..+14.9 ; Mg2+ z=%.1f ; K+ z=%.1f\"%(ions['MG'][2],ions['K'][2]))\nprint(f\"\\n{'residue':<10}{'z (A)':>8}{'d(Mg)':>8}{'d(K)':>8}{'pLDDT':>7}\")\nkey=[(1,'N-term'),(165,''),(188,''),(231,''),(235,'Mg dyad'),(238,''),(239,''),(242,''),(262,''),(265,'Mg dyad'),(266,''),(285,'C-term')]\ntab=[]\nfor r,lab in key:\n    dmg=float(np.linalg.norm(exyz[r]-ions['MG'])); dk=float(np.linalg.norm(exyz[r]-ions['K']))\n    print(f\"{ec[r-1]}{r:<9}{ecz[r]:>8.1f}{dmg:>8.1f}{dk:>8.1f}{plddt[r]:>7.0f}  {lab}\")\n    tab.append(dict(res=f\"{ec[r-1]}{r}\",z=round(ecz[r],1),d_Mg=round(dmg,1),d_K=round(dk,1),pLDDT=plddt[r],note=lab))\nimport pandas as pd; pd.DataFrame(tab).to_csv('/tmp/ec_site.csv',index=False)\n\n# N/C terminus side + positive-inside rule on the E. coli model in the membrane frame\nhz=14.9\ncyt=[r for r in af_ca if ecz[r]<-hz]; per=[r for r in af_ca if ecz[r]>hz]\nprint(f\"\\nE. coli model: residues with z<-{hz} (cytoplasmic side) n={len(cyt)}, K/R={sum(1 for r in cyt if ec[r-1] in 'KR')}, D/E={sum(1 for r in cyt if ec[r-1] in 'DE')}\")\nprint(f\"               residues with z>+{hz} (periplasmic side) n={len(per)}, K/R={sum(1 for r in per if ec[r-1] in 'KR')}, D/E={sum(1 for r in per if ec[r-1] in 'DE')}\")\n# membrane crossings\nzs=np.array([ecz[r] for r in range(1,286)])\nsign=np.where(zs>0,1,-1); cross=0; prev=None\nseq_state=[]\nfor r in range(1,286):\n    s='P' if ecz[r]>hz else ('C' if ecz[r]<-hz else 'M')\n    seq_state.append(s)\ncompact=[]\nfor s in seq_state:\n    if not compact or compact[-1][0]!=s: compact.append([s,1])\n    else: compact[-1][1]+=1\nprint(\"\\nTopology string (C=cytoplasmic side, M=in bilayer, P=periplasmic side), run-lengths:\")\nprint(' '.join(f\"{s}{n}\" for s,n in compact))\n\n# ---- figure ----\nfig,axes=plt.subplots(1,2,figsize=(13,6))\nax=axes[0]\nxs=[exyz[r][0] for r in range(1,286)]; zz=[ecz[r] for r in range(1,286)]\nax.axhspan(-14.9,14.9,color='0.88',zorder=0)\nax.plot(xs,zz,'-',color='0.55',lw=0.8,zorder=1)\nax.scatter(xs,zz,c=[plddt[r] for r in range(1,286)],cmap='viridis',s=14,vmin=50,vmax=100,zorder=2)\nfor r,lab in [(235,'D235'),(265,'D265'),(238,'E238'),(242,'K242'),(165,'D165'),(262,'D262'),(1,'M1'),(285,'L285')]:\n    ax.annotate(lab,(exyz[r][0],ecz[r]),fontsize=9,xytext=(4,4),textcoords='offset points')\n    ax.plot(exyz[r][0],ecz[r],'o',mfc='none',mec='crimson',ms=9,mew=1.4,zorder=3)\nax.plot(ions['MG'][0],ions['MG'][2],'*',color='darkorange',ms=20,zorder=4,label='Mg$^{2+}$ (TmCdsA)')\nax.plot(ions['K'][0],ions['K'][2],'*',color='royalblue',ms=20,zorder=4,label='K$^{+}$ (TmCdsA)')\nax.axhline(14.9,color='k',lw=0.7,ls='--'); ax.axhline(-14.9,color='k',lw=0.7,ls='--')\nax.set_xlabel('x in OPM membrane frame (\u00c5)'); ax.set_ylabel('z, membrane normal (\u00c5)')\nax.set_title('E. coli CdsA AlphaFold model superposed on\\nmembrane-oriented TmCdsA (4Q2E), core RMSD %.2f \u00c5'%core, fontsize=11)\nax.text(0.02,0.96,'periplasm',transform=ax.transAxes,va='top',fontsize=10)\nax.text(0.02,0.04,'cytoplasm',transform=ax.transAxes,va='bottom',fontsize=10)\nax.legend(loc='center right',fontsize=9)\nax2=axes[1]\nrs=list(range(1,286))\nax2.axhspan(-14.9,14.9,color='0.88',zorder=0)\nax2.plot(rs,[ecz[r] for r in rs],color='0.3',lw=1.2)\nfor r,lab in [(235,'D235'),(265,'D265'),(238,'E238'),(242,'K242'),(165,'D165'),(262,'D262')]:\n    ax2.plot(r,ecz[r],'o',color='crimson',ms=6); ax2.annotate(lab,(r,ecz[r]),fontsize=8,xytext=(2,5),textcoords='offset points')\nax2.axhline(0,color='k',lw=0.5)\nax2.set_xlabel('E. coli CdsA residue number'); ax2.set_ylabel('z, membrane normal (\u00c5)')\nax2.set_title('Membrane depth along the sequence\\n(C-terminus L285 reaches the periplasmic side)',fontsize=11)\nplt.tight_layout(); plt.show()\njson.dump({'ecz':ecz,'core_rmsd':core}, open('/tmp/out.json','w'))\n",

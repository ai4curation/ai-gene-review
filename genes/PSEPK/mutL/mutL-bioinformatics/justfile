analysis_dir := justfile_directory()

fetch:
    uv run --project "{{analysis_dir}}" python "{{analysis_dir}}/scripts/fetch_uniprot_fasta.py" Q88DD1 Q9HUL8 Q88C31 P03018 --output-dir "{{analysis_dir}}/data"

align-mutl: fetch
    uv run --project "{{analysis_dir}}" python "{{analysis_dir}}/scripts/pairwise_identity.py" --query "{{analysis_dir}}/data/Q88DD1.fasta" --target "{{analysis_dir}}/data/Q9HUL8.fasta" --output "{{analysis_dir}}/results/mutl_pairwise_identity.tsv" --alignment-output "{{analysis_dir}}/results/mutl_pairwise_alignment.txt"

test-other-protein: fetch
    uv run --project "{{analysis_dir}}" python "{{analysis_dir}}/scripts/pairwise_identity.py" --query "{{analysis_dir}}/data/Q88C31.fasta" --target "{{analysis_dir}}/data/P03018.fasta" --output "{{analysis_dir}}/results/uvrd_smoke_test.tsv" --alignment-output "{{analysis_dir}}/results/uvrd_smoke_test_alignment.txt"

all: align-mutl test-other-protein

# Run from this directory; Python dependencies come from the enclosing repository.
prepare:
    uv run python prepare_inputs.py --target-record ../gltX-uniprot.txt --target-id Q88LF6 --references P04805 Q9XCL6 --output-dir data

align:
    mkdir -p results
    mafft --quiet data/input.fasta > results/alignment.fasta

map:
    uv run python map_reference_sites.py results/alignment.fasta P04805 98 100 125 127 --output results/P04805-site-map.tsv
    uv run python map_reference_sites.py results/alignment.fasta Q9XCL6 107 109 134 136 --output results/Q9XCL6-site-map.tsv

all: prepare align map

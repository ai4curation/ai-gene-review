# Run from this directory; uses the repository's pinned uv.lock environment.
fetch:
    cd ../../../../.. && uv run python genes/PSEPK/PP_4473/PP_4473-bioinformatics/primer-identity/fetch_source.py --manifest genes/PSEPK/PP_4473/PP_4473-bioinformatics/primer-identity/download-manifest.yaml --output genes/PSEPK/PP_4473/PP_4473-bioinformatics/primer-identity/mmc1.docx

reproduce: fetch
    cd ../../../../.. && uv run python genes/PSEPK/PP_4473/PP_4473-bioinformatics/primer-identity/analyze.py --docx genes/PSEPK/PP_4473/PP_4473-bioinformatics/primer-identity/mmc1.docx --proteins genes/PSEPK/PP_4473/PP_4473-uniprot.txt genes/PSEPK/hom/hom-uniprot.txt genes/PSEPK/PP_0664/PP_0664-uniprot.txt genes/PSEPK/thrB/thrB-uniprot.txt genes/PSEPK/thrC/thrC-uniprot.txt genes/PSEPK/PP_0662/PP_0662-uniprot.txt --output genes/PSEPK/PP_4473/PP_4473-bioinformatics/primer-identity/results.yaml --text-output genes/PSEPK/PP_4473/PP_4473-bioinformatics/primer-identity/supplement.txt

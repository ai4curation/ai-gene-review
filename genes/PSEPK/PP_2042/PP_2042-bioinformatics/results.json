  {
   "locusId": "PP_0765",
   "new_annotation": "putative adhesin (DUF1302)",
   "comment": "Similar to PA3923, which binds laminin (PMC6890786) and is involved in biofilm formation (PMC8547006), so this is probably an adhesin."
  },
  {
   "locusId": "PP_0766",
   "new_annotation": "adhesin-associated sorting protein (DUF1329)",
   "comment": "Conserved cofit with a putative adhesin (PP_0765). DUF1329 is distantly related to lolB, which inserts lipoproteins into the outer membrane. So we predict that DUF1329 is involved in sorting the adhesin to the outer membrane. "
  }

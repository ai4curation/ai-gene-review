repo := justfile_directory() / "../../../.."

all: compare other-input

# Uses the repository uv.lock, which pins Biopython 1.85.
compare:
    uv run --project {{repo}} python compare_sequences.py --reference data/Q00772.fasta --target data/P36005-uniprot.txt --target-format swiss --positions 54 55 151 152 153 171 190 192 --output results/slt2-kdx1.json --alignment results/slt2-kdx1-alignment.txt

# A different gene tests reuse; its result is not used to infer KDX1 biology.
other-input:
    uv run --project {{repo}} python compare_sequences.py --reference data/Q00772.fasta --target data/P41808.fasta --positions 54 55 151 152 153 171 190 192 --output results/slt2-smk1.json --alignment results/slt2-smk1-alignment.txt

# Optional source refresh. Existing snapshots/provenance are preserved in git.
refresh-inputs:
    mkdir -p data
    cp ../KDX1-uniprot.txt data/P36005-uniprot.txt
    curl --fail --location https://rest.uniprot.org/uniprotkb/Q00772.fasta --output data/Q00772.fasta
    curl --fail --location https://rest.uniprot.org/uniprotkb/P41808.fasta --output data/P41808.fasta

root := justfile_directory() / "../../../../.."

analyze:
    cd "{{root}}" && uv run python projects/ORPHAN_CURATED/analyze_report.py projects/ORPHAN_CURATED/reports/orphan-curated.csv --accession A2AXI2 --fetch --rerun

snapshot:

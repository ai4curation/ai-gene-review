root := justfile_directory() / "../../../../.."
analysis := "genes/POPTR/PAL/PAL-bioinformatics/reference-counterparts"

fetch-target:
    cd "{{root}}" && uv run python projects/ORPHAN_CURATED/fetch_reference_fasta.py UP000006729 --output .cache/orphan-curated/UP000006729.fasta

analyze:
    cd "{{root}}" && uv run python -m ai_gene_review.analysis.record_counterparts --query "{{analysis}}/query.fasta" --targets .cache/orphan-curated/UP000006729.fasta --target-provenance .cache/orphan-curated/UP000006729.provenance.json --output-dir "{{analysis}}"

snapshot:
    cd "{{root}}" && uv run python projects/ORPHAN_CURATED/fetch_record_evidence.py P45730 A0A2K1XD28 --proteome UP000006729 --history-versions 97 113 124 --ena L11747 --output genes/POPTR/PAL/PAL-record-evidence.yaml

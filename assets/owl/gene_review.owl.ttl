gene_review:GoCamClaimVerdictEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "GoCamClaimVerdictEnum" ;
    owl:unionOf ( <https://w3id.org/ai4curation/gene_review/GoCamClaimVerdictEnum#OK> <https://w3id.org/ai4curation/gene_review/GoCamClaimVerdictEnum#UNCERTAIN> <https://w3id.org/ai4curation/gene_review/GoCamClaimVerdictEnum#WRONG> ) ;
    skos:definition "Forensic-review verdict for a GO-CAM activity, mirroring the OK / UNCERTAIN / WRONG scale used for claim validation: does the asserted activity hold up against the cited evidence and GO-CAM best practice?" ;

gene_review:AnnotationQualifierEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "AnnotationQualifierEnum" ;
    owl:unionOf ( <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#enables> <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#contributes_to> <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#involved_in> <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#acts_upstream_of> <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#acts_upstream_of_positive_effect> <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#acts_upstream_of_negative_effect> <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#acts_upstream_of_or_within> <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#acts_upstream_of_or_within_positive_effect> <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#acts_upstream_of_or_within_negative_effect> <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#located_in> <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#is_active_in> <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#part_of> <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#colocalizes_with> ) ;
    skos:definition "GO annotation qualifiers specifying the relationship between a gene product and a GO term. These correspond to the QUALIFIER column in GAF/GPAD files and the QuickGO API." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> ;
    linkml:permissible_values <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#acts_upstream_of>,
        <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#acts_upstream_of_negative_effect>,
        <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#acts_upstream_of_or_within>,
        <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#acts_upstream_of_or_within_negative_effect>,
        <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#acts_upstream_of_or_within_positive_effect>,
        <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#acts_upstream_of_positive_effect>,
        <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#colocalizes_with>,
        <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#contributes_to>,
        <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#enables>,
        <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#involved_in>,
        <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#is_active_in>,
        <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#located_in>,
        <https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#part_of> .

gene_review:PredictionErrorTypeEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "PredictionErrorTypeEnum" ;
    owl:unionOf ( <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#FAILURE_TO_CAPTURE_LITERATURE> <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#NAMING_INCONSISTENCY> <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#MULTIPLE_FUNCTIONS> <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#CURATION_MISTAKE> <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#EXPERIMENTAL_MISTAKE> <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#PARALOG_OVERANNOTATION> <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#FREQUENCY_BIAS> <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#TRAINING_DATA_CONTAMINATION> <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#PATHWAY_CONTEXT_IGNORED> <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#IN_VITRO_NOT_IN_VIVO> <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#PSEUDOENZYME_OVERANNOTATION> <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#LOCALIZATION_DEFAULT> <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#TAXON_CONSTRAINT_VIOLATION> <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#WRONG_INPUT_SEQUENCE> <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#DOMAIN_ARCHITECTURE_MISMATCH> <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#COMPLEX_ACTIVITY_TRANSFER> ) ;
    skos:definition "Types of errors that lead to incorrect functional predictions. The first block is based on Table 1 of de Crécy-Lagard et al. 2025 (PMID:40703034); the trailing values capture additional, recurrent failure patterns observed when evaluating sequence- and LLM-based function predictors (e.g. ProtNLM2, BioReason-Pro) that Table 1 does not name explicitly." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> ;
    linkml:permissible_values <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#COMPLEX_ACTIVITY_TRANSFER>,
        <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#CURATION_MISTAKE>,
        <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#DOMAIN_ARCHITECTURE_MISMATCH>,
        <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#EXPERIMENTAL_MISTAKE>,
        <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#FAILURE_TO_CAPTURE_LITERATURE>,
        <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#FREQUENCY_BIAS>,
        <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#IN_VITRO_NOT_IN_VIVO>,
        <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#LOCALIZATION_DEFAULT>,
        <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#MULTIPLE_FUNCTIONS>,
        <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#NAMING_INCONSISTENCY>,
        <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#PARALOG_OVERANNOTATION>,
        <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#PATHWAY_CONTEXT_IGNORED>,
        <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#PSEUDOENZYME_OVERANNOTATION>,
        <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#TAXON_CONSTRAINT_VIOLATION>,
        <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#TRAINING_DATA_CONTAMINATION>,
        <https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#WRONG_INPUT_SEQUENCE> .


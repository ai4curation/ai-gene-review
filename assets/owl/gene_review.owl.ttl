    rdfs:label "OverlapEnum" ;
    owl:unionOf ( <https://w3id.org/ai4curation/gene_review/OverlapEnum#NONE> <https://w3id.org/ai4curation/gene_review/OverlapEnum#MINOR> <https://w3id.org/ai4curation/gene_review/OverlapEnum#SIGNIFICANT> <https://w3id.org/ai4curation/gene_review/OverlapEnum#COMPLETE> ) ;

        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Boolean ;
            owl:onProperty gene_review:optional ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:ModuleNode ;
            owl:onProperty gene_review:node ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:order ] ;
    skos:definition "A conjunctive part or step of a module node." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:ModuleVariantSet a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ModuleVariantSet" ;

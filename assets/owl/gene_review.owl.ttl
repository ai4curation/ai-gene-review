        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:optional ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:role ],
        [ a owl:Restriction ;

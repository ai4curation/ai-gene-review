    owl:unionOf ( <https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#MODULE> <https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#BIOLOGICAL_PROCESS> <https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#MOLECULAR_FUNCTION> <https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#METABOLIC_PATHWAY> <https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#SIGNALING_PATHWAY> <https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#DEVELOPMENTAL_PROCESS> <https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#CELLULAR_COMPONENT> <https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#ORGANELLE_LIFECYCLE> <https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#PROTEIN_COMPLEX> <https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#REACTION> <https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#TRANSPORT_STEP> <https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#REGULATORY_STEP> ) ;
    skos:definition "Broad type of biological module node." ;

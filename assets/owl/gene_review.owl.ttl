        linkml:EnumDefinition ;
    rdfs:label "ConformanceStatusEnum" ;
    owl:unionOf ( <https://w3id.org/ai4curation/gene_review/ConformanceStatusEnum#EXACT> <https://w3id.org/ai4curation/gene_review/ConformanceStatusEnum#WITH_DEVIATIONS> <https://w3id.org/ai4curation/gene_review/ConformanceStatusEnum#EXTENDS> ) ;

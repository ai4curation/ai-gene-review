<https://w3id.org/ai4curation/gene_review/ActionEnum#ACCEPT> a owl:Class,
        gene_review:ActionEnum ;
    rdfs:label "ACCEPT" ;
    rdfs:subClassOf gene_review:ActionEnum ;
    skos:definition "Accept the existing annotation as-is, no modifications, and retain as representing the core function of the gene" .

<https://w3id.org/ai4curation/gene_review/ActionEnum#KEEP_AS_NON_CORE> a owl:Class,
        gene_review:ActionEnum ;
    rdfs:label "KEEP_AS_NON_CORE" ;
    rdfs:subClassOf gene_review:ActionEnum ;
    skos:definition "Keep the existing annotation as-is, but mark it as non-core. For pleiotropic genes, this may be the developmental processes, or other processes that are not the core function of the gene." .

<https://w3id.org/ai4curation/gene_review/ActionEnum#MARK_AS_OVER_ANNOTATED> a owl:Class,
        gene_review:ActionEnum ;
    rdfs:label "MARK_AS_OVER_ANNOTATED" ;
    rdfs:subClassOf gene_review:ActionEnum ;
    skos:definition "The term is not entirely wrong, but likely represents an over-annotation of the gene" .

<https://w3id.org/ai4curation/gene_review/ActionEnum#MODIFY> a owl:Class,
        gene_review:ActionEnum ;
    rdfs:label "MODIFY" ;
    rdfs:subClassOf gene_review:ActionEnum ;
    skos:definition "The essence of the annotation is sound, but there are better terms to use (use in combination with proposed_replacement_terms). if the term is too general, then MODIFY should be used, with a proposed replacement term for the correct specific function. sometimes terms can also be overly specific and contorted, so in some cases you might want to generalize" .

<https://w3id.org/ai4curation/gene_review/ActionEnum#NEW> a owl:Class,
        gene_review:ActionEnum ;
    rdfs:label "NEW" ;
    rdfs:subClassOf gene_review:ActionEnum ;
    skos:definition "This is a proposed annotation, not one that exists in the existing GO annotations. Use this to propose a new annotation not covered by the existing GO annotations. Use this conservatively, do not over-annotate, especially for biological process. Do not use for indirect or pleiotropic effects. Be sure you have good evidence, this can be from multiple sources." .

<https://w3id.org/ai4curation/gene_review/ActionEnum#PENDING> a owl:Class,
        gene_review:ActionEnum ;
    rdfs:label "PENDING" ;
    rdfs:subClassOf gene_review:ActionEnum ;
    skos:definition "The review entry is a stub, and the review has not been completed yet." .

<https://w3id.org/ai4curation/gene_review/ActionEnum#REMOVE> a owl:Class,
        gene_review:ActionEnum ;
    rdfs:label "REMOVE" ;
    rdfs:subClassOf gene_review:ActionEnum ;
    skos:definition "Remove the existing annotation, as it is unlikely to be correct based on combined evidence" .

<https://w3id.org/ai4curation/gene_review/ActionEnum#UNDECIDED> a owl:Class,
        gene_review:ActionEnum ;
    rdfs:label "UNDECIDED" ;
    rdfs:subClassOf gene_review:ActionEnum ;
    skos:definition "The annotation is not clear, and the reviewer is not sure what to do with it. ALWAYS USE THIS IF YOU ARE UNABLE TO ACCESS RELEVANT PUBLICATIONS" .

gene_review:AlternativeProduct a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "AlternativeProduct" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:sequence_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:sequence_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:sequence_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:id ] ;
    skos:definition "An alternative splicing product (isoform) of the gene. Corresponds to UniProt isoform entries. Use this to document isoform-specific functions where different isoforms have distinct or even antagonistic biological activities. DEPRECATED: Use FunctionalIsoform instead for curated functional classes." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:AnnotationExtension a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "AnnotationExtension" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:term ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:term ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Term ;
            owl:onProperty gene_review:term ] ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

<https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#acts_upstream_of> a owl:Class,
        gene_review:AnnotationQualifierEnum ;
    rdfs:label "acts_upstream_of" ;
    rdfs:subClassOf gene_review:AnnotationQualifierEnum ;
    skos:definition "The gene product acts upstream of or within a biological process (BP qualifier)." .

<https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#acts_upstream_of_negative_effect> a owl:Class,
        gene_review:AnnotationQualifierEnum ;
    rdfs:label "acts_upstream_of_negative_effect" ;
    rdfs:subClassOf gene_review:AnnotationQualifierEnum ;
    skos:definition "Acts upstream of or within, negative effect (BP qualifier)." .

<https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#acts_upstream_of_or_within> a owl:Class,
        gene_review:AnnotationQualifierEnum ;
    rdfs:label "acts_upstream_of_or_within" ;
    rdfs:subClassOf gene_review:AnnotationQualifierEnum ;
    skos:definition "Acts upstream of or within a biological process (BP qualifier)." .

<https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#acts_upstream_of_or_within_negative_effect> a owl:Class,
        gene_review:AnnotationQualifierEnum ;
    rdfs:label "acts_upstream_of_or_within_negative_effect" ;
    rdfs:subClassOf gene_review:AnnotationQualifierEnum ;
    skos:definition "Acts upstream of or within, negative effect (BP qualifier)." .

<https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#acts_upstream_of_or_within_positive_effect> a owl:Class,
        gene_review:AnnotationQualifierEnum ;
    rdfs:label "acts_upstream_of_or_within_positive_effect" ;
    rdfs:subClassOf gene_review:AnnotationQualifierEnum ;
    skos:definition "Acts upstream of or within, positive effect (BP qualifier)." .

<https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#acts_upstream_of_positive_effect> a owl:Class,
        gene_review:AnnotationQualifierEnum ;
    rdfs:label "acts_upstream_of_positive_effect" ;
    rdfs:subClassOf gene_review:AnnotationQualifierEnum ;
    skos:definition "Acts upstream of or within, positive effect (BP qualifier)." .

<https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#colocalizes_with> a owl:Class,
        gene_review:AnnotationQualifierEnum ;
    rdfs:label "colocalizes_with" ;
    rdfs:subClassOf gene_review:AnnotationQualifierEnum ;
    skos:definition "The gene product colocalizes with a cellular component (CC qualifier). Weaker than located_in or part_of." .

<https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#contributes_to> a owl:Class,
        gene_review:AnnotationQualifierEnum ;
    rdfs:label "contributes_to" ;
    rdfs:subClassOf gene_review:AnnotationQualifierEnum ;
    skos:definition "The gene product contributes to a molecular function as part of a complex (MF qualifier). The gene product does not independently have this activity but is required for the complex to have it. Typical for accessory/structural subunits of multi-protein complexes (e.g., accessory subunit of NADH dehydrogenase)." .

<https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#enables> a owl:Class,
        gene_review:AnnotationQualifierEnum ;
    rdfs:label "enables" ;
    rdfs:subClassOf gene_review:AnnotationQualifierEnum ;
    skos:definition "The gene product has the molecular function activity (MF qualifier). The gene product independently possesses this catalytic or binding activity." .

<https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#involved_in> a owl:Class,
        gene_review:AnnotationQualifierEnum ;
    rdfs:label "involved_in" ;
    rdfs:subClassOf gene_review:AnnotationQualifierEnum ;
    skos:definition "The gene product is involved in a biological process (BP qualifier)." .

<https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#is_active_in> a owl:Class,
        gene_review:AnnotationQualifierEnum ;
    rdfs:label "is_active_in" ;
    rdfs:subClassOf gene_review:AnnotationQualifierEnum ;
    skos:definition "The gene product is active in a cellular component (CC qualifier). Stronger than located_in -- implies the gene product carries out its molecular function in this location." .

<https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#located_in> a owl:Class,
        gene_review:AnnotationQualifierEnum ;
    rdfs:label "located_in" ;
    rdfs:subClassOf gene_review:AnnotationQualifierEnum ;
    skos:definition "The gene product is located in a cellular component (CC qualifier)." .

<https://w3id.org/ai4curation/gene_review/AnnotationQualifierEnum#part_of> a owl:Class,
        gene_review:AnnotationQualifierEnum ;
    rdfs:label "part_of" ;
    rdfs:subClassOf gene_review:AnnotationQualifierEnum ;
    skos:definition "The gene product is part of a cellular component, typically a complex (CC qualifier)." .

<https://w3id.org/ai4curation/gene_review/ChainingStatusEnum#KNOWLEDGE_GAP> a owl:Class,
        gene_review:ChainingStatusEnum ;
    rdfs:label "KNOWLEDGE_GAP" ;
    rdfs:subClassOf gene_review:ChainingStatusEnum ;
    skos:definition "The connecting intermediate or enzyme is genuinely not known; the break reflects missing biological knowledge, not a modelling error." .

<https://w3id.org/ai4curation/gene_review/ChainingStatusEnum#MAPPING_GAP> a owl:Class,
        gene_review:ChainingStatusEnum ;
    rdfs:label "MAPPING_GAP" ;
    rdfs:subClassOf gene_review:ChainingStatusEnum ;
    skos:definition "The chemistry is known but the GO/RHEA (or GO/ChEBI) mapping does not yet capture the link, so the automated check cannot see the continuity." .

<https://w3id.org/ai4curation/gene_review/ChainingStatusEnum#NOT_APPLICABLE> a owl:Class,
        gene_review:ChainingStatusEnum ;
    rdfs:label "NOT_APPLICABLE" ;
    rdfs:subClassOf gene_review:ChainingStatusEnum ;
    skos:definition "Chaining does not apply to this connection (e.g. a regulatory or non-metabolic edge, or a spiral re-entry handled elsewhere)." .

<https://w3id.org/ai4curation/gene_review/ChainingStatusEnum#UNVERIFIED> a owl:Class,
        gene_review:ChainingStatusEnum ;
    rdfs:label "UNVERIFIED" ;
    rdfs:subClassOf gene_review:ChainingStatusEnum ;
    skos:definition "Continuity has not been assessed (explicitly, as opposed to simply leaving the field unset)." .

<https://w3id.org/ai4curation/gene_review/ChainingStatusEnum#VERIFIED> a owl:Class,
        gene_review:ChainingStatusEnum ;
    rdfs:label "VERIFIED" ;
    rdfs:subClassOf gene_review:ChainingStatusEnum ;
    skos:definition "The upstream product is confirmed to be the downstream substrate (curator-confirmed continuity)." .

<https://w3id.org/ai4curation/gene_review/ConditionTypeEnum#FUNFAM> a owl:Class,
        gene_review:ConditionTypeEnum ;
    rdfs:label "FUNFAM" ;
    rdfs:subClassOf gene_review:ConditionTypeEnum ;
    skos:definition "CATH FunFam functional family" .

<https://w3id.org/ai4curation/gene_review/ConditionTypeEnum#INTERPRO> a owl:Class,
        gene_review:ConditionTypeEnum ;
    rdfs:label "INTERPRO" ;
    rdfs:subClassOf gene_review:ConditionTypeEnum ;
    skos:definition "InterPro domain/family" .

<https://w3id.org/ai4curation/gene_review/ConditionTypeEnum#OTHER> a owl:Class,
        gene_review:ConditionTypeEnum ;
    rdfs:label "OTHER" ;
    rdfs:subClassOf gene_review:ConditionTypeEnum ;
    skos:definition "Other condition type" .

<https://w3id.org/ai4curation/gene_review/ConditionTypeEnum#PANTHER> a owl:Class,
        gene_review:ConditionTypeEnum ;
    rdfs:label "PANTHER" ;
    rdfs:subClassOf gene_review:ConditionTypeEnum ;
    skos:definition "PANTHER family" .

<https://w3id.org/ai4curation/gene_review/ConditionTypeEnum#PFAM> a owl:Class,
        gene_review:ConditionTypeEnum ;
    rdfs:label "PFAM" ;
    rdfs:subClassOf gene_review:ConditionTypeEnum ;
    skos:definition "Pfam domain" .

<https://w3id.org/ai4curation/gene_review/ConditionTypeEnum#SEQUENCE_LENGTH> a owl:Class,
        gene_review:ConditionTypeEnum ;
    rdfs:label "SEQUENCE_LENGTH" ;
    rdfs:subClassOf gene_review:ConditionTypeEnum ;
    skos:definition "Sequence length constraint" .

<https://w3id.org/ai4curation/gene_review/ConditionTypeEnum#TAXON> a owl:Class,
        gene_review:ConditionTypeEnum ;
    rdfs:label "TAXON" ;
    rdfs:subClassOf gene_review:ConditionTypeEnum ;
    skos:definition "Taxonomic constraint" .

<https://w3id.org/ai4curation/gene_review/ConformanceStatusEnum#EXACT> a owl:Class,
        gene_review:ConformanceStatusEnum ;
    rdfs:label "EXACT" ;
    rdfs:subClassOf gene_review:ConformanceStatusEnum ;
    skos:definition "The node matches the template motif exactly: same steps, function terms, and connection topology, with no recorded deviations." .

<https://w3id.org/ai4curation/gene_review/ConformanceStatusEnum#EXTENDS> a owl:Class,
        gene_review:ConformanceStatusEnum ;
    rdfs:label "EXTENDS" ;
    rdfs:subClassOf gene_review:ConformanceStatusEnum ;
    skos:definition "The node contains the full template motif and adds further steps or structure beyond it." .

<https://w3id.org/ai4curation/gene_review/ConformanceStatusEnum#WITH_DEVIATIONS> a owl:Class,
        gene_review:ConformanceStatusEnum ;
    rdfs:label "WITH_DEVIATIONS" ;
    rdfs:subClassOf gene_review:ConformanceStatusEnum ;
    skos:definition "The node matches the template motif apart from the differences listed in deviations (e.g. a merged or missing tier, a substituted term)." .

gene_review:CoreFunction a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "CoreFunction" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:knowledge_gaps ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:molecular_function ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:KnowledgeGap ;
            owl:onProperty gene_review:knowledge_gaps ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:directly_involved_in ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Term ;
            owl:onProperty gene_review:locations ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Term ;
            owl:onProperty gene_review:contributes_to_molecular_function ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Term ;
            owl:onProperty gene_review:anatomical_locations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:in_complex ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:substrates ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:SupportingTextInReference ;
            owl:onProperty gene_review:supported_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:molecular_function ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Term ;
            owl:onProperty gene_review:substrates ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Term ;
            owl:onProperty gene_review:molecular_function ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Term ;
            owl:onProperty gene_review:directly_involved_in ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:locations ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Term ;
            owl:onProperty gene_review:in_complex ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:anatomical_locations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:contributes_to_molecular_function ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:contributes_to_molecular_function ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:supported_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:in_complex ] ;
    skos:definition "A core function is a GO-CAM-like annotation of the core evolved functions of a gene. This is a synthesis of the reviewed core annotations, brought together into a unified GO-CAM-like representation." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:DomainDescriptor a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "DomainDescriptor" ;
    rdfs:subClassOf gene_review:Descriptor ;
    skos:definition "A descriptor for a protein domain, motif, site, or architectural feature." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

<https://w3id.org/ai4curation/gene_review/EntryRelationshipEnum#EQUIV> a owl:Class,
        gene_review:EntryRelationshipEnum ;
    rdfs:label "EQUIV" ;
    rdfs:subClassOf gene_review:EntryRelationshipEnum ;
    skos:definition "This entry is equivalent to the target (bidirectional high similarity). Selected when jaccard_boosted (jaccard + 0.05) is highest among {jaccard+0.05, containment_a_in_b, containment_b_in_a}." .

<https://w3id.org/ai4curation/gene_review/EntryRelationshipEnum#PREDICTED_BY> a owl:Class,
        gene_review:EntryRelationshipEnum ;
    rdfs:label "PREDICTED_BY" ;
    rdfs:subClassOf gene_review:EntryRelationshipEnum ;
    skos:definition "This entry is predicted by the target (target ⊆ this). Selected when containment_b_in_a is highest among {jaccard+0.05, containment_a_in_b, containment_b_in_a}." .

<https://w3id.org/ai4curation/gene_review/EntryRelationshipEnum#PREDICTS> a owl:Class,
        gene_review:EntryRelationshipEnum ;
    rdfs:label "PREDICTS" ;
    rdfs:subClassOf gene_review:EntryRelationshipEnum ;
    skos:definition "This entry predicts the target (this ⊆ target). Selected when containment_a_in_b is highest among {jaccard+0.05, containment_a_in_b, containment_b_in_a}." .

<https://w3id.org/ai4curation/gene_review/EntryTypeEnum#FUNFAM> a owl:Class,
        gene_review:EntryTypeEnum ;
    rdfs:label "FUNFAM" ;
    rdfs:subClassOf gene_review:EntryTypeEnum ;
    skos:definition "CATH FunFam (functional family from CATH database)" .

<https://w3id.org/ai4curation/gene_review/EntryTypeEnum#GO_TERM> a owl:Class,
        gene_review:EntryTypeEnum ;
    rdfs:label "GO_TERM" ;
    rdfs:subClassOf gene_review:EntryTypeEnum ;
    skos:definition "Gene Ontology term (annotation target)" .

<https://w3id.org/ai4curation/gene_review/EntryTypeEnum#INTERPRO> a owl:Class,
        gene_review:EntryTypeEnum ;
    rdfs:label "INTERPRO" ;
    rdfs:subClassOf gene_review:EntryTypeEnum ;
    skos:definition "InterPro entry (domain, family, repeat, etc.)" .

<https://w3id.org/ai4curation/gene_review/EntryTypeEnum#PANTHER> a owl:Class,
        gene_review:EntryTypeEnum ;
    rdfs:label "PANTHER" ;
    rdfs:subClassOf gene_review:EntryTypeEnum ;
    skos:definition "PANTHER family or subfamily" .

gene_review:ExistingAnnotation a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ExistingAnnotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:retired ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Boolean ;
            owl:onProperty gene_review:negated ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:extensions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:supporting_entities ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:AnnotationExtension ;
            owl:onProperty gene_review:extensions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:review ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:isoform ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:isoform ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Reference ;
            owl:onProperty gene_review:original_reference_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:original_reference_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:retired ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:negated ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:review ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Boolean ;
            owl:onProperty gene_review:retired ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:term ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:supporting_entities ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Term ;
            owl:onProperty gene_review:term ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Review ;
            owl:onProperty gene_review:review ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:isoform ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:EvidenceType ;
            owl:onProperty gene_review:evidence_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:qualifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:qualifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:term ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:evidence_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:AnnotationQualifierEnum ;
            owl:onProperty gene_review:qualifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:negated ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:original_reference_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:evidence_type ] ;
    skos:definition "An existing annotation from the GO database, plus a review of the annotation." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:Experiment a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Experiment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:hypothesis ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:hypothesis ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:experiment_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:experiment_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:experiment_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:hypothesis ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:description ] ;
    skos:definition "A suggested experiment to answer a question about the gene" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:Finding a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Finding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:statement ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Boolean ;
            owl:onProperty gene_review:full_text_unavailable ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:full_text_unavailable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:full_text_unavailable ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:supporting_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:reference_section_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:finding_review ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:supporting_text ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:reference_section_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:FindingReview ;
            owl:onProperty gene_review:finding_review ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:ManuscriptSection ;
            owl:onProperty gene_review:reference_section_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:statement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:supporting_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:statement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:finding_review ] ;
    skos:definition "A finding is a statement about a gene, which is supported by a reference. Similar to \"comments\" in uniprot" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:FindingReview a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "FindingReview" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:review_notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:FindingReviewStatusEnum ;
            owl:onProperty gene_review:finding_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:superseded_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:finding_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:finding_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:review_notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Reference ;
            owl:onProperty gene_review:superseded_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:review_notes ] ;
    skos:definition "Manual reviewer assessment of a specific finding within a reference - in particular whether it remains current, is disputed, or has been overturned/superseded by later evidence. This is finer-grained than reference_review (which assesses the whole reference); a paper may contain some findings that stand and others that are overturned. All fields optional and reviewer-supplied." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

<https://w3id.org/ai4curation/gene_review/FindingReviewStatusEnum#CORROBORATED> a owl:Class,
        gene_review:FindingReviewStatusEnum ;
    rdfs:label "CORROBORATED" ;
    rdfs:subClassOf gene_review:FindingReviewStatusEnum ;
    skos:definition "The finding is independently supported by additional evidence" .

<https://w3id.org/ai4curation/gene_review/FindingReviewStatusEnum#CURRENT> a owl:Class,
        gene_review:FindingReviewStatusEnum ;
    rdfs:label "CURRENT" ;
    rdfs:subClassOf gene_review:FindingReviewStatusEnum ;
    skos:definition "The finding is consistent with the body of evidence and can be curated from" .

<https://w3id.org/ai4curation/gene_review/FindingReviewStatusEnum#DISPUTED> a owl:Class,
        gene_review:FindingReviewStatusEnum ;
    rdfs:label "DISPUTED" ;
    rdfs:subClassOf gene_review:FindingReviewStatusEnum ;
    skos:definition "The finding is contested or contradicted by other evidence, but not definitively refuted; curate with caution" .

<https://w3id.org/ai4curation/gene_review/FindingReviewStatusEnum#OVERTURNED> a owl:Class,
        gene_review:FindingReviewStatusEnum ;
    rdfs:label "OVERTURNED" ;
    rdfs:subClassOf gene_review:FindingReviewStatusEnum ;
    skos:definition "The finding has been refuted or superseded by later, stronger evidence and should NOT be curated from; record the overturning reference(s) in superseded_by" .

<https://w3id.org/ai4curation/gene_review/FindingReviewStatusEnum#UNVERIFIED> a owl:Class,
        gene_review:FindingReviewStatusEnum ;
    rdfs:label "UNVERIFIED" ;
    rdfs:subClassOf gene_review:FindingReviewStatusEnum ;
    skos:definition "The finding has not yet been manually assessed (default)" .

gene_review:FunctionalIsoform a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "FunctionalIsoform" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gene_review:FunctionalIsoformMapping ;
            owl:onProperty gene_review:maps_to ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Term ;
            owl:onProperty gene_review:isoform_specific_terms ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:FunctionalIsoformTypeEnum ;
            owl:onProperty gene_review:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:maps_to ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:isoform_specific_terms ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:name ] ;
    skos:definition "A curated functional isoform class. Unlike AlternativeProduct (which maps 1:1 to UniProt isoforms), this captures FUNCTIONALLY RELEVANT distinctions that may: - Group multiple UniProt isoforms into a functional class (e.g., WT1 +KTS isoforms) - Represent cleavage products from polyproteins (e.g., POMC peptides) - Describe modification states or conformational variants Only create entries when there ARE functionally distinct forms worth documenting." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

<https://w3id.org/ai4curation/gene_review/FunctionalIsoformMappingTypeEnum#UNIPROT_CHAIN> a owl:Class,
        gene_review:FunctionalIsoformMappingTypeEnum ;
    rdfs:label "UNIPROT_CHAIN" ;
    rdfs:subClassOf gene_review:FunctionalIsoformMappingTypeEnum ;
    skos:definition "UniProt chain/peptide ID from FT PEPTIDE (e.g., PRO_0000024969)" .

<https://w3id.org/ai4curation/gene_review/FunctionalIsoformMappingTypeEnum#UNIPROT_ISOFORM> a owl:Class,
        gene_review:FunctionalIsoformMappingTypeEnum ;
    rdfs:label "UNIPROT_ISOFORM" ;
    rdfs:subClassOf gene_review:FunctionalIsoformMappingTypeEnum ;
    skos:definition "UniProt isoform ID (e.g., P19544-1, Q07817-2)" .

<https://w3id.org/ai4curation/gene_review/FunctionalIsoformTypeEnum#CLEAVAGE_PRODUCT> a owl:Class,
        gene_review:FunctionalIsoformTypeEnum ;
    rdfs:label "CLEAVAGE_PRODUCT" ;
    rdfs:subClassOf gene_review:FunctionalIsoformTypeEnum ;
    skos:definition "Post-translational proteolytic cleavage produces distinct peptides. Maps to UniProt chain IDs (PRO_NNNNNNN from FT PEPTIDE lines). Example: POMC cleavage into ACTH, alpha-MSH, beta-endorphin." .

<https://w3id.org/ai4curation/gene_review/FunctionalIsoformTypeEnum#CONFORMATIONAL_STATE> a owl:Class,
        gene_review:FunctionalIsoformTypeEnum ;
    rdfs:label "CONFORMATIONAL_STATE" ;
    rdfs:subClassOf gene_review:FunctionalIsoformTypeEnum ;
    skos:definition "Different conformational states with distinct functions. Example: GTP-bound vs GDP-bound forms of GTPases." .

<https://w3id.org/ai4curation/gene_review/FunctionalIsoformTypeEnum#MODIFICATION_STATE> a owl:Class,
        gene_review:FunctionalIsoformTypeEnum ;
    rdfs:label "MODIFICATION_STATE" ;
    rdfs:subClassOf gene_review:FunctionalIsoformTypeEnum ;
    skos:definition "Post-translational modification creates functionally distinct forms. Example: Phosphorylated vs unphosphorylated forms with different activities." .

<https://w3id.org/ai4curation/gene_review/FunctionalIsoformTypeEnum#SPLICE_CLASS> a owl:Class,
        gene_review:FunctionalIsoformTypeEnum ;
    rdfs:label "SPLICE_CLASS" ;
    rdfs:subClassOf gene_review:FunctionalIsoformTypeEnum ;
    skos:definition "A class of splice variants that share functional properties. Groups multiple UniProt isoform IDs that have similar functions. Example: WT1 +KTS isoforms (multiple UniProt IDs) vs -KTS isoforms." .

<https://w3id.org/ai4curation/gene_review/FunctionalIsoformTypeEnum#SPLICE_VARIANT> a owl:Class,
        gene_review:FunctionalIsoformTypeEnum ;
    rdfs:label "SPLICE_VARIANT" ;
    rdfs:subClassOf gene_review:FunctionalIsoformTypeEnum ;
    skos:definition "Alternative splicing produces functionally distinct isoforms. Maps to one or more UniProt isoform IDs (e.g., P19544-1, P19544-2)." .

gene_review:GeneProductDescriptor a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "GeneProductDescriptor" ;
    rdfs:subClassOf gene_review:Descriptor ;
    skos:definition "A descriptor for a gene product, protein, isoform, or gene-product form." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

<https://w3id.org/ai4curation/gene_review/GeneReviewStatusEnum#COMPLETE> a owl:Class,
        gene_review:GeneReviewStatusEnum ;
    rdfs:label "COMPLETE" ;
    rdfs:subClassOf gene_review:GeneReviewStatusEnum ;
    skos:definition "No PENDING annotations and no validation warnings - review is fully complete and validated" .

<https://w3id.org/ai4curation/gene_review/GeneReviewStatusEnum#DRAFT> a owl:Class,
        gene_review:GeneReviewStatusEnum ;
    rdfs:label "DRAFT" ;
    rdfs:subClassOf gene_review:GeneReviewStatusEnum ;
    skos:definition "No PENDING annotations, but may have validation warnings - review is complete but needs refinement" .

<https://w3id.org/ai4curation/gene_review/GeneReviewStatusEnum#INITIALIZED> a owl:Class,
        gene_review:GeneReviewStatusEnum ;
    rdfs:label "INITIALIZED" ;
    rdfs:subClassOf gene_review:GeneReviewStatusEnum ;
    skos:definition "All annotations have action PENDING - review has been initialized but not started" .

<https://w3id.org/ai4curation/gene_review/GeneReviewStatusEnum#IN_PROGRESS> a owl:Class,
        gene_review:GeneReviewStatusEnum ;
    rdfs:label "IN_PROGRESS" ;
    rdfs:subClassOf gene_review:GeneReviewStatusEnum ;
    skos:definition "At least one annotation is PENDING and at least one annotation is not PENDING - review is underway" .

gene_review:GoCamAssociation a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "GoCamAssociation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:activity ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:model ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:activity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:activity ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:EvidenceItem ;
            owl:onProperty gene_review:evidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:title ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:model ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:model ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:notes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:evidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:notes ] ;
    skos:definition "A reference from a module element to a production GO-CAM (Gene Ontology Causal Activity Model), optionally pinned to a specific activity (annoton) within that model. The referenced model is expected to be cached under gocams/<model_id>/<model_id>-src.yaml." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

<https://w3id.org/ai4curation/gene_review/GoCamClaimVerdictEnum#OK> a owl:Class,
        gene_review:GoCamClaimVerdictEnum ;
    rdfs:label "OK" ;
    rdfs:subClassOf gene_review:GoCamClaimVerdictEnum ;
    skos:definition "The activity is well supported and follows best practice (correct MF specificity, correct causal/has-input usage, adequate evidence)." .

<https://w3id.org/ai4curation/gene_review/GoCamClaimVerdictEnum#UNCERTAIN> a owl:Class,
        gene_review:GoCamClaimVerdictEnum ;
    rdfs:label "UNCERTAIN" ;
    rdfs:subClassOf gene_review:GoCamClaimVerdictEnum ;
    skos:definition "Defensible but imprecise or under-supported; a minor best-practice or evidence issue that needs qualification." .

<https://w3id.org/ai4curation/gene_review/GoCamClaimVerdictEnum#WRONG> a owl:Class,
        gene_review:GoCamClaimVerdictEnum ;
    rdfs:label "WRONG" ;
    rdfs:subClassOf gene_review:GoCamClaimVerdictEnum ;
    skos:definition "The activity contradicts the evidence or violates a hard best-practice rule (e.g. binding-as-function, wrong causal directionality)." .

<https://w3id.org/ai4curation/gene_review/GoCamConsistencyEnum#CONFLICT> a owl:Class,
        gene_review:GoCamConsistencyEnum ;
    rdfs:label "CONFLICT" ;
    rdfs:subClassOf gene_review:GoCamConsistencyEnum ;
    skos:definition "The activity asserts a function the gene review removed, negated, or marked as over-annotated." .

<https://w3id.org/ai4curation/gene_review/GoCamConsistencyEnum#CONSISTENT> a owl:Class,
        gene_review:GoCamConsistencyEnum ;
    rdfs:label "CONSISTENT" ;
    rdfs:subClassOf gene_review:GoCamConsistencyEnum ;
    skos:definition "The activity's function matches an accepted core function in the gene review." .

<https://w3id.org/ai4curation/gene_review/GoCamConsistencyEnum#MORE_GENERAL> a owl:Class,
        gene_review:GoCamConsistencyEnum ;
    rdfs:label "MORE_GENERAL" ;
    rdfs:subClassOf gene_review:GoCamConsistencyEnum ;
    skos:definition "The activity asserts a more general function than the gene review." .

<https://w3id.org/ai4curation/gene_review/GoCamConsistencyEnum#MORE_SPECIFIC> a owl:Class,
        gene_review:GoCamConsistencyEnum ;
    rdfs:label "MORE_SPECIFIC" ;
    rdfs:subClassOf gene_review:GoCamConsistencyEnum ;
    skos:definition "The activity asserts a more specific function than the gene review." .

<https://w3id.org/ai4curation/gene_review/GoCamConsistencyEnum#NOT_IN_REVIEW> a owl:Class,
        gene_review:GoCamConsistencyEnum ;
    rdfs:label "NOT_IN_REVIEW" ;
    rdfs:subClassOf gene_review:GoCamConsistencyEnum ;
    skos:definition "The function is not represented in the gene review (candidate gap)." .

<https://w3id.org/ai4curation/gene_review/GoCamConsistencyEnum#NO_GENE_REVIEW> a owl:Class,
        gene_review:GoCamConsistencyEnum ;
    rdfs:label "NO_GENE_REVIEW" ;
    rdfs:subClassOf gene_review:GoCamConsistencyEnum ;
    skos:definition "No gene review exists yet for this gene product." .

<https://w3id.org/ai4curation/gene_review/GoCamConsistencyEnum#RELATED> a owl:Class,
        gene_review:GoCamConsistencyEnum ;
    rdfs:label "RELATED" ;
    rdfs:subClassOf gene_review:GoCamConsistencyEnum ;
    skos:definition "Same general area but neither a clean subsumption nor a match." .

<https://w3id.org/ai4curation/gene_review/GoCamQcFlagEnum#BINDING_AS_FUNCTION> a owl:Class,
        gene_review:GoCamQcFlagEnum ;
    rdfs:label "BINDING_AS_FUNCTION" ;
    rdfs:subClassOf gene_review:GoCamQcFlagEnum ;
    skos:definition "Molecular function is a bare 'binding' term with no functional consequence specified (use catalytic/receptor/adaptor/sequestering MF)." .

<https://w3id.org/ai4curation/gene_review/GoCamQcFlagEnum#COMPLEX_SUBUNIT_REPRESENTATION> a owl:Class,
        gene_review:GoCamQcFlagEnum ;
    rdfs:label "COMPLEX_SUBUNIT_REPRESENTATION" ;
    rdfs:subClassOf gene_review:GoCamQcFlagEnum ;
    skos:definition "Complex represented with a complex term where a specific active subunit is known (or vice versa)." .

<https://w3id.org/ai4curation/gene_review/GoCamQcFlagEnum#DIRECT_VS_INDIRECT_CAUSAL> a owl:Class,
        gene_review:GoCamQcFlagEnum ;
    rdfs:label "DIRECT_VS_INDIRECT_CAUSAL" ;
    rdfs:subClassOf gene_review:GoCamQcFlagEnum ;
    skos:definition "Direct regulation asserted for a multi-step (indirect) mechanism, or vice versa." .

<https://w3id.org/ai4curation/gene_review/GoCamQcFlagEnum#GENERIC_MF> a owl:Class,
        gene_review:GoCamQcFlagEnum ;
    rdfs:label "GENERIC_MF" ;
    rdfs:subClassOf gene_review:GoCamQcFlagEnum ;
    skos:definition "An overly generic MF term is used where a specific child term applies." .

<https://w3id.org/ai4curation/gene_review/GoCamQcFlagEnum#HAS_INPUT_MISUSE> a owl:Class,
        gene_review:GoCamQcFlagEnum ;
    rdfs:label "HAS_INPUT_MISUSE" ;
    rdfs:subClassOf gene_review:GoCamQcFlagEnum ;
    skos:definition "'has input' used incorrectly, e.g. a receptor's ligand or a TF's DNA instead of the substrate/target gene/downstream effector." .

<https://w3id.org/ai4curation/gene_review/GoCamQcFlagEnum#INCORRECT_DIRECTIONALITY> a owl:Class,
        gene_review:GoCamQcFlagEnum ;
    rdfs:label "INCORRECT_DIRECTIONALITY" ;
    rdfs:subClassOf gene_review:GoCamQcFlagEnum ;
    skos:definition "Causal edge directionality (subject -> object) appears reversed." .

<https://w3id.org/ai4curation/gene_review/GoCamQcFlagEnum#MISSING_EVIDENCE> a owl:Class,
        gene_review:GoCamQcFlagEnum ;
    rdfs:label "MISSING_EVIDENCE" ;
    rdfs:subClassOf gene_review:GoCamQcFlagEnum ;
    skos:definition "An activity or relationship lacks an evidence code / reference." .

<https://w3id.org/ai4curation/gene_review/GoCamQcFlagEnum#MISSING_LOCATION> a owl:Class,
        gene_review:GoCamQcFlagEnum ;
    rdfs:label "MISSING_LOCATION" ;
    rdfs:subClassOf gene_review:GoCamQcFlagEnum ;
    skos:definition "Activity lacks an 'occurs in' cellular component." .

<https://w3id.org/ai4curation/gene_review/GoCamQcFlagEnum#MISSING_PROCESS> a owl:Class,
        gene_review:GoCamQcFlagEnum ;
    rdfs:label "MISSING_PROCESS" ;
    rdfs:subClassOf gene_review:GoCamQcFlagEnum ;
    skos:definition "Activity is not connected to a biological process via 'part of'." .

<https://w3id.org/ai4curation/gene_review/GoCamQcFlagEnum#ORPHAN_ACTIVITY> a owl:Class,
        gene_review:GoCamQcFlagEnum ;
    rdfs:label "ORPHAN_ACTIVITY" ;
    rdfs:subClassOf gene_review:GoCamQcFlagEnum ;
    skos:definition "Activity has no causal connections to the rest of the model." .

<https://w3id.org/ai4curation/gene_review/GoCamReviewStatusEnum#COMPLETE> a owl:Class,
        gene_review:GoCamReviewStatusEnum ;
    rdfs:label "COMPLETE" ;
    rdfs:subClassOf gene_review:GoCamReviewStatusEnum ;
    skos:definition "All activities reviewed." .

<https://w3id.org/ai4curation/gene_review/GoCamReviewStatusEnum#DRAFT> a owl:Class,
        gene_review:GoCamReviewStatusEnum ;
    rdfs:label "DRAFT" ;
    rdfs:subClassOf gene_review:GoCamReviewStatusEnum ;
    skos:definition "Review started; activities not yet fully assessed." .

<https://w3id.org/ai4curation/gene_review/GoCamReviewStatusEnum#IN_PROGRESS> a owl:Class,
        gene_review:GoCamReviewStatusEnum ;
    rdfs:label "IN_PROGRESS" ;
    rdfs:subClassOf gene_review:GoCamReviewStatusEnum ;
    skos:definition "Some activities reviewed; review ongoing." .

<https://w3id.org/ai4curation/gene_review/InterProTypeEnum#ACTIVE_SITE> a owl:Class,
        gene_review:InterProTypeEnum ;
    rdfs:label "ACTIVE_SITE" ;
    rdfs:subClassOf gene_review:InterProTypeEnum ;
    skos:definition "Active site (residues directly involved in catalysis)" .

<https://w3id.org/ai4curation/gene_review/InterProTypeEnum#BINDING_SITE> a owl:Class,
        gene_review:InterProTypeEnum ;
    rdfs:label "BINDING_SITE" ;
    rdfs:subClassOf gene_review:InterProTypeEnum ;
    skos:definition "Binding site (residues involved in binding substrates/ligands)" .

<https://w3id.org/ai4curation/gene_review/InterProTypeEnum#CONSERVED_SITE> a owl:Class,
        gene_review:InterProTypeEnum ;
    rdfs:label "CONSERVED_SITE" ;
    rdfs:subClassOf gene_review:InterProTypeEnum ;
    skos:definition "Conserved site (conserved residues with functional significance)" .

<https://w3id.org/ai4curation/gene_review/InterProTypeEnum#DOMAIN> a owl:Class,
        gene_review:InterProTypeEnum ;
    rdfs:label "DOMAIN" ;
    rdfs:subClassOf gene_review:InterProTypeEnum ;
    skos:definition "Protein domain (distinct functional or structural unit)" .

<https://w3id.org/ai4curation/gene_review/InterProTypeEnum#FAMILY> a owl:Class,
        gene_review:InterProTypeEnum ;
    rdfs:label "FAMILY" ;
    rdfs:subClassOf gene_review:InterProTypeEnum ;
    skos:definition "Protein family (groups of proteins sharing similar sequence and function)" .

<https://w3id.org/ai4curation/gene_review/InterProTypeEnum#HOMOLOGOUS_SUPERFAMILY> a owl:Class,
        gene_review:InterProTypeEnum ;
    rdfs:label "HOMOLOGOUS_SUPERFAMILY" ;
    rdfs:subClassOf gene_review:InterProTypeEnum ;
    skos:definition "Homologous superfamily (proteins with distant evolutionary relationships)" .

<https://w3id.org/ai4curation/gene_review/InterProTypeEnum#PTM> a owl:Class,
        gene_review:InterProTypeEnum ;
    rdfs:label "PTM" ;
    rdfs:subClassOf gene_review:InterProTypeEnum ;
    skos:definition "Post-translational modification site" .

<https://w3id.org/ai4curation/gene_review/InterProTypeEnum#REPEAT> a owl:Class,
        gene_review:InterProTypeEnum ;
    rdfs:label "REPEAT" ;
    rdfs:subClassOf gene_review:InterProTypeEnum ;
    skos:definition "Repeat (short sequence motif that occurs multiple times)" .

<https://w3id.org/ai4curation/gene_review/KnowledgeGapAspectEnum#BP_DARK> a owl:Class,
        gene_review:KnowledgeGapAspectEnum ;
    rdfs:label "BP_DARK" ;
    rdfs:subClassOf gene_review:KnowledgeGapAspectEnum ;
    skos:definition "An activity is known but not what it is for (common in microbial/plant metabolism)." .

<https://w3id.org/ai4curation/gene_review/KnowledgeGapAspectEnum#CC_DARK> a owl:Class,
        gene_review:KnowledgeGapAspectEnum ;
    rdfs:label "CC_DARK" ;
    rdfs:subClassOf gene_review:KnowledgeGapAspectEnum ;
    skos:definition "Function known, but where/when unknown." .

<https://w3id.org/ai4curation/gene_review/KnowledgeGapAspectEnum#MF_DARK> a owl:Class,
        gene_review:KnowledgeGapAspectEnum ;
    rdfs:label "MF_DARK" ;
    rdfs:subClassOf gene_review:KnowledgeGapAspectEnum ;
    skos:definition "Process/location known, molecular mechanism unknown. The most common and most insidious case — rich BP/CC make the gene look known. The \"protein binding\" smell lives here." .

<https://w3id.org/ai4curation/gene_review/KnowledgeGapAspectEnum#RESIDUAL_SUBGAP> a owl:Class,
        gene_review:KnowledgeGapAspectEnum ;
    rdfs:label "RESIDUAL_SUBGAP" ;
    rdfs:subClassOf gene_review:KnowledgeGapAspectEnum ;
    skos:definition "The core function is textbook-solid, but one sharp, load-bearing mechanistic hole remains (e.g. an unidentified GEF/GAP, a catalysis-independent scaffolding mechanism, an unidentified recruit). Easy to miss because the gene looks finished." .

<https://w3id.org/ai4curation/gene_review/KnowledgeGapAspectEnum#WHOLLY_DARK> a owl:Class,
        gene_review:KnowledgeGapAspectEnum ;
    rdfs:label "WHOLLY_DARK" ;
    rdfs:subClassOf gene_review:KnowledgeGapAspectEnum ;
    skos:definition "Only root terms / IEA / \"protein binding\" survive review (the deep unknome)." .

<https://w3id.org/ai4curation/gene_review/KnowledgeGapKindEnum#BIOLOGY> a owl:Class,
        gene_review:KnowledgeGapKindEnum ;
    rdfs:label "BIOLOGY" ;
    rdfs:subClassOf gene_review:KnowledgeGapKindEnum ;
    skos:definition "Nobody knows; resolvable only by new experiments. This is the unknome and the primary target of the Function Knowledge Gaps project." .

<https://w3id.org/ai4curation/gene_review/KnowledgeGapKindEnum#CURATION> a owl:Class,
        gene_review:KnowledgeGapKindEnum ;
    rdfs:label "CURATION" ;
    rdfs:subClassOf gene_review:KnowledgeGapKindEnum ;
    skos:definition "The knowledge exists in the literature but is not yet annotated, or is annotated too generically. Resolvable by curation." .

<https://w3id.org/ai4curation/gene_review/KnowledgeGapKindEnum#ONTOLOGY> a owl:Class,
        gene_review:KnowledgeGapKindEnum ;
    rdfs:label "ONTOLOGY" ;
    rdfs:subClassOf gene_review:KnowledgeGapKindEnum ;
    skos:definition "The knowledge exists but no GO/ontology term can express it (e.g. \"structural subunit of complex X\", or a novel activity). Resolvable by ontology development; usually paired with proposed_new_terms." .

<https://w3id.org/ai4curation/gene_review/KnowledgeGapStatusEnum#CLOSING> a owl:Class,
        gene_review:KnowledgeGapStatusEnum ;
    rdfs:label "CLOSING" ;
    rdfs:subClassOf gene_review:KnowledgeGapStatusEnum ;
    skos:definition "Function-defining evidence exists (e.g. recent preprints) but has not yet propagated to peer-reviewed, GO-curated form." .

<https://w3id.org/ai4curation/gene_review/KnowledgeGapStatusEnum#NARROWING> a owl:Class,
        gene_review:KnowledgeGapStatusEnum ;
    rdfs:label "NARROWING" ;
    rdfs:subClassOf gene_review:KnowledgeGapStatusEnum ;
    skos:definition "Under active investigation with emerging but still incomplete evidence." .

<https://w3id.org/ai4curation/gene_review/KnowledgeGapStatusEnum#OPEN> a owl:Class,
        gene_review:KnowledgeGapStatusEnum ;
    rdfs:label "OPEN" ;
    rdfs:subClassOf gene_review:KnowledgeGapStatusEnum ;
    skos:definition "Unresolved and not under active, evidence-producing investigation." .

<https://w3id.org/ai4curation/gene_review/KnowledgeGapStatusEnum#RESOLVED> a owl:Class,
        gene_review:KnowledgeGapStatusEnum ;
    rdfs:label "RESOLVED" ;
    rdfs:subClassOf gene_review:KnowledgeGapStatusEnum ;
    skos:definition "The gap has been closed; retained for provenance/history." .

<https://w3id.org/ai4curation/gene_review/LiteratureSupportEnum#CONTRADICTED> a owl:Class,
        gene_review:LiteratureSupportEnum ;
    rdfs:label "CONTRADICTED" ;
    rdfs:subClassOf gene_review:LiteratureSupportEnum ;
    skos:definition "Literature contradicts the rule's predicted function" .

<https://w3id.org/ai4curation/gene_review/LiteratureSupportEnum#MODERATE> a owl:Class,
        gene_review:LiteratureSupportEnum ;
    rdfs:label "MODERATE" ;
    rdfs:subClassOf gene_review:LiteratureSupportEnum ;
    skos:definition "Some supporting evidence exists but not comprehensive" .

<https://w3id.org/ai4curation/gene_review/LiteratureSupportEnum#NONE> a owl:Class,
        gene_review:LiteratureSupportEnum ;
    rdfs:label "NONE" ;
    rdfs:subClassOf gene_review:LiteratureSupportEnum ;
    skos:definition "No literature support found" .

<https://w3id.org/ai4curation/gene_review/LiteratureSupportEnum#STRONG> a owl:Class,
        gene_review:LiteratureSupportEnum ;
    rdfs:label "STRONG" ;
    rdfs:subClassOf gene_review:LiteratureSupportEnum ;
    skos:definition "Multiple high-quality papers directly support the domain-function relationship" .

<https://w3id.org/ai4curation/gene_review/LiteratureSupportEnum#WEAK> a owl:Class,
        gene_review:LiteratureSupportEnum ;
    rdfs:label "WEAK" ;
    rdfs:subClassOf gene_review:LiteratureSupportEnum ;
    skos:definition "Limited evidence, mostly indirect or from computational studies" .

<https://w3id.org/ai4curation/gene_review/ManuscriptSection#DATABASE_ENTRY> a owl:Class,
        gene_review:ManuscriptSection ;
    rdfs:label "DATABASE_ENTRY" ;
    rdfs:subClassOf gene_review:ManuscriptSection ;
    skos:definition "Database entry" ;
    gene_review:order 15 .

<https://w3id.org/ai4curation/gene_review/ManuscriptSection#OTHER> a owl:Class,
        gene_review:ManuscriptSection ;
    rdfs:label "OTHER" ;
    rdfs:subClassOf gene_review:ManuscriptSection ;
    skos:definition "Other main text section" ;
    gene_review:catch_all true .

<https://w3id.org/ai4curation/gene_review/ModuleConnectionTypeEnum#CAUSES> a owl:Class,
        gene_review:ModuleConnectionTypeEnum ;
    rdfs:label "CAUSES" ;
    rdfs:subClassOf gene_review:ModuleConnectionTypeEnum ;
    skos:definition "The source causally promotes or produces the target." .

<https://w3id.org/ai4curation/gene_review/ModuleConnectionTypeEnum#HAS_INPUT> a owl:Class,
        gene_review:ModuleConnectionTypeEnum ;
    rdfs:label "HAS_INPUT" ;
    rdfs:subClassOf gene_review:ModuleConnectionTypeEnum ;
    skos:definition "The target has the source as input." .

<https://w3id.org/ai4curation/gene_review/ModuleConnectionTypeEnum#HAS_OUTPUT> a owl:Class,
        gene_review:ModuleConnectionTypeEnum ;
    rdfs:label "HAS_OUTPUT" ;
    rdfs:subClassOf gene_review:ModuleConnectionTypeEnum ;
    skos:definition "The source has the target as output." .

<https://w3id.org/ai4curation/gene_review/ModuleConnectionTypeEnum#NEGATIVELY_REGULATES> a owl:Class,
        gene_review:ModuleConnectionTypeEnum ;
    rdfs:label "NEGATIVELY_REGULATES" ;
    rdfs:subClassOf gene_review:ModuleConnectionTypeEnum ;
    skos:definition "The source negatively regulates the target." .

<https://w3id.org/ai4curation/gene_review/ModuleConnectionTypeEnum#PART_OF> a owl:Class,
        gene_review:ModuleConnectionTypeEnum ;
    rdfs:label "PART_OF" ;
    rdfs:subClassOf gene_review:ModuleConnectionTypeEnum ;
    skos:definition "The source is part of the target." .

<https://w3id.org/ai4curation/gene_review/ModuleConnectionTypeEnum#POSITIVELY_REGULATES> a owl:Class,
        gene_review:ModuleConnectionTypeEnum ;
    rdfs:label "POSITIVELY_REGULATES" ;
    rdfs:subClassOf gene_review:ModuleConnectionTypeEnum ;
    skos:definition "The source positively regulates the target." .

<https://w3id.org/ai4curation/gene_review/ModuleConnectionTypeEnum#PRECEDES> a owl:Class,
        gene_review:ModuleConnectionTypeEnum ;
    rdfs:label "PRECEDES" ;
    rdfs:subClassOf gene_review:ModuleConnectionTypeEnum ;
    skos:definition "The source occurs before the target." .

<https://w3id.org/ai4curation/gene_review/ModuleConnectionTypeEnum#PROVIDES_INPUT_FOR> a owl:Class,
        gene_review:ModuleConnectionTypeEnum ;
    rdfs:label "PROVIDES_INPUT_FOR" ;
    rdfs:subClassOf gene_review:ModuleConnectionTypeEnum ;
    skos:definition "The source provides material, signal, or context used by the target." .

gene_review:ModuleContext a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ModuleContext" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Descriptor ;
            owl:onProperty gene_review:conditions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:notes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:taxa ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:CellTypeDescriptor ;
            owl:onProperty gene_review:cell_types ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:DevelopmentalStageDescriptor ;
            owl:onProperty gene_review:developmental_stages ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:cellular_components ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:conditions ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:CellularComponentDescriptor ;
            owl:onProperty gene_review:cellular_components ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:cell_types ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:developmental_stages ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:anatomical_locations ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:EvidenceItem ;
            owl:onProperty gene_review:evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:TaxonDescriptor ;
            owl:onProperty gene_review:taxa ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:AnatomicalEntityDescriptor ;
            owl:onProperty gene_review:anatomical_locations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:evidence ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:notes ] ;
    skos:definition "Context that applies to a module node, variant, annoton, or connection." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

<https://w3id.org/ai4curation/gene_review/ModuleScopeEnum#ABSTRACT> a owl:Class,
        gene_review:ModuleScopeEnum ;
    rdfs:label "ABSTRACT" ;
    rdfs:subClassOf gene_review:ModuleScopeEnum ;
    skos:definition "A reusable motif or template that intentionally uses abstract participant selectors and is not expected to ground each terminal node to concrete representative proteins." .

<https://w3id.org/ai4curation/gene_review/ModuleScopeEnum#CONCRETE> a owl:Class,
        gene_review:ModuleScopeEnum ;
    rdfs:label "CONCRETE" ;
    rdfs:subClassOf gene_review:ModuleScopeEnum ;
    skos:definition "A module representing a specific pathway, complex, process, or taxon-scoped realization where terminal steps should generally ground to representative members." .

<https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#BIOLOGICAL_PROCESS> a owl:Class,
        gene_review:ModuleTypeEnum ;
    rdfs:label "BIOLOGICAL_PROCESS" ;
    rdfs:subClassOf gene_review:ModuleTypeEnum ;
    skos:definition "Biological-process-like module." .

<https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#CELLULAR_COMPONENT> a owl:Class,
        gene_review:ModuleTypeEnum ;
    rdfs:label "CELLULAR_COMPONENT" ;
    rdfs:subClassOf gene_review:ModuleTypeEnum ;
    skos:definition "Cellular component or structure viewed as a module." .

<https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#DEVELOPMENTAL_PROCESS> a owl:Class,
        gene_review:ModuleTypeEnum ;
    rdfs:label "DEVELOPMENTAL_PROCESS" ;
    rdfs:subClassOf gene_review:ModuleTypeEnum ;
    skos:definition "Developmental process, stage, or program." .

<https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#METABOLIC_PATHWAY> a owl:Class,
        gene_review:ModuleTypeEnum ;
    rdfs:label "METABOLIC_PATHWAY" ;
    rdfs:subClassOf gene_review:ModuleTypeEnum ;
    skos:definition "Metabolic pathway or pathway segment." .

<https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#MODULE> a owl:Class,
        gene_review:ModuleTypeEnum ;
    rdfs:label "MODULE" ;
    rdfs:subClassOf gene_review:ModuleTypeEnum ;
    skos:definition "Generic or unspecified module." .

<https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#MOLECULAR_FUNCTION> a owl:Class,
        gene_review:ModuleTypeEnum ;
    rdfs:label "MOLECULAR_FUNCTION" ;
    rdfs:subClassOf gene_review:ModuleTypeEnum ;
    skos:definition "Molecular-function-like module." .

<https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#ORGANELLE_LIFECYCLE> a owl:Class,
        gene_review:ModuleTypeEnum ;
    rdfs:label "ORGANELLE_LIFECYCLE" ;
    rdfs:subClassOf gene_review:ModuleTypeEnum ;
    skos:definition "Assembly, maintenance, operation, and turnover of an organelle." .

<https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#PROTEIN_COMPLEX> a owl:Class,
        gene_review:ModuleTypeEnum ;
    rdfs:label "PROTEIN_COMPLEX" ;
    rdfs:subClassOf gene_review:ModuleTypeEnum ;
    skos:definition "Protein complex or complex lifecycle." .

<https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#REACTION> a owl:Class,
        gene_review:ModuleTypeEnum ;
    rdfs:label "REACTION" ;
    rdfs:subClassOf gene_review:ModuleTypeEnum ;
    skos:definition "Reaction-like module step." .

<https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#REGULATORY_STEP> a owl:Class,
        gene_review:ModuleTypeEnum ;
    rdfs:label "REGULATORY_STEP" ;
    rdfs:subClassOf gene_review:ModuleTypeEnum ;
    skos:definition "Regulatory or control step." .

<https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#SIGNALING_PATHWAY> a owl:Class,
        gene_review:ModuleTypeEnum ;
    rdfs:label "SIGNALING_PATHWAY" ;
    rdfs:subClassOf gene_review:ModuleTypeEnum ;
    skos:definition "Signaling pathway or pathway segment." .

<https://w3id.org/ai4curation/gene_review/ModuleTypeEnum#TRANSPORT_STEP> a owl:Class,
        gene_review:ModuleTypeEnum ;
    rdfs:label "TRANSPORT_STEP" ;
    rdfs:subClassOf gene_review:ModuleTypeEnum ;
    skos:definition "Transport or translocation step." .

<https://w3id.org/ai4curation/gene_review/OverlapEnum#COMPLETE> a owl:Class,
        gene_review:OverlapEnum ;
    rdfs:label "COMPLETE" ;
    rdfs:subClassOf gene_review:OverlapEnum ;
    skos:definition "Conditions are essentially equivalent/redundant" .

<https://w3id.org/ai4curation/gene_review/OverlapEnum#MINOR> a owl:Class,
        gene_review:OverlapEnum ;
    rdfs:label "MINOR" ;
    rdfs:subClassOf gene_review:OverlapEnum ;
    skos:definition "Slight overlap but conditions add meaningful specificity" .

<https://w3id.org/ai4curation/gene_review/OverlapEnum#NONE> a owl:Class,
        gene_review:OverlapEnum ;
    rdfs:label "NONE" ;
    rdfs:subClassOf gene_review:OverlapEnum ;
    skos:definition "Conditions are independent and non-overlapping" .

<https://w3id.org/ai4curation/gene_review/OverlapEnum#SIGNIFICANT> a owl:Class,
        gene_review:OverlapEnum ;
    rdfs:label "SIGNIFICANT" ;
    rdfs:subClassOf gene_review:OverlapEnum ;
    skos:definition "Substantial overlap - conditions may be capturing the same thing" .

<https://w3id.org/ai4curation/gene_review/OverlapInterpretationEnum#DISJOINT> a owl:Class,
        gene_review:OverlapInterpretationEnum ;
    rdfs:label "DISJOINT" ;
    rdfs:subClassOf gene_review:OverlapInterpretationEnum ;
    skos:definition "No overlap (intersection = 0), conditions are completely distinct" .

<https://w3id.org/ai4curation/gene_review/OverlapInterpretationEnum#HIGH_OVERLAP> a owl:Class,
        gene_review:OverlapInterpretationEnum ;
    rdfs:label "HIGH_OVERLAP" ;
    rdfs:subClassOf gene_review:OverlapInterpretationEnum ;
    skos:definition "High overlap (Jaccard > 0.5), conditions are similar" .

<https://w3id.org/ai4curation/gene_review/OverlapInterpretationEnum#LOW> a owl:Class,
        gene_review:OverlapInterpretationEnum ;
    rdfs:label "LOW" ;
    rdfs:subClassOf gene_review:OverlapInterpretationEnum ;
    skos:definition "Low overlap (Jaccard <= 0.2), conditions are mostly distinct" .

<https://w3id.org/ai4curation/gene_review/OverlapInterpretationEnum#MODERATE> a owl:Class,
        gene_review:OverlapInterpretationEnum ;
    rdfs:label "MODERATE" ;
    rdfs:subClassOf gene_review:OverlapInterpretationEnum ;
    skos:definition "Moderate overlap (0.2 < Jaccard <= 0.5)" .

<https://w3id.org/ai4curation/gene_review/OverlapInterpretationEnum#REDUNDANT> a owl:Class,
        gene_review:OverlapInterpretationEnum ;
    rdfs:label "REDUNDANT" ;
    rdfs:subClassOf gene_review:OverlapInterpretationEnum ;
    skos:definition "Very high overlap (Jaccard > 0.9), conditions are nearly identical" .

<https://w3id.org/ai4curation/gene_review/OverlapInterpretationEnum#SUBSET> a owl:Class,
        gene_review:OverlapInterpretationEnum ;
    rdfs:label "SUBSET" ;
    rdfs:subClassOf gene_review:OverlapInterpretationEnum ;
    skos:definition "One condition is a subset of the other (containment > 0.95)" .

<https://w3id.org/ai4curation/gene_review/ParsimonyEnum#ACCEPTABLE> a owl:Class,
        gene_review:ParsimonyEnum ;
    rdfs:label "ACCEPTABLE" ;
    rdfs:subClassOf gene_review:ParsimonyEnum ;
    skos:definition "Rule complexity is reasonable given the biological context" .

<https://w3id.org/ai4curation/gene_review/ParsimonyEnum#OVERLY_COMPLEX> a owl:Class,
        gene_review:ParsimonyEnum ;
    rdfs:label "OVERLY_COMPLEX" ;
    rdfs:subClassOf gene_review:ParsimonyEnum ;
    skos:definition "Rule has unnecessary complexity that should be simplified" .

<https://w3id.org/ai4curation/gene_review/ParsimonyEnum#PARSIMONIOUS> a owl:Class,
        gene_review:ParsimonyEnum ;
    rdfs:label "PARSIMONIOUS" ;
    rdfs:subClassOf gene_review:ParsimonyEnum ;
    skos:definition "Rule is appropriately simple - conditions are necessary and sufficient" .

<https://w3id.org/ai4curation/gene_review/ParsimonyEnum#REDUNDANT> a owl:Class,
        gene_review:ParsimonyEnum ;
    rdfs:label "REDUNDANT" ;
    rdfs:subClassOf gene_review:ParsimonyEnum ;
    skos:definition "Some conditions are redundant and could be removed" .

gene_review:ParticipantSelector a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ParticipantSelector" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gene_review:TaxonDescriptor ;
            owl:onProperty gene_review:taxon ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:gene_product ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:ortholog_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:family ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:gene ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:required_domain ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:notes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:gene_product ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:DomainDescriptor ;
            owl:onProperty gene_review:required_domain ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:ParticipantSelectorTypeEnum ;
            owl:onProperty gene_review:selector_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:ProteinComplexDescriptor ;
            owl:onProperty gene_review:protein_complex ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:GeneDescriptor ;
            owl:onProperty gene_review:homolog_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:EvidenceItem ;
            owl:onProperty gene_review:evidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:protein_complex ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:homolog_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:gene ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:family ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:selector_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:taxon ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:domain ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:taxon ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:protein_complex ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:ortholog_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:homolog_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:MolecularFunctionDescriptor ;
            owl:onProperty gene_review:required_function ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:GeneDescriptor ;
            owl:onProperty gene_review:gene ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:required_function ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:GeneProductDescriptor ;
            owl:onProperty gene_review:gene_product ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:GeneDescriptor ;
            owl:onProperty gene_review:ortholog_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:FamilyDescriptor ;
            owl:onProperty gene_review:family ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:domain ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:required_function ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:required_domain ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:evidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:notes ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:selector_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:DomainDescriptor ;
            owl:onProperty gene_review:domain ] ;
    skos:definition "A selector for a concrete or abstract participant in a module annoton. This can ground to a gene, gene product, complex, family, domain, ortholog, homolog, or any entity satisfying a functional/domain constraint." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

<https://w3id.org/ai4curation/gene_review/ParticipantSelectorTypeEnum#ANY_PARTICIPANT> a owl:Class,
        gene_review:ParticipantSelectorTypeEnum ;
    rdfs:label "ANY_PARTICIPANT" ;
    rdfs:subClassOf gene_review:ParticipantSelectorTypeEnum ;
    skos:definition "An unspecified participant." .

<https://w3id.org/ai4curation/gene_review/ParticipantSelectorTypeEnum#ANY_WITH_DOMAIN> a owl:Class,
        gene_review:ParticipantSelectorTypeEnum ;
    rdfs:label "ANY_WITH_DOMAIN" ;
    rdfs:subClassOf gene_review:ParticipantSelectorTypeEnum ;
    skos:definition "Any participant satisfying the specified domain descriptor." .

<https://w3id.org/ai4curation/gene_review/ParticipantSelectorTypeEnum#ANY_WITH_FUNCTION> a owl:Class,
        gene_review:ParticipantSelectorTypeEnum ;
    rdfs:label "ANY_WITH_FUNCTION" ;
    rdfs:subClassOf gene_review:ParticipantSelectorTypeEnum ;
    skos:definition "Any participant satisfying the specified molecular function descriptor." .

<https://w3id.org/ai4curation/gene_review/ParticipantSelectorTypeEnum#DOMAIN> a owl:Class,
        gene_review:ParticipantSelectorTypeEnum ;
    rdfs:label "DOMAIN" ;
    rdfs:subClassOf gene_review:ParticipantSelectorTypeEnum ;
    skos:definition "Any entity with a specified domain, motif, or site." .

<https://w3id.org/ai4curation/gene_review/ParticipantSelectorTypeEnum#FAMILY> a owl:Class,
        gene_review:ParticipantSelectorTypeEnum ;
    rdfs:label "FAMILY" ;
    rdfs:subClassOf gene_review:ParticipantSelectorTypeEnum ;
    skos:definition "Any member of a specified family or orthogroup." .

<https://w3id.org/ai4curation/gene_review/ParticipantSelectorTypeEnum#GENE> a owl:Class,
        gene_review:ParticipantSelectorTypeEnum ;
    rdfs:label "GENE" ;
    rdfs:subClassOf gene_review:ParticipantSelectorTypeEnum ;
    skos:definition "A concrete gene." .

<https://w3id.org/ai4curation/gene_review/ParticipantSelectorTypeEnum#GENE_PRODUCT> a owl:Class,
        gene_review:ParticipantSelectorTypeEnum ;
    rdfs:label "GENE_PRODUCT" ;
    rdfs:subClassOf gene_review:ParticipantSelectorTypeEnum ;
    skos:definition "A concrete gene product, protein, isoform, or form." .

<https://w3id.org/ai4curation/gene_review/ParticipantSelectorTypeEnum#HOMOLOG_OF> a owl:Class,
        gene_review:ParticipantSelectorTypeEnum ;
    rdfs:label "HOMOLOG_OF" ;
    rdfs:subClassOf gene_review:ParticipantSelectorTypeEnum ;
    skos:definition "Any homolog of a specified gene." .

<https://w3id.org/ai4curation/gene_review/ParticipantSelectorTypeEnum#ORTHOLOG_OF> a owl:Class,
        gene_review:ParticipantSelectorTypeEnum ;
    rdfs:label "ORTHOLOG_OF" ;
    rdfs:subClassOf gene_review:ParticipantSelectorTypeEnum ;
    skos:definition "Any ortholog of a specified gene." .

<https://w3id.org/ai4curation/gene_review/ParticipantSelectorTypeEnum#PROTEIN_COMPLEX> a owl:Class,
        gene_review:ParticipantSelectorTypeEnum ;
    rdfs:label "PROTEIN_COMPLEX" ;
    rdfs:subClassOf gene_review:ParticipantSelectorTypeEnum ;
    skos:definition "A concrete protein-containing complex or subcomplex." .

<https://w3id.org/ai4curation/gene_review/PredictedTermTypeEnum#EC> a owl:Class,
        gene_review:PredictedTermTypeEnum ;
    rdfs:label "EC" ;
    rdfs:subClassOf gene_review:PredictedTermTypeEnum ;
    skos:definition "Enzyme Commission number (e.g., EC:2.7.7.87)" .

<https://w3id.org/ai4curation/gene_review/PredictedTermTypeEnum#GO_BP> a owl:Class,
        gene_review:PredictedTermTypeEnum ;
    rdfs:label "GO_BP" ;
    rdfs:subClassOf gene_review:PredictedTermTypeEnum ;
    skos:definition "GO Biological Process term" .

<https://w3id.org/ai4curation/gene_review/PredictedTermTypeEnum#GO_CC> a owl:Class,
        gene_review:PredictedTermTypeEnum ;
    rdfs:label "GO_CC" ;
    rdfs:subClassOf gene_review:PredictedTermTypeEnum ;
    skos:definition "GO Cellular Component term" .

<https://w3id.org/ai4curation/gene_review/PredictedTermTypeEnum#GO_MF> a owl:Class,
        gene_review:PredictedTermTypeEnum ;
    rdfs:label "GO_MF" ;
    rdfs:subClassOf gene_review:PredictedTermTypeEnum ;
    skos:definition "GO Molecular Function term" .

<https://w3id.org/ai4curation/gene_review/PredictionAssessmentEnum#CNN> a owl:Class,
        gene_review:PredictionAssessmentEnum ;
    rdfs:label "CNN" ;
    rdfs:subClassOf gene_review:PredictionAssessmentEnum ;
    skos:definition "Correct but Not Novel - the prediction matches an annotation already present in UniProt or in the training data. Not a novel discovery (CS=2)" .

<https://w3id.org/ai4curation/gene_review/PredictionAssessmentEnum#COR> a owl:Class,
        gene_review:PredictionAssessmentEnum ;
    rdfs:label "COR" ;
    rdfs:subClassOf gene_review:PredictionAssessmentEnum ;
    skos:definition "Correct prediction - validated by literature/bioinformatic evidence as a genuinely novel correct prediction (CS=2)" .

<https://w3id.org/ai4curation/gene_review/PredictionAssessmentEnum#LSP> a owl:Class,
        gene_review:PredictionAssessmentEnum ;
    rdfs:label "LSP" ;
    rdfs:subClassOf gene_review:PredictionAssessmentEnum ;
    skos:definition "Less Precise - the prediction is more generic than the existing annotation. Correct at a higher level but not informative (CS=2)" .

<https://w3id.org/ai4curation/gene_review/PredictionAssessmentEnum#NPI> a owl:Class,
        gene_review:PredictionAssessmentEnum ;
    rdfs:label "NPI" ;
    rdfs:subClassOf gene_review:PredictionAssessmentEnum ;
    skos:definition "Nonparalog Incorrect - wrong prediction refuted by evidence: pathway absent in organism, activity belongs to a different gene, or published data contradict the prediction (CS=0)" .

<https://w3id.org/ai4curation/gene_review/PredictionAssessmentEnum#PLI> a owl:Class,
        gene_review:PredictionAssessmentEnum ;
    rdfs:label "PLI" ;
    rdfs:subClassOf gene_review:PredictionAssessmentEnum ;
    skos:definition "Paralog Incorrect - wrong prediction due to failure to distinguish nonisofunctional paralogs within a protein superfamily (CS=0)" .

<https://w3id.org/ai4curation/gene_review/PredictionAssessmentEnum#REP> a owl:Class,
        gene_review:PredictionAssessmentEnum ;
    rdfs:label "REP" ;
    rdfs:subClassOf gene_review:PredictionAssessmentEnum ;
    skos:definition "Repetition - frequency-biased duplication of a common EC/GO term. The model assigns a high-frequency term (e.g., histidine kinase) to proteins with no sequence similarity to that family (CS=0)" .

<https://w3id.org/ai4curation/gene_review/PredictionAssessmentEnum#UNC> a owl:Class,
        gene_review:PredictionAssessmentEnum ;
    rdfs:label "UNC" ;
    rdfs:subClassOf gene_review:PredictionAssessmentEnum ;
    skos:definition "Uncertain - the prediction cannot be validated or refuted with available evidence. Requires additional experiments or data (CS=1)" .

<https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#COMPLEX_ACTIVITY_TRANSFER> a owl:Class,
        gene_review:PredictionErrorTypeEnum ;
    rdfs:label "COMPLEX_ACTIVITY_TRANSFER" ;
    rdfs:subClassOf gene_review:PredictionErrorTypeEnum ;
    skos:definition "Intrinsic catalytic activity of a molecular complex is assigned to a noncatalytic accessory subunit. Participation in the complex or its biological process does not establish that the subunit catalyzes the reaction." .

<https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#CURATION_MISTAKE> a owl:Class,
        gene_review:PredictionErrorTypeEnum ;
    rdfs:label "CURATION_MISTAKE" ;
    rdfs:subClassOf gene_review:PredictionErrorTypeEnum ;
    skos:definition "Type 4: The training data contain an incorrect annotation from a biocuration error or an outdated annotation that has since been corrected." .

<https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#DOMAIN_ARCHITECTURE_MISMATCH> a owl:Class,
        gene_review:PredictionErrorTypeEnum ;
    rdfs:label "DOMAIN_ARCHITECTURE_MISMATCH" ;
    rdfs:subClassOf gene_review:PredictionErrorTypeEnum ;
    skos:definition "The predicted activity requires a domain, catalytic region, or complete architecture absent from the selected protein. Includes transfer of a multidomain donor's activity through a shared noncatalytic domain. Does not establish that the target is a fold-retaining pseudoenzyme, that its gene model is wrong, or that the historical model input differed." .

<https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#EXPERIMENTAL_MISTAKE> a owl:Class,
        gene_review:PredictionErrorTypeEnum ;
    rdfs:label "EXPERIMENTAL_MISTAKE" ;
    rdfs:subClassOf gene_review:PredictionErrorTypeEnum ;
    skos:definition "Type 5: The training data are based on experimental findings that have been refuted or are inconclusive." .

<https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#FAILURE_TO_CAPTURE_LITERATURE> a owl:Class,
        gene_review:PredictionErrorTypeEnum ;
    rdfs:label "FAILURE_TO_CAPTURE_LITERATURE" ;
    rdfs:subClassOf gene_review:PredictionErrorTypeEnum ;
    skos:definition "Type 1: Function is known and published but not captured in the database used for training. The protein is falsely labeled as unknown." .

<https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#FREQUENCY_BIAS> a owl:Class,
        gene_review:PredictionErrorTypeEnum ;
    rdfs:label "FREQUENCY_BIAS" ;
    rdfs:subClassOf gene_review:PredictionErrorTypeEnum ;
    skos:definition "The model makes predictions biased toward high-frequency labels in the training data, regardless of sequence features. Common with EC numbers like histidine kinase (2.7.13.3) or PTS transporter (2.7.1.69)." .

<https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#IN_VITRO_NOT_IN_VIVO> a owl:Class,
        gene_review:PredictionErrorTypeEnum ;
    rdfs:label "IN_VITRO_NOT_IN_VIVO" ;
    rdfs:subClassOf gene_review:PredictionErrorTypeEnum ;
    skos:definition "The predicted activity can be demonstrated in vitro but does not represent the in vivo biological function (e.g., promiscuous activity at orders of magnitude lower rate than the dedicated enzyme)." .

<https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#LOCALIZATION_DEFAULT> a owl:Class,
        gene_review:PredictionErrorTypeEnum ;
    rdfs:label "LOCALIZATION_DEFAULT" ;
    rdfs:subClassOf gene_review:PredictionErrorTypeEnum ;
    skos:definition "The model defaults to a cytosolic/cytoplasmic subcellular localization when no transmembrane or signal-sequence features are detected, mislocalizing secreted, periplasmic, organellar (mitochondrial, ER, vacuolar), or membrane proteins. Tends to succeed only when a domain/family name explicitly encodes the compartment (e.g. BiP/KAR2 -> ER)." .

<https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#MULTIPLE_FUNCTIONS> a owl:Class,
        gene_review:PredictionErrorTypeEnum ;
    rdfs:label "MULTIPLE_FUNCTIONS" ;
    rdfs:subClassOf gene_review:PredictionErrorTypeEnum ;
    skos:definition "Type 3: Protein has multiple functions (fusion, moonlighting, promiscuity) and only one function is captured or a non-primary function is predicted." .

<https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#NAMING_INCONSISTENCY> a owl:Class,
        gene_review:PredictionErrorTypeEnum ;
    rdfs:label "NAMING_INCONSISTENCY" ;
    rdfs:subClassOf gene_review:PredictionErrorTypeEnum ;
    skos:definition "Type 2: Inconsistent naming of the same entity across databases leads to missed or incorrect propagation." .

<https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#PARALOG_OVERANNOTATION> a owl:Class,
        gene_review:PredictionErrorTypeEnum ;
    rdfs:label "PARALOG_OVERANNOTATION" ;
    rdfs:subClassOf gene_review:PredictionErrorTypeEnum ;
    skos:definition "Type 6: Annotation wrongly propagated to a nonisofunctional paralog. The model fails to distinguish between paralogs with different substrate specificities or functions within the same superfamily." .

<https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#PATHWAY_CONTEXT_IGNORED> a owl:Class,
        gene_review:PredictionErrorTypeEnum ;
    rdfs:label "PATHWAY_CONTEXT_IGNORED" ;
    rdfs:subClassOf gene_review:PredictionErrorTypeEnum ;
    skos:definition "The model ignores metabolic/pathway context. The predicted activity requires a pathway that is absent from the organism's genome." .

<https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#PSEUDOENZYME_OVERANNOTATION> a owl:Class,
        gene_review:PredictionErrorTypeEnum ;
    rdfs:label "PSEUDOENZYME_OVERANNOTATION" ;
    rdfs:subClassOf gene_review:PredictionErrorTypeEnum ;
    skos:definition "The model assigns the ancestral catalytic activity of a domain family to a member that retains the fold but has lost or degraded the catalytic residues (a pseudoenzyme), failing to detect substituted/missing active-site residues. E.g. predicting demethylase activity for a JmjC protein with a degenerate active site, chitinase activity for a member lacking the catalytic glutamate, or peroxidase activity for a peroxiredoxin that has lost its resolving cysteine and instead acts as a chaperone. A special case of MULTIPLE_FUNCTIONS / neofunctionalization where the divergence is specifically loss of catalysis." .

<https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#TAXON_CONSTRAINT_VIOLATION> a owl:Class,
        gene_review:PredictionErrorTypeEnum ;
    rdfs:label "TAXON_CONSTRAINT_VIOLATION" ;
    rdfs:subClassOf gene_review:PredictionErrorTypeEnum ;
    skos:definition "The predicted term is valid only in a lineage/kingdom different from the organism (e.g. animal-specific 'neuronal cell body' or adaptive-immune terms predicted for a plant or bacterial protein), reflecting homology transfer from a better-studied taxon. Distinct from PATHWAY_CONTEXT_IGNORED (a missing metabolic pathway) in that the violated constraint is taxonomic rather than pathway-level." .

<https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#TRAINING_DATA_CONTAMINATION> a owl:Class,
        gene_review:PredictionErrorTypeEnum ;
    rdfs:label "TRAINING_DATA_CONTAMINATION" ;
    rdfs:subClassOf gene_review:PredictionErrorTypeEnum ;
    skos:definition "The prediction appears novel but the annotation was already present in the version of the database used to build the training set." .

<https://w3id.org/ai4curation/gene_review/PredictionErrorTypeEnum#WRONG_INPUT_SEQUENCE> a owl:Class,
        gene_review:PredictionErrorTypeEnum ;
    rdfs:label "WRONG_INPUT_SEQUENCE" ;
    rdfs:subClassOf gene_review:PredictionErrorTypeEnum ;
    skos:definition "A data-pipeline error rather than a model-reasoning error: the predictor was supplied the wrong input (e.g. the sequence of a different gene), so every output describes the wrong protein. Recorded to distinguish upstream pipeline mistakes from genuine model mispredictions." .

<https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#CIRCULAR_PROPAGATION> a owl:Class,
        gene_review:PropagationFailureModeEnum ;
    rdfs:label "CIRCULAR_PROPAGATION" ;
    rdfs:subClassOf gene_review:PropagationFailureModeEnum ;
    skos:definition "Propagation chain depends on another propagated annotation rather than independent source evidence." .

<https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#COMPARTMENT_OR_COMPLEX_MISMATCH> a owl:Class,
        gene_review:PropagationFailureModeEnum ;
    rdfs:label "COMPARTMENT_OR_COMPLEX_MISMATCH" ;
    rdfs:subClassOf gene_review:PropagationFailureModeEnum ;
    skos:definition "Localization, complex membership, or pathway compartment does not transfer." .

<https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#CONTEXT_OR_TISSUE_MISMATCH> a owl:Class,
        gene_review:PropagationFailureModeEnum ;
    rdfs:label "CONTEXT_OR_TISSUE_MISMATCH" ;
    rdfs:subClassOf gene_review:PropagationFailureModeEnum ;
    skos:definition "Donor evidence is tissue, developmental, organismal, or disease-context specific." .

<https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#FUNCTIONAL_DIVERGENCE> a owl:Class,
        gene_review:PropagationFailureModeEnum ;
    rdfs:label "FUNCTIONAL_DIVERGENCE" ;
    rdfs:subClassOf gene_review:PropagationFailureModeEnum ;
    skos:definition "Target retained fold or orthology but changed substrate, product, activity, or pathway role." .

<https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#GRANULARITY_MISMATCH> a owl:Class,
        gene_review:PropagationFailureModeEnum ;
    rdfs:label "GRANULARITY_MISMATCH" ;
    rdfs:subClassOf gene_review:PropagationFailureModeEnum ;
    skos:definition "Parent term is true but uninformative, or child term overstates specificity." .

<https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#LINEAGE_OR_TAXON_MISMATCH> a owl:Class,
        gene_review:PropagationFailureModeEnum ;
    rdfs:label "LINEAGE_OR_TAXON_MISMATCH" ;
    rdfs:subClassOf gene_review:PropagationFailureModeEnum ;
    skos:definition "Process does not occur in the target lineage or organelle system." .

<https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#PSEUDO_OR_SUBACTIVITY_LOSS> a owl:Class,
        gene_review:PropagationFailureModeEnum ;
    rdfs:label "PSEUDO_OR_SUBACTIVITY_LOSS" ;
    rdfs:subClassOf gene_review:PropagationFailureModeEnum ;
    skos:definition "Catalytic residues or a specific sub-activity are lost even though the domain remains." .

<https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#REGULATORY_SIGN_INVERSION> a owl:Class,
        gene_review:PropagationFailureModeEnum ;
    rdfs:label "REGULATORY_SIGN_INVERSION" ;
    rdfs:subClassOf gene_review:PropagationFailureModeEnum ;
    skos:definition "Family contains activators and inhibitors, and a positive/negative regulatory term leaks across members." .

<https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#ROLE_CONFLATION> a owl:Class,
        gene_review:PropagationFailureModeEnum ;
    rdfs:label "ROLE_CONFLATION" ;
    rdfs:subClassOf gene_review:PropagationFailureModeEnum ;
    skos:definition "Substrate, regulator, effector, or specificity subunit is annotated as the agent or core machinery." .

<https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#SOURCE_EVIDENCE_WEAK> a owl:Class,
        gene_review:PropagationFailureModeEnum ;
    rdfs:label "SOURCE_EVIDENCE_WEAK" ;
    rdfs:subClassOf gene_review:PropagationFailureModeEnum ;
    skos:definition "Source evidence is inferred, statement-level, stale, or otherwise too weak for confident propagation." .

<https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#SOURCE_MISCITATION> a owl:Class,
        gene_review:PropagationFailureModeEnum ;
    rdfs:label "SOURCE_MISCITATION" ;
    rdfs:subClassOf gene_review:PropagationFailureModeEnum ;
    skos:definition "Source evidence points to the wrong gene, organism, publication, or homonym." .

<https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#WRONG_ORTHOLOG_OR_PARALOG> a owl:Class,
        gene_review:PropagationFailureModeEnum ;
    rdfs:label "WRONG_ORTHOLOG_OR_PARALOG" ;
    rdfs:subClassOf gene_review:PropagationFailureModeEnum ;
    skos:definition "Donor/source is a paralog, expanded family member, or wrong subfamily." .

gene_review:PropagationReview a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "PropagationReview" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:residue_claims_not_applicable ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:residue_claims_not_applicable ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:PropagationRootCauseEnum ;
            owl:onProperty gene_review:root_cause ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:ResidueClaim ;
            owl:onProperty gene_review:residue_claims ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:PropagationSource ;
            owl:onProperty gene_review:source_entities ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:residue_claims_not_applicable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:root_cause ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:residue_claims ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:source_entities ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:root_cause ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:PropagationFailureModeEnum ;
            owl:onProperty gene_review:failure_modes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:failure_modes ] ;
    skos:definition "Structured, mechanical assessment of a propagated or inferred annotation. The detailed biological rationale remains in review.reason; this object records the reusable taxonomy and optional per-source-gene/node comments." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

<https://w3id.org/ai4curation/gene_review/PropagationRootCauseEnum#EVIDENCE_CIRCULAR_OR_REDUNDANT> a owl:Class,
        gene_review:PropagationRootCauseEnum ;
    rdfs:label "EVIDENCE_CIRCULAR_OR_REDUNDANT" ;
    rdfs:subClassOf gene_review:PropagationRootCauseEnum ;
    skos:definition "The propagation chain transfers from another transfer, or the target already has stronger direct evidence." .

<https://w3id.org/ai4curation/gene_review/PropagationRootCauseEnum#NO_FAILURE_CORE> a owl:Class,
        gene_review:PropagationRootCauseEnum ;
    rdfs:label "NO_FAILURE_CORE" ;
    rdfs:subClassOf gene_review:PropagationRootCauseEnum ;
    skos:definition "The propagated annotation is correct and core for the target." .

<https://w3id.org/ai4curation/gene_review/PropagationRootCauseEnum#NO_FAILURE_NON_CORE> a owl:Class,
        gene_review:PropagationRootCauseEnum ;
    rdfs:label "NO_FAILURE_NON_CORE" ;
    rdfs:subClassOf gene_review:PropagationRootCauseEnum ;
    skos:definition "The propagated annotation is biologically defensible but contextual, secondary, or generic." .

<https://w3id.org/ai4curation/gene_review/PropagationRootCauseEnum#PROPAGATION_BAD> a owl:Class,
        gene_review:PropagationRootCauseEnum ;
    rdfs:label "PROPAGATION_BAD" ;
    rdfs:subClassOf gene_review:PropagationRootCauseEnum ;
    skos:definition "The source annotation is sound, but the term should not propagate to this target." .

<https://w3id.org/ai4curation/gene_review/PropagationRootCauseEnum#SOURCE_BAD> a owl:Class,
        gene_review:PropagationRootCauseEnum ;
    rdfs:label "SOURCE_BAD" ;
    rdfs:subClassOf gene_review:PropagationRootCauseEnum ;
    skos:definition "The source annotation is wrong, miscited, homonym-confused, or contradicted." .

<https://w3id.org/ai4curation/gene_review/PropagationRootCauseEnum#SOURCE_STALE_OR_MISSING> a owl:Class,
        gene_review:PropagationRootCauseEnum ;
    rdfs:label "SOURCE_STALE_OR_MISSING" ;
    rdfs:subClassOf gene_review:PropagationRootCauseEnum ;
    skos:definition "The transferred term no longer appears on the current source record, or donor tracing cannot recover it." .

<https://w3id.org/ai4curation/gene_review/PropagationRootCauseEnum#SOURCE_WEAK_OR_INFERRED> a owl:Class,
        gene_review:PropagationRootCauseEnum ;
    rdfs:label "SOURCE_WEAK_OR_INFERRED" ;
    rdfs:subClassOf gene_review:PropagationRootCauseEnum ;
    skos:definition "The source exists but is only inferred, statement-level, or otherwise weak for propagation." .

<https://w3id.org/ai4curation/gene_review/PropagationRootCauseEnum#TERM_SCOPING_PROBLEM> a owl:Class,
        gene_review:PropagationRootCauseEnum ;
    rdfs:label "TERM_SCOPING_PROBLEM" ;
    rdfs:subClassOf gene_review:PropagationRootCauseEnum ;
    skos:definition "The biology is related, but the GO term is too broad, too specific, or has the wrong role or qualifier." .

<https://w3id.org/ai4curation/gene_review/PropagationRootCauseEnum#UNRESOLVED> a owl:Class,
        gene_review:PropagationRootCauseEnum ;
    rdfs:label "UNRESOLVED" ;
    rdfs:subClassOf gene_review:PropagationRootCauseEnum ;
    skos:definition "The propagation issue was investigated but could not be classified confidently." .

<https://w3id.org/ai4curation/gene_review/PropagationSourceStatusEnum#CIRCULAR_OR_REDUNDANT> a owl:Class,
        gene_review:PropagationSourceStatusEnum ;
    rdfs:label "CIRCULAR_OR_REDUNDANT" ;
    rdfs:subClassOf gene_review:PropagationSourceStatusEnum ;
    skos:definition "Source participates in a circular transfer chain or adds no independent support." .

<https://w3id.org/ai4curation/gene_review/PropagationSourceStatusEnum#NOT_RELEVANT> a owl:Class,
        gene_review:PropagationSourceStatusEnum ;
    rdfs:label "NOT_RELEVANT" ;
    rdfs:subClassOf gene_review:PropagationSourceStatusEnum ;
    skos:definition "Source was inspected but is not relevant to the target annotation." .

<https://w3id.org/ai4curation/gene_review/PropagationSourceStatusEnum#SOURCE_BAD> a owl:Class,
        gene_review:PropagationSourceStatusEnum ;
    rdfs:label "SOURCE_BAD" ;
    rdfs:subClassOf gene_review:PropagationSourceStatusEnum ;
    skos:definition "Source annotation or source citation is itself wrong." .

<https://w3id.org/ai4curation/gene_review/PropagationSourceStatusEnum#SOURCE_STALE_OR_MISSING> a owl:Class,
        gene_review:PropagationSourceStatusEnum ;
    rdfs:label "SOURCE_STALE_OR_MISSING" ;
    rdfs:subClassOf gene_review:PropagationSourceStatusEnum ;
    skos:definition "Current source record no longer carries the transferred term, or tracing cannot recover it." .

<https://w3id.org/ai4curation/gene_review/PropagationSourceStatusEnum#SOURCE_WEAK_OR_INFERRED> a owl:Class,
        gene_review:PropagationSourceStatusEnum ;
    rdfs:label "SOURCE_WEAK_OR_INFERRED" ;
    rdfs:subClassOf gene_review:PropagationSourceStatusEnum ;
    skos:definition "Source exists but is only inferred, statement-level, or otherwise weak." .

<https://w3id.org/ai4curation/gene_review/PropagationSourceStatusEnum#SUPPORTS_SOURCE_BUT_NOT_TARGET> a owl:Class,
        gene_review:PropagationSourceStatusEnum ;
    rdfs:label "SUPPORTS_SOURCE_BUT_NOT_TARGET" ;
    rdfs:subClassOf gene_review:PropagationSourceStatusEnum ;
    skos:definition "Source evidence supports the source annotation, but propagation to the target is unsafe." .

<https://w3id.org/ai4curation/gene_review/PropagationSourceStatusEnum#SUPPORTS_TRANSFER> a owl:Class,
        gene_review:PropagationSourceStatusEnum ;
    rdfs:label "SUPPORTS_TRANSFER" ;
    rdfs:subClassOf gene_review:PropagationSourceStatusEnum ;
    skos:definition "Source evidence supports the term and the transfer to the target." .

<https://w3id.org/ai4curation/gene_review/PropagationSourceStatusEnum#UNRESOLVED> a owl:Class,
        gene_review:PropagationSourceStatusEnum ;
    rdfs:label "UNRESOLVED" ;
    rdfs:subClassOf gene_review:PropagationSourceStatusEnum ;
    skos:definition "Source could not be classified confidently." .

<https://w3id.org/ai4curation/gene_review/ProteinDatabaseEnum#SWISSPROT> a owl:Class,
        gene_review:ProteinDatabaseEnum ;
    rdfs:label "SWISSPROT" ;
    rdfs:subClassOf gene_review:ProteinDatabaseEnum ;
    skos:definition "Swiss-Prot (reviewed, manually curated proteins)" .

<https://w3id.org/ai4curation/gene_review/ProteinDatabaseEnum#TREMBL> a owl:Class,
        gene_review:ProteinDatabaseEnum ;
    rdfs:label "TREMBL" ;
    rdfs:subClassOf gene_review:ProteinDatabaseEnum ;
    skos:definition "TrEMBL (unreviewed, automatically annotated proteins)" .

<https://w3id.org/ai4curation/gene_review/ProteinDatabaseEnum#UNIPROT> a owl:Class,
        gene_review:ProteinDatabaseEnum ;
    rdfs:label "UNIPROT" ;
    rdfs:subClassOf gene_review:ProteinDatabaseEnum ;
    skos:definition "Full UniProtKB (Swiss-Prot + TrEMBL)" .

<https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#BIOINFORMATICS> a owl:Class,
        gene_review:PublicationTypeEnum ;
    rdfs:label "BIOINFORMATICS" ;
    rdfs:subClassOf gene_review:PublicationTypeEnum ;
    skos:definition "A local ad-hoc bioinformatics analysis carried out for this review, referenced via a 'file:' identifier (e.g. a bioinformatics RESULTS.md)." .

<https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#CASE_REPORT> a owl:Class,
        gene_review:PublicationTypeEnum ;
    rdfs:label "CASE_REPORT" ;
    rdfs:subClassOf gene_review:PublicationTypeEnum ;
    skos:definition "A clinical case report (PubMed PT 'Case Reports')." .

<https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#COMMENT_EDITORIAL> a owl:Class,
        gene_review:PublicationTypeEnum ;
    rdfs:label "COMMENT_EDITORIAL" ;
    rdfs:subClassOf gene_review:PublicationTypeEnum ;
    skos:definition "A comment, editorial, letter, or news item (PubMed PT 'Comment', 'Editorial', 'Letter', 'News')." .

<https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#DATABASE> a owl:Class,
        gene_review:PublicationTypeEnum ;
    rdfs:label "DATABASE" ;
    rdfs:subClassOf gene_review:PublicationTypeEnum ;
    skos:definition "A database record or curated method reference rather than a narrative publication (e.g. a GO_REF, Reactome pathway, or UniProt entry)." .

<https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#DEEP_RESEARCH> a owl:Class,
        gene_review:PublicationTypeEnum ;
    rdfs:label "DEEP_RESEARCH" ;
    rdfs:subClassOf gene_review:PublicationTypeEnum ;
    skos:definition "An AI/LLM deep-research report generated for this review, referenced via a 'file:' identifier (e.g. GENE-deep-research-PROVIDER.md)." .

<https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#META_ANALYSIS> a owl:Class,
        gene_review:PublicationTypeEnum ;
    rdfs:label "META_ANALYSIS" ;
    rdfs:subClassOf gene_review:PublicationTypeEnum ;
    skos:definition "A meta-analysis combining results across studies (PubMed PT 'Meta-Analysis')." .

<https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#OTHER> a owl:Class,
        gene_review:PublicationTypeEnum ;
    rdfs:label "OTHER" ;
    rdfs:subClassOf gene_review:PublicationTypeEnum ;
    skos:definition "A publication or source that does not fit the other categories." .

<https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#PREPRINT> a owl:Class,
        gene_review:PublicationTypeEnum ;
    rdfs:label "PREPRINT" ;
    rdfs:subClassOf gene_review:PublicationTypeEnum ;
    skos:definition "A preprint or other not-yet-peer-reviewed manuscript (PubMed PT 'Preprint')." .

<https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#PRIMARY_RESEARCH> a owl:Class,
        gene_review:PublicationTypeEnum ;
    rdfs:label "PRIMARY_RESEARCH" ;
    rdfs:subClassOf gene_review:PublicationTypeEnum ;
    skos:definition "An original/primary research article reporting new experimental or observational results (PubMed 'Journal Article' without a more specific review/secondary type)." .

<https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#REVIEW> a owl:Class,
        gene_review:PublicationTypeEnum ;
    rdfs:label "REVIEW" ;
    rdfs:subClassOf gene_review:PublicationTypeEnum ;
    skos:definition "A narrative review article that synthesizes prior literature (PubMed PT 'Review'). Reviews often carry phylogenetic/comparative reasoning and broad functional context." .

<https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#SYSTEMATIC_REVIEW> a owl:Class,
        gene_review:PublicationTypeEnum ;
    rdfs:label "SYSTEMATIC_REVIEW" ;
    rdfs:subClassOf gene_review:PublicationTypeEnum ;
    skos:definition "A systematic review (PubMed PT 'Systematic Review')." .

<https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#UNKNOWN> a owl:Class,
        gene_review:PublicationTypeEnum ;
    rdfs:label "UNKNOWN" ;
    rdfs:subClassOf gene_review:PublicationTypeEnum ;
    skos:definition "The publication type could not be determined (e.g. PubMed metadata unavailable)." .

gene_review:Question a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Question" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:question ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:question ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:experts ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:question ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:experts ] ;
    skos:definition "A question to be answered about the gene" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

<https://w3id.org/ai4curation/gene_review/ReferenceCorrectnessEnum#DISPUTED> a owl:Class,
        gene_review:ReferenceCorrectnessEnum ;
    rdfs:label "DISPUTED" ;
    rdfs:subClassOf gene_review:ReferenceCorrectnessEnum ;
    skos:definition "Correctly cited, but the paper's central claim is contradicted or contested by other evidence" .

<https://w3id.org/ai4curation/gene_review/ReferenceCorrectnessEnum#LOW_QUALITY> a owl:Class,
        gene_review:ReferenceCorrectnessEnum ;
    rdfs:label "LOW_QUALITY" ;
    rdfs:subClassOf gene_review:ReferenceCorrectnessEnum ;
    skos:definition "Correctly cited, but methodologically weak or preliminary; treat its conclusions with caution" .

<https://w3id.org/ai4curation/gene_review/ReferenceCorrectnessEnum#MISCITED> a owl:Class,
        gene_review:ReferenceCorrectnessEnum ;
    rdfs:label "MISCITED" ;
    rdfs:subClassOf gene_review:ReferenceCorrectnessEnum ;
    skos:definition "Paper is correctly identified but does not actually support the claim it is cited for" .

<https://w3id.org/ai4curation/gene_review/ReferenceCorrectnessEnum#UNVERIFIED> a owl:Class,
        gene_review:ReferenceCorrectnessEnum ;
    rdfs:label "UNVERIFIED" ;
    rdfs:subClassOf gene_review:ReferenceCorrectnessEnum ;
    skos:definition "Not yet manually checked (the default state)" .

<https://w3id.org/ai4curation/gene_review/ReferenceCorrectnessEnum#VERIFIED> a owl:Class,
        gene_review:ReferenceCorrectnessEnum ;
    rdfs:label "VERIFIED" ;
    rdfs:subClassOf gene_review:ReferenceCorrectnessEnum ;
    skos:definition "Identifier resolves to the intended paper, which supports how it is used, with no soundness concerns" .

<https://w3id.org/ai4curation/gene_review/ReferenceCorrectnessEnum#WRONG_IDENTIFIER> a owl:Class,
        gene_review:ReferenceCorrectnessEnum ;
    rdfs:label "WRONG_IDENTIFIER" ;
    rdfs:subClassOf gene_review:ReferenceCorrectnessEnum ;
    skos:definition "Identifier resolves to a DIFFERENT paper than intended (e.g. a PMID pointing to an unrelated article)" .

<https://w3id.org/ai4curation/gene_review/ReferenceRelevanceEnum#HIGH> a owl:Class,
        gene_review:ReferenceRelevanceEnum ;
    rdfs:label "HIGH" ;
    rdfs:subClassOf gene_review:ReferenceRelevanceEnum ;
    skos:definition "Directly establishes or strongly informs the gene's function, mechanism, process, or localization" .

<https://w3id.org/ai4curation/gene_review/ReferenceRelevanceEnum#LOW> a owl:Class,
        gene_review:ReferenceRelevanceEnum ;
    rdfs:label "LOW" ;
    rdfs:subClassOf gene_review:ReferenceRelevanceEnum ;
    skos:definition "Background or contextual only (e.g. family/pathway reviews, methods, or a passing mention)" .

<https://w3id.org/ai4curation/gene_review/ReferenceRelevanceEnum#MEDIUM> a owl:Class,
        gene_review:ReferenceRelevanceEnum ;
    rdfs:label "MEDIUM" ;
    rdfs:subClassOf gene_review:ReferenceRelevanceEnum ;
    skos:definition "Provides supporting or corroborating evidence for a function or annotation" .

<https://w3id.org/ai4curation/gene_review/ReferenceRelevanceEnum#NONE> a owl:Class,
        gene_review:ReferenceRelevanceEnum ;
    rdfs:label "NONE" ;
    rdfs:subClassOf gene_review:ReferenceRelevanceEnum ;
    skos:definition "Not relevant to this gene's function (a candidate for removal from the references)" .

gene_review:ReferenceReview a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ReferenceReview" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:review_notes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:relevance ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:relevance ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:ReferenceCorrectnessEnum ;
            owl:onProperty gene_review:correctness ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:correctness ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:correctness ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:ReferenceRelevanceEnum ;
            owl:onProperty gene_review:relevance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:review_notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:review_notes ] ;
    skos:definition "Manual reviewer assessment of a reference - how relevant it is to the gene's function, and whether it is correctly cited and scientifically sound. Distinct from the machine-fetched id/title fields; all fields are optional and reviewer-supplied." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

<https://w3id.org/ai4curation/gene_review/ResidueClaimEnum#LOST> a owl:Class,
        gene_review:ResidueClaimEnum ;
    rdfs:label "LOST" ;
    rdfs:subClassOf gene_review:ResidueClaimEnum ;
    skos:definition "The target does not carry the anchor's functional residue -- it is substituted, or no residue aligns to that position at all." .

<https://w3id.org/ai4curation/gene_review/ResidueClaimEnum#RETAINED> a owl:Class,
        gene_review:ResidueClaimEnum ;
    rdfs:label "RETAINED" ;
    rdfs:subClassOf gene_review:ResidueClaimEnum ;
    skos:definition "The target does carry the residue. Worth recording explicitly: a retained site refutes a \"lacks the catalytic residue\" argument, which is how the CASP12 and LPA errors would have been caught." .

<https://w3id.org/ai4curation/gene_review/ResidueClaimEnum#SUBSTITUTED> a owl:Class,
        gene_review:ResidueClaimEnum ;
    rdfs:label "SUBSTITUTED" ;
    rdfs:subClassOf gene_review:ResidueClaimEnum ;
    skos:definition "The residue differs but the substitution is conservative or otherwise argued not to abolish function. Distinct from LOST, which asserts the function is gone." .

<https://w3id.org/ai4curation/gene_review/ResidueClaimMethodEnum#LITERATURE> a owl:Class,
        gene_review:ResidueClaimMethodEnum ;
    rdfs:label "LITERATURE" ;
    rdfs:subClassOf gene_review:ResidueClaimMethodEnum ;
    skos:definition "A publication states the correspondence directly; cite it in review.supported_by." .

<https://w3id.org/ai4curation/gene_review/ResidueClaimMethodEnum#MSA> a owl:Class,
        gene_review:ResidueClaimMethodEnum ;
    rdfs:label "MSA" ;
    rdfs:subClassOf gene_review:ResidueClaimMethodEnum ;
    skos:definition "Multiple sequence alignment; record the alignment_release." .

<https://w3id.org/ai4curation/gene_review/ResidueClaimMethodEnum#STRUCTURE> a owl:Class,
        gene_review:ResidueClaimMethodEnum ;
    rdfs:label "STRUCTURE" ;
    rdfs:subClassOf gene_review:ResidueClaimMethodEnum ;
    skos:definition "Structural superposition or a solved complex." .

<https://w3id.org/ai4curation/gene_review/ResidueClaimMethodEnum#UNIPROT_FEATURE> a owl:Class,
        gene_review:ResidueClaimMethodEnum ;
    rdfs:label "UNIPROT_FEATURE" ;
    rdfs:subClassOf gene_review:ResidueClaimMethodEnum ;
    skos:definition "Both positions read from UniProt feature tables on their own records, with no alignment step." .

gene_review:ResiduePosition a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ResiduePosition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:sequence_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:accession ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( linkml:String [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[ACDEFGHIKLMNPQRSTVWYUO]$" ] ) ] ) ] ;
            owl:onProperty gene_review:residue ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( linkml:Integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty gene_review:sequence_version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:position ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:residue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:position ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:accession ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:sequence_version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:residue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:accession ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( linkml:Integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty gene_review:position ] ;
    skos:definition "A single residue in a named protein, in that protein's own numbering." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

<https://w3id.org/ai4curation/gene_review/RuleActionEnum#ACCEPT> a owl:Class,
        gene_review:RuleActionEnum ;
    rdfs:label "ACCEPT" ;
    rdfs:subClassOf gene_review:RuleActionEnum ;
    skos:definition "Rule is correct and should be kept as-is" .

<https://w3id.org/ai4curation/gene_review/RuleActionEnum#DEPRECATE> a owl:Class,
        gene_review:RuleActionEnum ;
    rdfs:label "DEPRECATE" ;
    rdfs:subClassOf gene_review:RuleActionEnum ;
    skos:definition "Rule should be removed or retired" .

<https://w3id.org/ai4curation/gene_review/RuleActionEnum#MERGE> a owl:Class,
        gene_review:RuleActionEnum ;
    rdfs:label "MERGE" ;
    rdfs:subClassOf gene_review:RuleActionEnum ;
    skos:definition "Rule should be merged with another related rule" .

<https://w3id.org/ai4curation/gene_review/RuleActionEnum#MODIFY> a owl:Class,
        gene_review:RuleActionEnum ;
    rdfs:label "MODIFY" ;
    rdfs:subClassOf gene_review:RuleActionEnum ;
    skos:definition "Rule needs modification (see suggested_modifications)" .

<https://w3id.org/ai4curation/gene_review/RuleActionEnum#SPLIT> a owl:Class,
        gene_review:RuleActionEnum ;
    rdfs:label "SPLIT" ;
    rdfs:subClassOf gene_review:RuleActionEnum ;
    skos:definition "Rule should be split into multiple more specific rules" .

<https://w3id.org/ai4curation/gene_review/RuleActionEnum#UNDECIDED> a owl:Class,
        gene_review:RuleActionEnum ;
    rdfs:label "UNDECIDED" ;
    rdfs:subClassOf gene_review:RuleActionEnum ;
    skos:definition "Unable to determine appropriate action" .

<https://w3id.org/ai4curation/gene_review/RuleReviewStatusEnum#COMPLETE> a owl:Class,
        gene_review:RuleReviewStatusEnum ;
    rdfs:label "COMPLETE" ;
    rdfs:subClassOf gene_review:RuleReviewStatusEnum ;
    skos:definition "Review is complete" .

<https://w3id.org/ai4curation/gene_review/RuleReviewStatusEnum#IN_PROGRESS> a owl:Class,
        gene_review:RuleReviewStatusEnum ;
    rdfs:label "IN_PROGRESS" ;
    rdfs:subClassOf gene_review:RuleReviewStatusEnum ;
    skos:definition "Review is underway" .

<https://w3id.org/ai4curation/gene_review/RuleReviewStatusEnum#PENDING> a owl:Class,
        gene_review:RuleReviewStatusEnum ;
    rdfs:label "PENDING" ;
    rdfs:subClassOf gene_review:RuleReviewStatusEnum ;
    skos:definition "Review has not been started" .

<https://w3id.org/ai4curation/gene_review/RuleTypeEnum#ARBA> a owl:Class,
        gene_review:RuleTypeEnum ;
    rdfs:label "ARBA" ;
    rdfs:subClassOf gene_review:RuleTypeEnum ;
    skos:definition "Association-Rule-Based Annotator rule (automatically mined)" .

<https://w3id.org/ai4curation/gene_review/RuleTypeEnum#UNIRULE> a owl:Class,
        gene_review:RuleTypeEnum ;
    rdfs:label "UNIRULE" ;
    rdfs:subClassOf gene_review:RuleTypeEnum ;
    skos:definition "Expert-curated UniRule" .

<https://w3id.org/ai4curation/gene_review/SpecificityEnum#APPROPRIATE> a owl:Class,
        gene_review:SpecificityEnum ;
    rdfs:label "APPROPRIATE" ;
    rdfs:subClassOf gene_review:SpecificityEnum ;
    skos:definition "GO term specificity matches the evidence" .

<https://w3id.org/ai4curation/gene_review/SpecificityEnum#MISMATCHED> a owl:Class,
        gene_review:SpecificityEnum ;
    rdfs:label "MISMATCHED" ;
    rdfs:subClassOf gene_review:SpecificityEnum ;
    skos:definition "GO term is in wrong branch or aspect" .

<https://w3id.org/ai4curation/gene_review/SpecificityEnum#TOO_BROAD> a owl:Class,
        gene_review:SpecificityEnum ;
    rdfs:label "TOO_BROAD" ;
    rdfs:subClassOf gene_review:SpecificityEnum ;
    skos:definition "GO term is too general - a more specific term should be used" .

<https://w3id.org/ai4curation/gene_review/SpecificityEnum#TOO_NARROW> a owl:Class,
        gene_review:SpecificityEnum ;
    rdfs:label "TOO_NARROW" ;
    rdfs:subClassOf gene_review:SpecificityEnum ;
    skos:definition "GO term is overly specific for what the domains predict" .

gene_review:TaxonDescriptor a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "TaxonDescriptor" ;
    rdfs:subClassOf gene_review:Descriptor ;
    skos:definition "A descriptor for a taxon or taxonomic scope." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

<https://w3id.org/ai4curation/gene_review/TaxonomicScopeEnum#APPROPRIATE> a owl:Class,
        gene_review:TaxonomicScopeEnum ;
    rdfs:label "APPROPRIATE" ;
    rdfs:subClassOf gene_review:TaxonomicScopeEnum ;
    skos:definition "Taxonomic scope matches the domain's evolutionary distribution" .

<https://w3id.org/ai4curation/gene_review/TaxonomicScopeEnum#MISSING> a owl:Class,
        gene_review:TaxonomicScopeEnum ;
    rdfs:label "MISSING" ;
    rdfs:subClassOf gene_review:TaxonomicScopeEnum ;
    skos:definition "Rule lacks necessary taxonomic restriction" .

<https://w3id.org/ai4curation/gene_review/TaxonomicScopeEnum#TOO_BROAD> a owl:Class,
        gene_review:TaxonomicScopeEnum ;
    rdfs:label "TOO_BROAD" ;
    rdfs:subClassOf gene_review:TaxonomicScopeEnum ;
    skos:definition "Taxon is too inclusive - should be restricted further" .

<https://w3id.org/ai4curation/gene_review/TaxonomicScopeEnum#TOO_NARROW> a owl:Class,
        gene_review:TaxonomicScopeEnum ;
    rdfs:label "TOO_NARROW" ;
    rdfs:subClassOf gene_review:TaxonomicScopeEnum ;
    skos:definition "Taxon is overly restrictive - function applies more broadly" .

<https://w3id.org/ai4curation/gene_review/TaxonomicScopeEnum#UNNECESSARY> a owl:Class,
        gene_review:TaxonomicScopeEnum ;
    rdfs:label "UNNECESSARY" ;
    rdfs:subClassOf gene_review:TaxonomicScopeEnum ;
    skos:definition "Taxonomic restriction is not needed for this domain" .

<https://w3id.org/ai4curation/gene_review/VariantSelectionEnum#EXACTLY_ONE> a owl:Class,
        gene_review:VariantSelectionEnum ;
    rdfs:label "EXACTLY_ONE" ;
    rdfs:subClassOf gene_review:VariantSelectionEnum ;
    skos:definition "Exactly one variant applies." .

<https://w3id.org/ai4curation/gene_review/VariantSelectionEnum#ONE_OR_MORE> a owl:Class,
        gene_review:VariantSelectionEnum ;
    rdfs:label "ONE_OR_MORE" ;
    rdfs:subClassOf gene_review:VariantSelectionEnum ;
    skos:definition "One or more variants may apply." .

<https://w3id.org/ai4curation/gene_review/VariantSelectionEnum#ZERO_OR_MORE> a owl:Class,
        gene_review:VariantSelectionEnum ;
    rdfs:label "ZERO_OR_MORE" ;
    rdfs:subClassOf gene_review:VariantSelectionEnum ;
    skos:definition "Variants are optional and any number may apply." .

gene_review:active_units a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "active_units" ;
    skos:definition "Active units or role-bearing components of the complex. This is used to avoid leaving functionally important complex structure as prose." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:activity_reviews a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "activity_reviews" ;
    skos:definition "Per-activity (annoton) reviews." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:additional_reference_ids a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "additional_reference_ids" ;
    rdfs:range gene_review:Reference ;
    skos:definition "IDs of the references" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:aliases a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "aliases" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:alternative_products a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "alternative_products" ;
    rdfs:range gene_review:AlternativeProduct ;
    skos:definition "Alternative splicing products (isoforms) of the gene. Seeded from UniProt ALTERNATIVE PRODUCTS section. Only populated if there are multiple isoforms. Use this to document isoform-specific functions and biology. DEPRECATED: Use functional_isoforms instead for curated functional classes." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:ancestral_nodes a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ancestral_nodes" ;
    skos:definition "PANTHER/PAINT ancestral node(s) at which the associated function is inferred to have arisen (or to have been present in the last common ancestor). Unlike representative_members, which only give orienting examples, an ancestral node makes a clade-level evolutionary claim: extant descendants are inferred to retain the function unless there is evidence of divergence, neofunctionalization, or loss of key residues." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:annotons a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "annotons" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:appears_in_condition_sets a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "appears_in_condition_sets" ;
    skos:definition "Which condition sets (1-based) contain this entry (for domain conditions only)" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:asserted_predicted_go_terms a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "asserted_predicted_go_terms" ;
    skos:definition "GO terms that this entry maps to via external mappings (e.g., ipr2go). Only populated for external entries not in the rule's condition sets." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:cargo a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cargo" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:cell_types a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cell_types" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:cellular_components a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cellular_components" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:cofactors a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cofactors" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:concepts a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "concepts" ;
    skos:definition "Optional ontology/database grounding for this module node." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:condition_a_in_sets a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "condition_a_in_sets" ;
    skos:definition "List of 1-based condition set indices where condition A appears" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:condition_b_in_sets a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "condition_b_in_sets" ;
    skos:definition "List of 1-based condition set indices where condition B appears" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:condition_sets a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "condition_sets" ;
    skos:definition "List of condition sets (OR-ed together). Each condition set is a conjunction (AND) of conditions. The rule fires if ANY condition set matches." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:conforms_to a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "conforms_to" ;
    skos:definition "Reusable template motifs that this node (together with its parts and connections) is an instance of. Conformance is a compositional, bundle-scoped consistency check: a concrete cascade may freely extend its start and end, while an inner sub-bundle node declares that its parts match a generic motif (e.g. the three-tier MAP kinase relay)." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:connections a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "connections" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:core_functions a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "core_functions" ;
    rdfs:range gene_review:CoreFunction ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:developmental_stages a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "developmental_stages" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:deviations a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "deviations" ;
    skos:definition "Specific differences from the template (e.g. a missing or merged tier, a substituted function term). Listed deviations are treated as informational rather than errors during conformance QC." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:directly_involved_in a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "directly_involved_in" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:entries a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "entries" ;
    skos:definition "Entry-centric view of all entities in the rule (domain conditions and GO terms). Each entry tracks its relationships (PREDICTS, PREDICTED_BY, EQUIV) to other entries." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:existing_annotations a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "existing_annotations" ;
    rdfs:range gene_review:ExistingAnnotation ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:experts a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "experts" ;
    skos:definition "Experts to answer the question. These should be drawn from the authors of relevant publications already referenced. If no suitable experts are available, it's OK to leave this as an empty list!" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:extensions a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "extensions" ;
    rdfs:range gene_review:AnnotationExtension ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:failure_modes a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "failure_modes" ;
    skos:definition "Biological shape of the propagation issue. Multiple values are allowed when a case combines, for example, paralog transfer and functional divergence." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:family_terms a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "family_terms" ;
    skos:definition "Multiple family-level ontology/database groundings when this descriptor intentionally abstracts over more than one family, such as a conserved role split across multiple PANTHER PTHR families. Use the inherited term slot for the ordinary single-family case." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:findings a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "findings" ;
    rdfs:range gene_review:Finding ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:functional_isoforms a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "functional_isoforms" ;
    rdfs:range gene_review:FunctionalIsoform ;
    skos:definition "Curated functional isoform classes for the gene. Unlike alternative_products (which is seeded from UniProt), this field is purely curator/agent-defined to capture FUNCTIONALLY RELEVANT distinctions. Examples: - Splice classes that group multiple UniProt isoforms (e.g., WT1 +KTS vs -KTS) - Cleavage products from polyproteins (e.g., POMC peptides) - Modification states with distinct functions Only populate when there ARE functionally distinct forms worth documenting." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:gap_kind a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "gap_kind" ;
    skos:definition "The kind(s) of ignorance — biology, curation, and/or ontology — which determines who can resolve it. Multiple values denote a blend (e.g. a biology gap with an ontology shadow)." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:go_annotations a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "go_annotations" ;
    skos:definition "GO terms assigned by this rule" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:ids a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ids" ;
    skos:definition "UniProt identifiers belonging to this functional class. For UNIPROT_ISOFORM: P19544-1, P19544-2, etc. For UNIPROT_CHAIN: PRO_0000024969, PRO_0000024970, etc." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:inputs a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "inputs" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:isoform_specific_terms a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isoform_specific_terms" ;
    skos:definition "GO terms that are specific to this functional class. These are terms that should NOT be annotated to the gene as a whole, only to this specific form. Using Term objects enables linkml-term-validator checking." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:maps_to a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "maps_to" ;
    skos:definition "Mappings to underlying UniProt identifiers. Optional - some functional classes may not map cleanly to specific UniProt IDs." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:novel_annotations a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "novel_annotations" ;
    skos:definition "GO IDs not found in InterPro2GO for any rule condition" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:occurs_in a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "occurs_in" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:outputs a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "outputs" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:pairwise_overlap a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "pairwise_overlap" ;
    skos:definition "Pairwise overlap statistics for domain conditions in this set. Only computed for InterPro, FunFam, PANTHER conditions. Provides set difference metrics (uniqueness) and Jaccard similarity." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:parts a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "parts" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:predictions a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "predictions" ;
    skos:definition "List of predictions to review" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:processes a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "processes" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:products a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "products" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:proposed_mappings a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "proposed_mappings" ;
    skos:definition "Proposed mappings to equivalent terms in other ontologies" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:proposed_new_terms a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "proposed_new_terms" ;
    rdfs:range gene_review:ProposedOntologyTerm ;
    skos:definition "Proposed new ontology terms that should exist but don't" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:proposed_terms a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "proposed_terms" ;
    skos:definition "For ONTOLOGY gaps, the new ontology term(s) that would let the knowledge be expressed (e.g. \"structural constituent of complex X\"). May elaborate the gene's top-level proposed_new_terms." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:provenance a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "provenance" ;
    skos:definition "Evidence that the unknown is REAL and not merely uncurated — ideally the field's own admissions of ignorance (\"remains to be determined\", \"the precise role is unknown\"). The supporting_text is a verbatim substring of the cited reference and is checked by the reference validator exactly like supported_by. When the only available source is a DOI-only paper or a local analysis, anchor provenance to that reference_id (e.g. a file: path)." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:qc_flags a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "qc_flags" ;
    skos:definition "Specific GO-CAM best-practice issues observed for this activity." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:redundant_annotations a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "redundant_annotations" ;
    skos:definition "GO annotations that already exist in InterPro2GO" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:related_entries a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "related_entries" ;
    skos:definition "Relationships to other entries in the rule" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:representative_members a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "representative_members" ;
    skos:definition "Representative concrete members used to orient the family. These are examples, not an exhaustive member list and not a claim that the module is limited to these proteins." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:residue_claims a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "residue_claims" ;
    skos:definition """Machine-checkable form of a residue-level argument, e.g. "this protein lost the catalytic cysteine". Optional and additive: the vast majority of existing reviews state such arguments only in review.reason prose, and those are grandfathered, never invalidated. Supply this whenever a NEW review rests on residue gain, loss, or retention, so a validator can resolve the claim against the actual sequences and contradict it.
This exists because the argument is cheap to assert and hard to check. A survey of 17 "lacks the catalytic residue" claims in this repo found 4 where the site was fully intact -- CASP12 (truncated instead), LPA (activation junction), AZIN1 (lost substrate contacts, kept the catalytic Cys) and HSPA13 (a different domain). Each conclusion happened to survive for another reason, so nothing caught the faulty mechanism.""" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:sample_proteins a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sample_proteins" ;
    skos:definition "Sample UniProt IDs matching this condition. Only included when protein_count < 20 to avoid bloating files. Limited to max 10 examples." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:source_documents a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "source_documents" ;
    skos:definition "Paths to supporting source documents (e.g., reasoning traces, raw model outputs) for provenance" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:source_entities a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "source_entities" ;
    skos:definition "Source genes, gene products, PANTHER nodes, family nodes, or other source entities inspected for the propagated annotation." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:suggested_experiments a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "suggested_experiments" ;
    rdfs:range gene_review:Experiment ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:suggested_modifications a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "suggested_modifications" ;
    skos:definition "Specific modifications suggested if action is MODIFY" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:suggested_questions a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "suggested_questions" ;
    rdfs:range gene_review:Question ;
    skos:definition "Suggested questions to ask experts about the gene. Only include if not obvious from the literature." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:superseded_by a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "superseded_by" ;
    rdfs:range gene_review:Reference ;
    skos:definition "Reference(s) that dispute, correct, or overturn this finding. Used together with finding_status DISPUTED or OVERTURNED." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:supporting_entities a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "supporting_entities" ;
    rdfs:range linkml:String ;
    skos:definition "IDs of the supporting entities" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:tags a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "tags" ;
    rdfs:range linkml:String ;
    skos:definition "Tags associated with the gene for categorization and organization" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:targets a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "targets" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:taxa a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "taxa" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:variant_sets a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "variant_sets" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:variants a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "variants" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

IAO:0000326 a owl:Class,
        gene_review:ManuscriptSection ;
    rdfs:label "APPENDICES",
        "SUPPLEMENTARY_MATERIAL" ;
    rdfs:subClassOf gene_review:ManuscriptSection ;
    skos:definition "Appendices",
        "Supplementary material" ;
    gene_review:aliases "Appendix",
        "Supporting Information, Supplemental Data" ;
    gene_review:location "often online-only" ;
    gene_review:order 13,
        14 .

gene_review:GeneDescriptor a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "GeneDescriptor" ;
    rdfs:subClassOf gene_review:Descriptor ;
    skos:definition "A descriptor for a gene or locus." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:ModuleNode a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ModuleNode" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:ModuleTypeEnum ;
            owl:onProperty gene_review:module_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:ModuleConnection ;
            owl:onProperty gene_review:connections ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:connections ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:EvidenceItem ;
            owl:onProperty gene_review:evidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:concepts ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:annotons ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:ModuleContext ;
            owl:onProperty gene_review:context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:parts ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:gocam_associations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:ModuleAnnoton ;
            owl:onProperty gene_review:annotons ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Conformance ;
            owl:onProperty gene_review:conforms_to ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:module_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:notes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:knowledge_gaps ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:ModulePart ;
            owl:onProperty gene_review:parts ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:KnowledgeGap ;
            owl:onProperty gene_review:knowledge_gaps ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:ModuleVariantSet ;
            owl:onProperty gene_review:variant_sets ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:module_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:conforms_to ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:label ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:variant_sets ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:GoCamAssociation ;
            owl:onProperty gene_review:gocam_associations ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Descriptor ;
            owl:onProperty gene_review:concepts ] ;
    skos:definition "A node in a module. Nodes can be recursively decomposed using parts and variant_sets, and may also carry leaf annotons and connections." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:MolecularFunctionDescriptor a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "MolecularFunctionDescriptor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Descriptor ;
            owl:onProperty gene_review:products ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:destination_location ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:cargo ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:CellularComponentDescriptor ;
            owl:onProperty gene_review:destination_location ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:products ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:source_location ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:substrates ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Descriptor ;
            owl:onProperty gene_review:cofactors ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Descriptor ;
            owl:onProperty gene_review:cargo ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Descriptor ;
            owl:onProperty gene_review:targets ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:destination_location ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Descriptor ;
            owl:onProperty gene_review:substrates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:cofactors ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:CellularComponentDescriptor ;
            owl:onProperty gene_review:source_location ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:targets ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:source_location ],
        gene_review:Descriptor ;
    skos:definition "A descriptor for a molecular function. Extra slots capture common functional nuance without requiring formal post-composition." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:ProposedOntologyTerm a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ProposedOntologyTerm" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:proposed_mappings ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:proposed_definition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:proposed_parent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:proposed_definition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:supported_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Term ;
            owl:onProperty gene_review:proposed_parent ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:proposed_definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:SupportingTextInReference ;
            owl:onProperty gene_review:supported_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:justification ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:proposed_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:proposed_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:justification ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:proposed_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:proposed_parent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:justification ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:TermMapping ;
            owl:onProperty gene_review:proposed_mappings ] ;
    skos:definition "A proposed new ontology term that should exist but doesn't currently" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:Review a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Review" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:action ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:additional_reference_ids ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:reason ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Reference ;
            owl:onProperty gene_review:additional_reference_ids ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Term ;
            owl:onProperty gene_review:proposed_replacement_terms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:summary ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:supported_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:propagation_review ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:summary ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:summary ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:KnowledgeGap ;
            owl:onProperty gene_review:knowledge_gaps ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:knowledge_gaps ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:reason ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:reason ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:PropagationReview ;
            owl:onProperty gene_review:propagation_review ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:ActionEnum ;
            owl:onProperty gene_review:action ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:action ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:SupportingTextInReference ;
            owl:onProperty gene_review:supported_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:proposed_replacement_terms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:propagation_review ] ;
    skos:definition "A review of an existing annotation." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:a_minus_b_count a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "a_minus_b_count" ;
    skos:definition "Number of proteins in A but not in B (|A - B|). Represents the uniqueness of A with respect to B. High value = A adds unique coverage beyond B. Zero value = A is completely contained in B (A ⊆ B)." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:accession a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "accession" ;
    skos:definition "UniProt CURIE, e.g. UniProtKB:Q96PD5." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:action_rationale a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "action_rationale" ;
    skos:definition "Rationale for the recommended action" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:activity a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "activity" ;
    skos:definition "Optional activity/annoton id within the model that this element corresponds to, e.g. gomodel:568b0f9600000284/57ec3a7e00000079." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:activity_id a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "activity_id" ;
    skos:definition "Activity individual id within the model, e.g. gomodel:568b0f9600000284/57ec3a7e00000079." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:alignment_release a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "alignment_release" ;
    skos:definition """Version of the alignment *resource* the correspondence was taken from, when one exists -- e.g. "PANTHER 19.0" or "Pfam 37.0". A tool name or a script path is not a release and does not belong here; put that in comment.
Omit it for an alignment computed ad hoc. That is not a gap: the claim states both positions and both residues, so the alignment is only how the correspondence was *discovered*, while the evidence is the two sequence lookups the validator performs. Pinning matters for a shared resource whose coordinates can shift under you, not for a one-off computation.""" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:anchor a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "anchor" ;
    skos:definition "The comparator: a protein known to have the functional residue, and where." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:aspect a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "aspect" ;
    skos:definition "GO aspect (F, P, or C)" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:axis a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "axis" ;
    skos:definition "The dimension along which these variants differ, e.g. taxon, cell type, compartment, route, enzyme family." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:b_minus_a_count a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "b_minus_a_count" ;
    skos:definition "Number of proteins in B but not in A (|B - A|). Represents the uniqueness of B with respect to A. High value = B adds unique coverage beyond A. Zero value = B is completely contained in A (B ⊆ A)." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:biological_process a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "biological_process" ;
    skos:definition "part_of biological process GO id as cached, if any." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:boundary a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "boundary" ;
    skos:definition "What IS firmly established, so the gap is sharply delimited. The edge of current knowledge against which the gap is defined." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:cellular_component a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "cellular_component" ;
    skos:definition "occurs_in cellular component GO id as cached, if any." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:chaining_note a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "chaining_note" ;
    skos:definition "Free-text explanation for the chaining_status, e.g. why a break is a genuine knowledge gap, or which GO/RHEA mapping is missing." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:chaining_status a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "chaining_status" ;
    skos:definition "Curator adjudication of reaction continuity across this connection: whether the upstream reaction's product is the downstream reaction's substrate. This is an explicit override for the (advisory, non-blocking) automated chaining check, so a known gap can be acknowledged rather than re-reported each run. Leave unset to let the automated check report its finding." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:claim_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "claim_type" ;
    skos:definition "Whether the target lost, retained, or substituted the residue." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:condition_a a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "condition_a" ;
    skos:definition "First condition value (e.g., IPR005982)" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:condition_a_label a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "condition_a_label" ;
    skos:definition "Human-readable label for condition A" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:condition_b a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "condition_b" ;
    skos:definition "Second condition value (e.g., IPR008255)" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:condition_b_label a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "condition_b_label" ;
    skos:definition "Human-readable label for condition B" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:condition_overlap a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "condition_overlap" ;
    skos:definition "Assessment of overlap between rule conditions" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:condition_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "condition_type" ;
    skos:definition "Type of condition" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:confidence a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "confidence" ;
    skos:definition "Overall confidence in the rule (0.0 to 1.0)" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:confidence_score a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "confidence_score" ;
    skos:definition "Confidence score following de Crécy-Lagard et al. 2025: 2 = concordant with evidence, 1 = uncertain, 0 = discordant with evidence" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:connection_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "connection_type" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:consistency a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "consistency" ;
    skos:definition "How this activity relates to the gene's annotation review (genes/**/<gene>-ai-review.yaml)." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:containment a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "containment" ;
    skos:definition "Containment score (0-1) for the directional relationship. For PREDICTS: this_in_target (how much of this is contained in target). For PREDICTED_BY: target_in_this (how much of target is contained in this). For EQUIV: max of both directions." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:containment_a_in_b a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "containment_a_in_b" ;
    skos:definition "Proportion of A contained in B: |A ∩ B| / |A|. 1.0 means A is completely contained in B (A ⊆ B)." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:containment_b_in_a a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "containment_b_in_a" ;
    skos:definition "Proportion of B contained in A: |A ∩ B| / |B|. 1.0 means B is completely contained in A (B ⊆ A)." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:contributes_to_molecular_function a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "contributes_to_molecular_function" ;
    skos:definition "A molecular function that this gene product contributes to as part of a complex, but does not independently enable. Used for accessory/structural subunits of multi-protein complexes (e.g., an accessory subunit of Complex I contributes_to NADH dehydrogenase activity but does not have that activity on its own). The molecular_function slot should then contain the subunit-specific activity (e.g., structural molecule activity)." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:correctness a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "correctness" ;
    rdfs:range gene_review:ReferenceCorrectnessEnum ;
    skos:definition "Reviewer's overall assessment of a reference's trustworthiness - both citation correctness (the identifier resolves to the intended paper that supports its use) and scientific soundness of that paper's claim." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:count_a a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "count_a" ;
    skos:definition "Number of proteins matching condition A in specified database" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:count_b a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "count_b" ;
    skos:definition "Number of proteins matching condition B in specified database" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:created_date a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "created_date" ;
    skos:definition "Date the rule was created" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:curie a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "curie" ;
    skos:definition "Normalized CURIE form (e.g., InterPro:IPR000001, NCBITaxon:4751)" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:dark_aspect a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dark_aspect" ;
    skos:definition "Which GO aspect (or pattern) is dark for this gap. Most \"dark\" genes are not uniformly dark." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:destination_location a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "destination_location" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:domain a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "domain" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:ends_with a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ends_with" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:error_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "error_type" ;
    skos:definition "Type of error that led to the incorrect prediction, following Table 1 of de Crécy-Lagard et al. 2025" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:evidence_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "evidence_type" ;
    rdfs:range gene_review:EvidenceType ;
    skos:definition "Evidence code (e.g., IDA, IBA, ISS, TAS)" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:exclusive_count a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "exclusive_count" ;
    skos:definition "Number of proteins exclusive to the \"source\" of the relationship. For PREDICTS: proteins in this but not target. For PREDICTED_BY: proteins in target but not this. For EQUIV: proteins in this but not target (A - B)." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:experiment_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "experiment_type" ;
    skos:definition "Type of experiment or assay to answer the question" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:family a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "family" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:finding_review a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "finding_review" ;
    rdfs:range gene_review:FindingReview ;
    skos:definition "Manual reviewer assessment of this specific finding - in particular whether the finding remains current, is disputed, or has been overturned/superseded by later evidence. Reviewer-supplied; distinct from the statement/supporting_text that describe the finding itself." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:finding_status a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "finding_status" ;
    rdfs:range gene_review:FindingReviewStatusEnum ;
    skos:definition "Reviewer's assessment of the empirical standing of a specific finding in light of other evidence (e.g. whether it has been disputed or overturned)." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:gap_statement a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "gap_statement" ;
    skos:definition "The specific unknown, stated precisely. Not \"role unclear\" but e.g. \"the direct substrate / the catalytic activity / the essential partner is undetermined\"." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:gene a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "gene" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:gene_review a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "gene_review" ;
    skos:definition "Reference to the gene review compared against, e.g. file:human/TP53/TP53-ai-review.yaml." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:go_specificity a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "go_specificity" ;
    skos:definition "Assessment of GO term specificity" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:homolog_of a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "homolog_of" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:hypothesis a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "hypothesis" ;
    skos:definition "Hypothesis to be investigated" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:in_complex a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "in_complex" ;
    skos:definition "The protein-containing complex (GO:0032991 descendant) that this gene product is an active unit of. Use this — not locations — for complex membership (e.g. ribosome, spliceosome, EMC, signal peptidase complex)." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:interpretation a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "interpretation" ;
    skos:definition "Automated interpretation of overlap pattern" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:interpro_label a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "interpro_label" ;
    skos:definition "InterPro domain label" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:interpro_source a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "interpro_source" ;
    skos:definition "InterPro ID that already maps to this GO term in ipr2go" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:interpro_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "interpro_type" ;
    skos:definition "InterPro entry type (family, domain, active_site, etc.). Only populated for InterPro conditions (condition_type = INTERPRO). Extracted from InterPro metadata or API." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:ipr2go_redundancy a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ipr2go_redundancy" ;
    skos:definition "Analysis of redundancy with InterPro2GO mappings" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:is_invalid a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "is_invalid" ;
    rdfs:range linkml:Boolean ;
    skos:definition "Whether the reference is invalid (e.g., retracted or replaced)" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:isoform a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "isoform" ;
    rdfs:range linkml:String ;
    skos:definition "UniProt isoform identifier (e.g., \"P19544-1\" for WT1 isoform 1). Only populated when the annotation is specific to a particular isoform rather than the canonical protein sequence. Note that just because an experiment used a particular isoform doesn't mean the annotation is isoform-specific - it may apply to all isoforms. Use this field only when there is clear evidence the annotation is isoform-specific." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:justification a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "justification" ;
    skos:definition "Justification for why this term is needed" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:literature_support a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "literature_support" ;
    skos:definition "Assessment of literature support for the rule" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:locus_tag a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "locus_tag" ;
    skos:definition "Locus tag for the gene (e.g., b1267 for E. coli)" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:method a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "method" ;
    skos:definition "How the correspondence between anchor and target positions was established." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:modified_date a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "modified_date" ;
    skos:definition "Date the rule was last modified" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:module a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "module" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:module_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "module_type" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:node a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "node" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:number a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "number" ;
    skos:definition "1-based condition set number (CS1, CS2, CS3, etc.)" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:ontology a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ontology" ;
    rdfs:range linkml:String ;
    skos:definition "Ontology of the term. E.g `go`, `cl`, `hp`" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:optional a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "optional" ;
    skos:definition "Whether this part is optional in the parent module." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:order a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "order" ;
    skos:definition "Optional display or temporal order. Equal or absent values imply partial ordering only." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:original_reference_id a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "original_reference_id" ;
    rdfs:range gene_review:Reference ;
    skos:definition "ID of the original reference" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:ortholog_of a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ortholog_of" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:parsimony a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "parsimony" ;
    skos:definition "Assessment of rule parsimony (simplicity vs complexity)" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:position a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "position" ;
    skos:definition "1-based position in this protein's own sequence." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:predicted_term a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "predicted_term" ;
    skos:definition "The predicted term (GO term, EC number, etc.)" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:predicted_term_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "predicted_term_type" ;
    skos:definition "Type of predicted term (EC, GO_MF, GO_BP, GO_CC)" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:preferred_term a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "preferred_term" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:product_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "product_type" ;
    rdfs:range gene_review:ProductTypeEnum ;
    skos:definition "Type of gene product (protein, ncRNA, etc.)" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> ;
    skos:note "currently not required, assumed PROTEIN by default, but this may be explicit in future" .

gene_review:propagation_review a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "propagation_review" ;
    rdfs:range gene_review:PropagationReview ;
    skos:definition "Mechanical review metadata for annotations whose evidence depends on propagation or inference from source genes, family nodes, orthogroups, or other non-target evidence. Use this to classify source-side vs propagation-side failure modes without duplicating the prose rationale in review.reason." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:proposed_definition a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "proposed_definition" ;
    skos:definition "Proposed definition for the new term" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:proposed_name a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "proposed_name" ;
    skos:definition "Proposed name for the new term" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:proposed_parent a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "proposed_parent" ;
    skos:definition "Proposed parent term in the ontology hierarchy" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:proposed_replacement_terms a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "proposed_replacement_terms" ;
    rdfs:range gene_review:Term ;
    skos:definition "If the action is MODIFY, then this is a list of proposed replacement terms" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> ;
    skos:note "note there is a separate rule that this is required IF the action is MODIFY" .

gene_review:protein_complex a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "protein_complex" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:publication_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "publication_type" ;
    rdfs:range gene_review:PublicationTypeEnum ;
    skos:definition "The kind of publication or source this reference is (e.g. primary research article, review, meta-analysis, database record, AI deep-research report). For PMIDs this is normally inferred from the PubMed publication-type ('PT') metadata rather than set by hand; for non-PMID references (GO_REF, Reactome, file:) it is inferred from the identifier. Lets analyses ask, e.g., whether review articles or abstracts alone are sufficient to support a given annotation action." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:qualifier a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "qualifier" ;
    rdfs:range gene_review:AnnotationQualifierEnum ;
    skos:definition "The GO annotation qualifier specifying the relationship between the gene product and the term. For MF annotations, distinguishes 'enables' (gene product has the activity independently) from 'contributes_to' (gene product contributes to a complex's activity but does not have the activity alone). For BP, distinguishes 'involved_in', 'acts_upstream_of', etc. For CC, distinguishes 'located_in', 'part_of', 'is_active_in', 'colocalizes_with'." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:question a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "question" ;
    skos:definition "Question to be answered" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:reason a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reason" ;
    rdfs:range linkml:String ;
    skos:definition "Reason for the action" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:reference_id a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reference_id" ;
    rdfs:range gene_review:Reference ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:reference_review a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reference_review" ;
    rdfs:range gene_review:ReferenceReview ;
    skos:definition "Manual reviewer assessment of this reference (relevance, and citation correctness / scientific soundness). Reviewer-supplied, distinct from the machine-fetched id/title." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:relationship a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "relationship" ;
    skos:definition "Type of relationship" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:relevance a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "relevance" ;
    rdfs:range gene_review:ReferenceRelevanceEnum ;
    skos:definition "Reviewer judgment of how relevant the reference is to the gene's function and this review." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:required_domain a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "required_domain" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:required_function a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "required_function" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:residue a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "residue" ;
    skos:definition "Single-letter residue expected at that position. U and O are permitted for selenocysteine and pyrrolysine -- a catalytic position can legitimately be selenocysteine, as in SEPHS2." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:residue_claims_not_applicable a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "residue_claims_not_applicable" ;
    skos:definition "Why this annotation's argument cannot be expressed as a residue claim, for cases that are genuinely not point-residue questions -- capping versus severing (CAPG), holdase versus foldase (CRYAA), or a whole domain absent rather than residues substituted (MEFV, RAD51C). Recording the reason keeps the escape valve honest rather than silent." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:residues a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "residues" ;
    skos:definition "Residue range for cleavage products (e.g., \"138-176\" for ACTH). Only applicable for UNIPROT_CHAIN type." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:resolution a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "resolution" ;
    skos:definition "What would resolve the gap — the experiment, ontology term, or curation action. For ONTOLOGY gaps, pair with proposed_terms (or the gene's top-level proposed_new_terms)." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:retired a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "retired" ;
    rdfs:range linkml:Boolean ;
    skos:definition "Whether the annotation is retired or replaced" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:review_summary a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "review_summary" ;
    skos:definition "Overall summary of the review findings" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:reviewed_protein_count a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reviewed_protein_count" ;
    skos:definition "Number of reviewed (Swiss-Prot) proteins annotated by this rule" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:role_description a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "role_description" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:root_cause a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "root_cause" ;
    skos:definition "Where the issue lies, or that no issue was found: source annotation, propagation decision, term scoping, circular/redundant evidence, or no propagation failure." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:rule a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "rule" ;
    skos:definition "The embedded rule being reviewed" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:rule_id a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "rule_id" ;
    skos:definition "Original rule ID (e.g., ARBA00026249, UR000000070)" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:rule_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "rule_type" ;
    skos:definition "Type of rule (ARBA or UniRule)" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:scope a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "scope" ;
    skos:definition "Whether this module is a concrete biological realization or an abstract reusable motif/template. ABSTRACT modules are intentionally gene-free and are not expected to declare representative protein members for every leaf node." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:selection a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "selection" ;
    skos:definition "How many variants may be selected in a concrete realization." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:selector_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "selector_type" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:sequence_note a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sequence_note" ;
    rdfs:range linkml:String ;
    skos:definition "Brief note about sequence characteristics or differences" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:sequence_version a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sequence_version" ;
    skos:definition """UniProt sequence version (the SV in a P49903.2 style citation) the position was read against. Record it: an amino-acid sequence is not immutable. SEPHS2 is already on sequence version 3, and a corrected or re-chosen canonical sequence shifts every downstream position, so an unversioned claim can go silently wrong -- or worse, keep passing against a different residue that happens to match.
The validator compares this against the current record and, when they differ, says so explicitly rather than letting a stale claim look verified.""" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:significance a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "significance" ;
    skos:definition "Why closing this gap matters." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:site_ref a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "site_ref" ;
    skos:definition "Optional reference to a curated family-level residue site, as ``<family_id>#<site_id>`` (e.g. PANTHER:PTHR11022#zn_triad). When given, the validator additionally checks that the site exists in that family review and that the anchor position is one the site declares -- which is what stops a gene review and a family review drifting apart." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:source_label a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "source_label" ;
    skos:definition "Human-readable source label, such as a gene symbol or node label." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:source_location a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "source_location" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:source_method a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "source_method" ;
    skos:definition "Name of the prediction method (e.g., DeepECTF, PANTHER_IBA, InterPro2GO, CLEAN, GloEC, MAPred, ProteinInfer)" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:source_reference_id a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "source_reference_id" ;
    skos:definition "Reference for the prediction method or study (e.g., PMID:37820725 for the Kim et al. 2023 DeepECTF study)" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:source_status a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "source_status" ;
    skos:definition "Mechanical status of this source with respect to the target annotation." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:source_version a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "source_version" ;
    skos:definition "Version or date of the prediction method" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:starts_with a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "starts_with" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:stoichiometry a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "stoichiometry" ;
    skos:definition "Optional stoichiometry or copy-number statement when known." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:supporting_text_fulltext a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "supporting_text_fulltext" ;
    rdfs:range linkml:String ;
    skos:definition "Supporting text from the full-text PDF when the full text cannot be committed to the repository. This is an interim solution for cases where we have access to full text but cannot share it publicly. Unlike supporting_text, this field is not validated against cached publication text." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:target_id a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "target_id" ;
    skos:definition "ID of the related entry" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:target_term a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "target_term" ;
    skos:definition "The target term in another ontology" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:taxonomic_scope a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "taxonomic_scope" ;
    skos:definition "Assessment of taxonomic restriction appropriateness" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:template a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "template" ;
    skos:definition "Reference to the template, as a module path relative to modules/ with an optional node id after a hash (e.g. \"mapk_relay\" or \"mapk_relay#map2k\"). The referenced template defines the required steps, function terms, and connection topology this node must contain." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:uniqueness_score a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "uniqueness_score" ;
    skos:definition "Measure of domain uniqueness (0.0 to 1.0). Calculated as 1.0 - mean(containment in other domains in same condition set). High score = more unique/specific domain. Low score = broad domain that commonly co-occurs." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:unreviewed_protein_count a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "unreviewed_protein_count" ;
    skos:definition "Number of unreviewed (TrEMBL) proteins annotated by this rule" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:url a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "url" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:value a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "value" ;
    skos:definition "The condition value (e.g., IPR000001, NCBITaxon:4751)" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:verdict a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "verdict" ;
    skos:definition "Overall best-practice/evidence verdict for this activity (mirrors the OK / UNCERTAIN / WRONG forensic-review scale)." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:anatomical_locations a owl:ObjectProperty,
        linkml:SlotDefinition .

gene_review:conditions a owl:ObjectProperty,
        linkml:SlotDefinition .

gene_review:gocam_associations a owl:ObjectProperty,
        linkml:SlotDefinition .

gene_review:locations a owl:ObjectProperty,
        linkml:SlotDefinition .


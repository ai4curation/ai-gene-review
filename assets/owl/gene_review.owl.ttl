gene_review:ResidueClaimMethodEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "ResidueClaimMethodEnum" ;
    owl:unionOf ( <https://w3id.org/ai4curation/gene_review/ResidueClaimMethodEnum#MSA> <https://w3id.org/ai4curation/gene_review/ResidueClaimMethodEnum#STRUCTURE> <https://w3id.org/ai4curation/gene_review/ResidueClaimMethodEnum#UNIPROT_FEATURE> <https://w3id.org/ai4curation/gene_review/ResidueClaimMethodEnum#LITERATURE> ) ;
    skos:definition "How the anchor-to-target position correspondence was established." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> ;
    linkml:permissible_values <https://w3id.org/ai4curation/gene_review/ResidueClaimMethodEnum#LITERATURE>,
        <https://w3id.org/ai4curation/gene_review/ResidueClaimMethodEnum#MSA>,
        <https://w3id.org/ai4curation/gene_review/ResidueClaimMethodEnum#STRUCTURE>,
        <https://w3id.org/ai4curation/gene_review/ResidueClaimMethodEnum#UNIPROT_FEATURE> .

gene_review:SpecificityEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "SpecificityEnum" ;
    owl:unionOf ( <https://w3id.org/ai4curation/gene_review/SpecificityEnum#TOO_BROAD> <https://w3id.org/ai4curation/gene_review/SpecificityEnum#APPROPRIATE> <https://w3id.org/ai4curation/gene_review/SpecificityEnum#TOO_NARROW> <https://w3id.org/ai4curation/gene_review/SpecificityEnum#MISMATCHED> ) ;
    skos:definition "Assessment of GO term specificity" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> ;
    linkml:permissible_values <https://w3id.org/ai4curation/gene_review/SpecificityEnum#APPROPRIATE>,
        <https://w3id.org/ai4curation/gene_review/SpecificityEnum#MISMATCHED>,
        <https://w3id.org/ai4curation/gene_review/SpecificityEnum#TOO_BROAD>,
        <https://w3id.org/ai4curation/gene_review/SpecificityEnum#TOO_NARROW> .

gene_review:full_text_unavailable a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "full_text_unavailable" ;
    rdfs:range linkml:Boolean ;
    skos:definition "Whether the full text is unavailable" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:predicate a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "predicate" ;
    rdfs:range linkml:String ;
    skos:definition "Predicate of the extension" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:role a owl:ObjectProperty,
        linkml:SlotDefinition .

gene_review:term a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "term" ;
    rdfs:range gene_review:Term ;
    skos:definition "Term to be annotated" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:type a owl:ObjectProperty,
        linkml:SlotDefinition .

gene_review:ReferenceRelevanceEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "ReferenceRelevanceEnum" ;
    owl:unionOf ( <https://w3id.org/ai4curation/gene_review/ReferenceRelevanceEnum#HIGH> <https://w3id.org/ai4curation/gene_review/ReferenceRelevanceEnum#MEDIUM> <https://w3id.org/ai4curation/gene_review/ReferenceRelevanceEnum#LOW> <https://w3id.org/ai4curation/gene_review/ReferenceRelevanceEnum#NONE> ) ;
    skos:definition "Reviewer's assessment of how relevant a reference is to the gene's function and review." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> ;
    linkml:permissible_values <https://w3id.org/ai4curation/gene_review/ReferenceRelevanceEnum#HIGH>,
        <https://w3id.org/ai4curation/gene_review/ReferenceRelevanceEnum#LOW>,
        <https://w3id.org/ai4curation/gene_review/ReferenceRelevanceEnum#MEDIUM>,
        <https://w3id.org/ai4curation/gene_review/ReferenceRelevanceEnum#NONE> .

gene_review:knowledge_gaps a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "knowledge_gaps" ;
    rdfs:range gene_review:KnowledgeGap ;
    skos:definition "Curated, literature-grounded statements of what is NOT known — applicable at the level of the whole gene, a single existing annotation, a core function, a whole module, or a single module step/node. The inverse of core_functions: everywhere else the schema records what IS known; here it records, with the same evidentiary discipline, what is not. See the Function Knowledge Gaps project (projects/FUNCTION_KNOWLEDGE_GAPS.md)." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:references a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "references" ;
    rdfs:range gene_review:Reference ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:ChainingStatusEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "ChainingStatusEnum" ;
    owl:unionOf ( <https://w3id.org/ai4curation/gene_review/ChainingStatusEnum#VERIFIED> <https://w3id.org/ai4curation/gene_review/ChainingStatusEnum#KNOWLEDGE_GAP> <https://w3id.org/ai4curation/gene_review/ChainingStatusEnum#MAPPING_GAP> <https://w3id.org/ai4curation/gene_review/ChainingStatusEnum#NOT_APPLICABLE> <https://w3id.org/ai4curation/gene_review/ChainingStatusEnum#UNVERIFIED> ) ;
    skos:definition "Curator adjudication of reaction continuity across a module connection (whether the upstream reaction's product is consumed as the downstream reaction's substrate). Used as an explicit override for the advisory, non-blocking automated chaining check." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> ;
    linkml:permissible_values <https://w3id.org/ai4curation/gene_review/ChainingStatusEnum#KNOWLEDGE_GAP>,
        <https://w3id.org/ai4curation/gene_review/ChainingStatusEnum#MAPPING_GAP>,
        <https://w3id.org/ai4curation/gene_review/ChainingStatusEnum#NOT_APPLICABLE>,
        <https://w3id.org/ai4curation/gene_review/ChainingStatusEnum#UNVERIFIED>,
        <https://w3id.org/ai4curation/gene_review/ChainingStatusEnum#VERIFIED> .

gene_review:FunctionalIsoformTypeEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "FunctionalIsoformTypeEnum" ;
    owl:unionOf ( <https://w3id.org/ai4curation/gene_review/FunctionalIsoformTypeEnum#SPLICE_VARIANT> <https://w3id.org/ai4curation/gene_review/FunctionalIsoformTypeEnum#SPLICE_CLASS> <https://w3id.org/ai4curation/gene_review/FunctionalIsoformTypeEnum#CLEAVAGE_PRODUCT> <https://w3id.org/ai4curation/gene_review/FunctionalIsoformTypeEnum#MODIFICATION_STATE> <https://w3id.org/ai4curation/gene_review/FunctionalIsoformTypeEnum#CONFORMATIONAL_STATE> ) ;
    skos:definition "Type of functional isoform or product. Distinguishes between different mechanisms that produce functionally distinct forms of a gene product." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> ;
    linkml:permissible_values <https://w3id.org/ai4curation/gene_review/FunctionalIsoformTypeEnum#CLEAVAGE_PRODUCT>,
        <https://w3id.org/ai4curation/gene_review/FunctionalIsoformTypeEnum#CONFORMATIONAL_STATE>,
        <https://w3id.org/ai4curation/gene_review/FunctionalIsoformTypeEnum#MODIFICATION_STATE>,
        <https://w3id.org/ai4curation/gene_review/FunctionalIsoformTypeEnum#SPLICE_CLASS>,
        <https://w3id.org/ai4curation/gene_review/FunctionalIsoformTypeEnum#SPLICE_VARIANT> .

gene_review:GeneReviewStatusEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "GeneReviewStatusEnum" ;
    owl:unionOf ( <https://w3id.org/ai4curation/gene_review/GeneReviewStatusEnum#INITIALIZED> <https://w3id.org/ai4curation/gene_review/GeneReviewStatusEnum#IN_PROGRESS> <https://w3id.org/ai4curation/gene_review/GeneReviewStatusEnum#DRAFT> <https://w3id.org/ai4curation/gene_review/GeneReviewStatusEnum#COMPLETE> ) ;
    skos:definition "Status of the gene review process" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> ;
    linkml:permissible_values <https://w3id.org/ai4curation/gene_review/GeneReviewStatusEnum#COMPLETE>,
        <https://w3id.org/ai4curation/gene_review/GeneReviewStatusEnum#DRAFT>,
        <https://w3id.org/ai4curation/gene_review/GeneReviewStatusEnum#INITIALIZED>,
        <https://w3id.org/ai4curation/gene_review/GeneReviewStatusEnum#IN_PROGRESS> .

gene_review:KnowledgeGapAspectEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "KnowledgeGapAspectEnum" ;
    owl:unionOf ( <https://w3id.org/ai4curation/gene_review/KnowledgeGapAspectEnum#MF_DARK> <https://w3id.org/ai4curation/gene_review/KnowledgeGapAspectEnum#BP_DARK> <https://w3id.org/ai4curation/gene_review/KnowledgeGapAspectEnum#CC_DARK> <https://w3id.org/ai4curation/gene_review/KnowledgeGapAspectEnum#WHOLLY_DARK> <https://w3id.org/ai4curation/gene_review/KnowledgeGapAspectEnum#RESIDUAL_SUBGAP> ) ;
    skos:definition "Which GO aspect (or pattern) is dark for a knowledge gap. Most \"dark\" genes are not uniformly dark." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> ;
    linkml:permissible_values <https://w3id.org/ai4curation/gene_review/KnowledgeGapAspectEnum#BP_DARK>,
        <https://w3id.org/ai4curation/gene_review/KnowledgeGapAspectEnum#CC_DARK>,
        <https://w3id.org/ai4curation/gene_review/KnowledgeGapAspectEnum#MF_DARK>,
        <https://w3id.org/ai4curation/gene_review/KnowledgeGapAspectEnum#RESIDUAL_SUBGAP>,
        <https://w3id.org/ai4curation/gene_review/KnowledgeGapAspectEnum#WHOLLY_DARK> .

gene_review:LiteratureSupportEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "LiteratureSupportEnum" ;
    owl:unionOf ( <https://w3id.org/ai4curation/gene_review/LiteratureSupportEnum#STRONG> <https://w3id.org/ai4curation/gene_review/LiteratureSupportEnum#MODERATE> <https://w3id.org/ai4curation/gene_review/LiteratureSupportEnum#WEAK> <https://w3id.org/ai4curation/gene_review/LiteratureSupportEnum#NONE> <https://w3id.org/ai4curation/gene_review/LiteratureSupportEnum#CONTRADICTED> ) ;
    skos:definition "Level of literature support for the rule" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> ;
    linkml:permissible_values <https://w3id.org/ai4curation/gene_review/LiteratureSupportEnum#CONTRADICTED>,
        <https://w3id.org/ai4curation/gene_review/LiteratureSupportEnum#MODERATE>,
        <https://w3id.org/ai4curation/gene_review/LiteratureSupportEnum#NONE>,
        <https://w3id.org/ai4curation/gene_review/LiteratureSupportEnum#STRONG>,
        <https://w3id.org/ai4curation/gene_review/LiteratureSupportEnum#WEAK> .

gene_review:TaxonomicScopeEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "TaxonomicScopeEnum" ;
    owl:unionOf ( <https://w3id.org/ai4curation/gene_review/TaxonomicScopeEnum#TOO_BROAD> <https://w3id.org/ai4curation/gene_review/TaxonomicScopeEnum#APPROPRIATE> <https://w3id.org/ai4curation/gene_review/TaxonomicScopeEnum#TOO_NARROW> <https://w3id.org/ai4curation/gene_review/TaxonomicScopeEnum#MISSING> <https://w3id.org/ai4curation/gene_review/TaxonomicScopeEnum#UNNECESSARY> ) ;
    skos:definition "Assessment of taxonomic restriction appropriateness" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> ;
    linkml:permissible_values <https://w3id.org/ai4curation/gene_review/TaxonomicScopeEnum#APPROPRIATE>,
        <https://w3id.org/ai4curation/gene_review/TaxonomicScopeEnum#MISSING>,
        <https://w3id.org/ai4curation/gene_review/TaxonomicScopeEnum#TOO_BROAD>,
        <https://w3id.org/ai4curation/gene_review/TaxonomicScopeEnum#TOO_NARROW>,
        <https://w3id.org/ai4curation/gene_review/TaxonomicScopeEnum#UNNECESSARY> .

gene_review:EvidenceItem a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "EvidenceItem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:statement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:supporting_text ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:url ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:notes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:title ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:supporting_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:notes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:notes ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:source_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:supporting_text ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:statement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:statement ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:source_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:source_id ] ;
    skos:definition "A lightweight citable source for module-level assertions. The source may be a PMID, DOI, database record, local file, pathway record, issue, or any other citable artifact. When a literature source_id (PMID/DOI) is paired with a supporting_text, that quote is validated verbatim (normalized substring) against the cached publication by the project's module supporting-text check (ai_gene_review.validation.module_validator), using the same matcher as gene reviews; non-literature source_ids (GO, file:, Reactome, PANTHER, ...) carry no supporting_text quote and are not fetched." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:FindingReviewStatusEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "FindingReviewStatusEnum" ;
    owl:unionOf ( <https://w3id.org/ai4curation/gene_review/FindingReviewStatusEnum#CURRENT> <https://w3id.org/ai4curation/gene_review/FindingReviewStatusEnum#CORROBORATED> <https://w3id.org/ai4curation/gene_review/FindingReviewStatusEnum#DISPUTED> <https://w3id.org/ai4curation/gene_review/FindingReviewStatusEnum#OVERTURNED> <https://w3id.org/ai4curation/gene_review/FindingReviewStatusEnum#UNVERIFIED> ) ;
    skos:definition "Reviewer's assessment of the empirical standing of a specific finding (a statement extracted from a reference) in light of other evidence. Unlike ReferenceCorrectnessEnum, which judges a whole reference, this applies per finding: a paper may have some findings that stand and others that have been overturned. Use superseded_by to point to the reference(s) responsible." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> ;
    linkml:permissible_values <https://w3id.org/ai4curation/gene_review/FindingReviewStatusEnum#CORROBORATED>,
        <https://w3id.org/ai4curation/gene_review/FindingReviewStatusEnum#CURRENT>,
        <https://w3id.org/ai4curation/gene_review/FindingReviewStatusEnum#DISPUTED>,
        <https://w3id.org/ai4curation/gene_review/FindingReviewStatusEnum#OVERTURNED>,
        <https://w3id.org/ai4curation/gene_review/FindingReviewStatusEnum#UNVERIFIED> .

gene_review:SupportingTextInReference a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "SupportingTextInReference" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:reference_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:reference_section_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:full_text_unavailable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:supporting_text ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Reference ;
            owl:onProperty gene_review:reference_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:full_text_unavailable ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Boolean ;
            owl:onProperty gene_review:full_text_unavailable ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:supporting_text_fulltext ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:supporting_text_fulltext ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:supporting_text ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:supporting_text_fulltext ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:reference_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:reference_section_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:ManuscriptSection ;
            owl:onProperty gene_review:reference_section_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:supporting_text ] ;
    skos:definition "A supporting text in a reference." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:summary a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "summary" ;
    rdfs:range linkml:String ;
    skos:definition "Summary of the review" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:supporting_text a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "supporting_text" ;
    rdfs:range linkml:String ;
    skos:definition "Supporting text from the publication. This should be exact substrings. Different substrings can be broken up by '...'s. These substrings will be checked against the actual text of the paper. If editorialization is necessary, put this in square brackets (this is not checked). For example, you can say '...[CFAP300 shows] transport within cilia is IFT dependent...'" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:taxon a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "taxon" ;
    rdfs:range gene_review:Term ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:OverlapInterpretationEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "OverlapInterpretationEnum" ;
    owl:unionOf ( <https://w3id.org/ai4curation/gene_review/OverlapInterpretationEnum#REDUNDANT> <https://w3id.org/ai4curation/gene_review/OverlapInterpretationEnum#SUBSET> <https://w3id.org/ai4curation/gene_review/OverlapInterpretationEnum#HIGH_OVERLAP> <https://w3id.org/ai4curation/gene_review/OverlapInterpretationEnum#MODERATE> <https://w3id.org/ai4curation/gene_review/OverlapInterpretationEnum#LOW> <https://w3id.org/ai4curation/gene_review/OverlapInterpretationEnum#DISJOINT> ) ;
    skos:definition "Automated interpretation of domain overlap patterns" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> ;
    linkml:permissible_values <https://w3id.org/ai4curation/gene_review/OverlapInterpretationEnum#DISJOINT>,
        <https://w3id.org/ai4curation/gene_review/OverlapInterpretationEnum#HIGH_OVERLAP>,
        <https://w3id.org/ai4curation/gene_review/OverlapInterpretationEnum#LOW>,
        <https://w3id.org/ai4curation/gene_review/OverlapInterpretationEnum#MODERATE>,
        <https://w3id.org/ai4curation/gene_review/OverlapInterpretationEnum#REDUNDANT>,
        <https://w3id.org/ai4curation/gene_review/OverlapInterpretationEnum#SUBSET> .

gene_review:RuleActionEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "RuleActionEnum" ;
    owl:unionOf ( <https://w3id.org/ai4curation/gene_review/RuleActionEnum#ACCEPT> <https://w3id.org/ai4curation/gene_review/RuleActionEnum#MODIFY> <https://w3id.org/ai4curation/gene_review/RuleActionEnum#DEPRECATE> <https://w3id.org/ai4curation/gene_review/RuleActionEnum#SPLIT> <https://w3id.org/ai4curation/gene_review/RuleActionEnum#MERGE> <https://w3id.org/ai4curation/gene_review/RuleActionEnum#UNDECIDED> ) ;
    skos:definition "Recommended action for the rule" ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> ;
    linkml:permissible_values <https://w3id.org/ai4curation/gene_review/RuleActionEnum#ACCEPT>,
        <https://w3id.org/ai4curation/gene_review/RuleActionEnum#DEPRECATE>,
        <https://w3id.org/ai4curation/gene_review/RuleActionEnum#MERGE>,
        <https://w3id.org/ai4curation/gene_review/RuleActionEnum#MODIFY>,
        <https://w3id.org/ai4curation/gene_review/RuleActionEnum#SPLIT>,
        <https://w3id.org/ai4curation/gene_review/RuleActionEnum#UNDECIDED> .

gene_review:Reference a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Reference" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom linkml:Boolean ;
            owl:onProperty gene_review:full_text_unavailable ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:title ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:ReferenceReview ;
            owl:onProperty gene_review:reference_review ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:publication_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:is_invalid ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:publication_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:reference_review ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Finding ;
            owl:onProperty gene_review:findings ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:is_invalid ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Boolean ;
            owl:onProperty gene_review:is_invalid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:PublicationTypeEnum ;
            owl:onProperty gene_review:publication_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:findings ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:full_text_unavailable ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:reference_review ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:full_text_unavailable ] ;
    skos:definition "A reference is a published text  that describes a finding or a method. References might be formal publications (where the ID is a PMID), or for methods, a GO_REF. Additionally, a reference to a local ad-hoc analysis or review can be made by using the `file:` prefix." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:ReferenceCorrectnessEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "ReferenceCorrectnessEnum" ;
    owl:unionOf ( <https://w3id.org/ai4curation/gene_review/ReferenceCorrectnessEnum#VERIFIED> <https://w3id.org/ai4curation/gene_review/ReferenceCorrectnessEnum#UNVERIFIED> <https://w3id.org/ai4curation/gene_review/ReferenceCorrectnessEnum#WRONG_IDENTIFIER> <https://w3id.org/ai4curation/gene_review/ReferenceCorrectnessEnum#MISCITED> <https://w3id.org/ai4curation/gene_review/ReferenceCorrectnessEnum#DISPUTED> <https://w3id.org/ai4curation/gene_review/ReferenceCorrectnessEnum#LOW_QUALITY> ) ;
    skos:definition "Reviewer's overall manual assessment of a reference's trustworthiness, spanning both citation correctness (does the identifier point to the intended paper that supports its use) and scientific soundness (is that paper's claim reliable). Single-valued: record the most salient issue and elaborate in review_notes. Complements is_invalid (retracted/replaced) and full_text_unavailable." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> ;
    linkml:permissible_values <https://w3id.org/ai4curation/gene_review/ReferenceCorrectnessEnum#DISPUTED>,
        <https://w3id.org/ai4curation/gene_review/ReferenceCorrectnessEnum#LOW_QUALITY>,
        <https://w3id.org/ai4curation/gene_review/ReferenceCorrectnessEnum#MISCITED>,
        <https://w3id.org/ai4curation/gene_review/ReferenceCorrectnessEnum#UNVERIFIED>,
        <https://w3id.org/ai4curation/gene_review/ReferenceCorrectnessEnum#VERIFIED>,
        <https://w3id.org/ai4curation/gene_review/ReferenceCorrectnessEnum#WRONG_IDENTIFIER> .


gene_review:Descriptor a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Descriptor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:term ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:preferred_term ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:Term ;
            owl:onProperty gene_review:term ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:evidence ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:notes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:term ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gene_review:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom gene_review:EvidenceItem ;
            owl:onProperty gene_review:evidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gene_review:preferred_term ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gene_review:preferred_term ] ;
    skos:definition "A human-friendly descriptor with optional ontology/database grounding. The preferred_term may be more nuanced than the term label, and the term may be absent when no good identifier exists yet." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> .

gene_review:PublicationTypeEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "PublicationTypeEnum" ;
    owl:unionOf ( <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#PRIMARY_RESEARCH> <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#REVIEW> <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#SYSTEMATIC_REVIEW> <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#META_ANALYSIS> <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#COMMENT_EDITORIAL> <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#CASE_REPORT> <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#PREPRINT> <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#DATABASE> <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#BIOINFORMATICS> <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#DEEP_RESEARCH> <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#OTHER> <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#UNKNOWN> ) ;
    skos:definition "The kind of publication or source a reference is. For PMIDs this is inferred from the PubMed publication-type ('PT') metadata; for non-literature references it is inferred from the identifier scheme. Used to test hypotheses about which evidence sources (primary papers, reviews, abstracts, deep research) suffice for GO annotation review." ;
    skos:inScheme <https://ai4curation.io/ai-gene-review> ;
    linkml:permissible_values <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#BIOINFORMATICS>,
        <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#CASE_REPORT>,
        <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#COMMENT_EDITORIAL>,
        <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#DATABASE>,
        <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#DEEP_RESEARCH>,
        <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#META_ANALYSIS>,
        <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#OTHER>,
        <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#PREPRINT>,
        <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#PRIMARY_RESEARCH>,
        <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#REVIEW>,
        <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#SYSTEMATIC_REVIEW>,
        <https://w3id.org/ai4curation/gene_review/PublicationTypeEnum#UNKNOWN> .

gene_review:ManuscriptSection a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "ManuscriptSection" ;
    owl:unionOf ( IAO:0000305 IAO:0000315 IAO:0000630 IAO:0000316 IAO:0000639 IAO:0000317 IAO:0000318 IAO:0000319 IAO:0000615 IAO:0000326 IAO:0000326 <https://w3id.org/ai4curation/gene_review/ManuscriptSection#DATABASE_ENTRY> <https://w3id.org/ai4curation/gene_review/ManuscriptSection#OTHER> ) ;

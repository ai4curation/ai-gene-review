        gene_review:EvidenceType ;
    rdfs:label "ISA" ;
    rdfs:subClassOf gene_review:EvidenceType ;
    skos:definition "Inferred from Sequence Alignment" .

ECO:0000250 a owl:Class,
        gene_review:EvidenceType ;

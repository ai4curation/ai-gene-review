gene_review:PropagationFailureModeEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "PropagationFailureModeEnum" ;
    owl:unionOf ( <https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#WRONG_ORTHOLOG_OR_PARALOG> <https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#FUNCTIONAL_DIVERGENCE> <https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#PSEUDO_OR_SUBACTIVITY_LOSS> <https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#CONTEXT_OR_TISSUE_MISMATCH> <https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#LINEAGE_OR_TAXON_MISMATCH> <https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#COMPARTMENT_OR_COMPLEX_MISMATCH> <https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#REGULATORY_SIGN_INVERSION> <https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#ROLE_CONFLATION> <https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#GRANULARITY_MISMATCH> <https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#SOURCE_MISCITATION> <https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#SOURCE_EVIDENCE_WEAK> <https://w3id.org/ai4curation/gene_review/PropagationFailureModeEnum#CIRCULAR_PROPAGATION> ) ;

  "go_definitions": {
    "GO:0007186": {
      "name": "G protein-coupled receptor signaling pathway",
      "definition": {
        "text": "The series of molecular signals initiated by a ligand binding to its receptor, in which the activated receptor promotes the exchange of GDP for GTP on the alpha-subunit of an associated heterotrimeric G-protein complex. The GTP-bound activated alpha-G-protein then dissociates from the beta- and gamma-subunits to further transmit the signal within the cell. The pathway begins with receptor-ligand interaction, and ends with regulation of a downstream cellular process. The pathway can start from the plasma membrane, Golgi or nuclear membrane.",
        "xrefs": [
          {
            "dbCode": "PMID",
            "dbId": "16902576"
          },
          {
            "dbCode": "PMID",
            "dbId": "24568158"
          },
          {
            "dbCode": "Wikipedia",
            "dbId": "G_protein-coupled_receptor"
          }
        ]
      },
      "is_obsolete": false,
      "source_url": "https://www.ebi.ac.uk/QuickGO/services/ontology/go/terms/GO:0007186"
    },
    "GO:0019395": {
      "name": "fatty acid oxidation",
      "definition": {
        "text": "The removal of one or more electrons from a fatty acid, with or without the concomitant removal of a proton or protons, by reaction with an electron-accepting substance, by addition of oxygen or by removal of hydrogen.",
        "xrefs": [
          {
            "dbCode": "ISBN",
            "dbId": "0198506732"
          }
        ]
      },
      "is_obsolete": false,
      "source_url": "https://www.ebi.ac.uk/QuickGO/services/ontology/go/terms/GO:0019395"
    },
    "GO:0009584": {
      "name": "detection of visible light",
      "definition": {
        "text": "The series of events in which a visible light stimulus is received by a cell and converted into a molecular signal. A visible light stimulus is electromagnetic radiation that can be perceived visually by an organism; for organisms lacking a visual system, this can be defined as light with a wavelength within the range 380 to 780 nm.",
        "xrefs": [
          {
            "dbCode": "ISBN",
            "dbId": "0198506732"
          }
        ]
      },
      "is_obsolete": false,
      "source_url": "https://www.ebi.ac.uk/QuickGO/services/ontology/go/terms/GO:0009584"
    },
    "GO:0007601": {
      "name": "visual perception",
      "definition": {
        "text": "The series of events required for an organism to receive a visual stimulus, convert it to a molecular signal, and recognize and characterize the signal. Visual stimuli are detected in the form of photons and are processed to form an image."
      },
      "is_obsolete": false,
      "source_url": "https://www.ebi.ac.uk/QuickGO/services/ontology/go/terms/GO:0007601"
    },
    "GO:0033539": {
      "name": "fatty acid beta-oxidation using acyl-CoA dehydrogenase",
      "definition": {
        "text": "A fatty acid beta-oxidation pathway in which the initial step of each oxidation cycle, which converts an acyl-CoA to a trans-2-enoyl-CoA, is catalyzed by acyl-CoA dehydrogenase; the electrons removed by oxidation pass through the respiratory chain to oxygen and leave H2O as the product. Fatty acid beta-oxidation begins with the addition of coenzyme A to a fatty acid, and ends when only two or three carbons remain (as acetyl-CoA or propionyl-CoA respectively).",
        "xrefs": [
          {
            "dbCode": "MetaCyc",
            "dbId": "FAO-PWY"
          }
        ]
      },
      "is_obsolete": false,
      "source_url": "https://www.ebi.ac.uk/QuickGO/services/ontology/go/terms/GO:0033539"
    },
    "GO:0000062": {
      "name": "fatty-acyl-CoA binding",
      "definition": {
        "text": "Binding to a fatty-acyl-CoA, any derivative of coenzyme A in which the sulfhydryl group is in thiolester linkage with a fatty acyl group.",
        "xrefs": [
          {
            "dbCode": "ISBN",
            "dbId": "0198506732"
          }
        ]
      },
      "is_obsolete": false,
      "source_url": "https://www.ebi.ac.uk/QuickGO/services/ontology/go/terms/GO:0000062"
    },
    "GO:0007602": {
      "name": "phototransduction",
      "definition": {
        "text": "The sequence of reactions within a cell required to convert absorbed photons into a molecular signal."
      },
      "is_obsolete": false,
      "source_url": "https://www.ebi.ac.uk/QuickGO/services/ontology/go/terms/GO:0007602"
    },
    "GO:0046949": {
      "name": "fatty-acyl-CoA biosynthetic process",
      "definition": {
        "text": "The chemical reactions and pathways resulting in the formation of a fatty-acyl-CoA, any derivative of coenzyme A in which the sulfhydryl group is in thiolester linkage with a fatty-acyl group.",
        "xrefs": [
          {
            "dbCode": "ISBN",
            "dbId": "0198506732"
          }
        ]
      },
      "is_obsolete": false,
      "source_url": "https://www.ebi.ac.uk/QuickGO/services/ontology/go/terms/GO:0046949"
    },
    "GO:0008020": {
      "name": "G protein-coupled photoreceptor activity",
      "definition": {
        "text": "Combining with incidental electromagnetic radiation, particularly visible light, and transmitting the signal across the membrane by activating an associated G-protein; promotes the exchange of GDP for GTP on the alpha subunit of a heterotrimeric G-protein complex.",
        "xrefs": [
          {
            "dbCode": "ISBN",
            "dbId": "0198506732"
          }
        ]
      },
      "is_obsolete": false,
      "source_url": "https://www.ebi.ac.uk/QuickGO/services/ontology/go/terms/GO:0008020"
    },
    "GO:0071482": {
      "name": "cellular response to light stimulus",
      "definition": {
        "text": "Any process that results in a change in state or activity of a cell (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a light stimulus, electromagnetic radiation of wavelengths classified as infrared, visible or ultraviolet light."
      },
      "is_obsolete": false,
      "source_url": "https://www.ebi.ac.uk/QuickGO/services/ontology/go/terms/GO:0071482"
    },
    "GO:0001523": {
      "name": "retinoid metabolic process",
      "definition": {
        "text": "The chemical reactions and pathways involving retinoids, any member of a class of isoprenoids that contain or are derived from four prenyl groups linked head-to-tail. Retinoids include retinol and retinal and structurally similar natural derivatives or synthetic compounds, but need not have vitamin A activity.",
        "xrefs": [
          {
            "dbCode": "ISBN",
            "dbId": "0198506732"
          }
        ]
      },
      "is_obsolete": false,
      "source_url": "https://www.ebi.ac.uk/QuickGO/services/ontology/go/terms/GO:0001523"
    },
    "GO:0004930": {
      "name": "G protein-coupled receptor activity",
      "definition": {
        "text": "Combining with an extracellular signal and transmitting the signal across the membrane by activating an associated G-protein; promotes the exchange of GDP for GTP on the alpha subunit of a heterotrimeric G-protein complex.",
        "xrefs": [
          {
            "dbCode": "Wikipedia",
            "dbId": "GPCR"
          }
        ]
      },
      "is_obsolete": false,
      "source_url": "https://www.ebi.ac.uk/QuickGO/services/ontology/go/terms/GO:0004930"
    }

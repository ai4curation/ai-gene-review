set working-directory := "../../.."

# Offline rebuild from committed normalized sources and local gene reviews.
[positional-arguments]
build *args:
    uv run python projects/P_PUTIDA/build_tf_census.py "$@"

# Re-extract cached sources; fetch only missing downloads. Use a new cache to refresh.
[positional-arguments]
fetch *args:
    uv run python projects/P_PUTIDA/fetch_tf_census_sources.py "$@"

check:
    uv run pytest -q tests/test_putida_tf_census.py tests/test_imodulondb.py tests/test_putida_regulatory_evidence.py
    uv run ruff check projects/P_PUTIDA/build_tf_census.py projects/P_PUTIDA/fetch_tf_census_sources.py projects/P_PUTIDA/calibrate_tf_imodulons.py projects/P_PUTIDA/validate_regulatory_evidence.py src/ai_gene_review/imodulondb.py tests/test_putida_tf_census.py tests/test_imodulondb.py tests/test_putida_regulatory_evidence.py

# Regenerate importer assessments/reports from the checked committed export.
calibrate:
    uv run python projects/P_PUTIDA/calibrate_tf_imodulons.py
    uv run python projects/P_PUTIDA/build_tf_census.py

  "added_annotations": [
    {
      "gene": "PSEFR/fadA",
      "row": {
        "term": {
          "id": "GO:0036125",
          "label": "fatty acid beta-oxidation multienzyme complex"
        },
        "evidence_type": "IDA",
        "original_reference_id": "PMID:15229654",
        "review": {
          "action": "NEW",
          "summary": "The protein is a structurally resolved TFE subunit.",
          "reason": "Sequence-matched PDB 1WDL and the primary complex structure establish physical membership of the alpha2beta2 enzyme. This adds a complex location absent from the seed, not a redundant cellular location or an untested pathway completion claim.",
          "supported_by": [
            {
              "reference_id": "PMID:9396725",
              "supporting_text": "The HDT complex, reconstituted in vitro from the isolated alpha- and\nbeta-subunits, exhibits the three original enzymic activities"
            }
          ]
        }
      },
      "independent_verdict": "SUPPORTED_WITH_STATED_LIMITS",
      "independent_reason": "Supported physical membership: exact P28790/P28793 structure mapping and alpha/beta reconstitution. Catalytic FadA enables chemistry within assembled complex does not assert isolated-beta autonomy."
    },
    {
      "gene": "MYCTU/fadA",
      "row": {
        "term": {
          "id": "GO:0036125",
          "label": "fatty acid beta-oxidation multienzyme complex"
        },
        "evidence_type": "IDA",
        "original_reference_id": "PMID:23496842",
        "review": {
          "action": "NEW",
          "summary": "The protein is a structurally resolved TFE subunit.",
          "reason": "Sequence-matched PDB 4B3H and the primary complex structure establish physical membership of the alpha2beta2 enzyme. This adds a complex location absent from the seed, not a redundant cellular location or an untested pathway completion claim.",
          "supported_by": [
            {
              "reference_id": "PMID:23496842",
              "supporting_text": "TFE is an α(2)β(2) complex"
            }
          ]
        }
      },
      "independent_verdict": "SUPPORTED_WITH_STATED_LIMITS",
      "independent_reason": "Supported physical membership of sequence-matched H37Rv alpha2beta2 TFE (4B3H). Distinct alpha/beta architecture does not establish a matched initial dehydrogenase."
    },
    {
      "gene": "MYCTU/fadA",
      "row": {
        "term": {
          "id": "GO:0006635",
          "label": "fatty acid beta-oxidation"
        },
        "evidence_type": "IC",
        "original_reference_id": "PMID:34371166",
        "review": {
          "action": "NEW",
          "summary": "FadA performs the thiolytic step of fatty-acid beta-oxidation.",
          "reason": "The beta chain supplies the KAT active center; matched-complex assays show CoA-triggered cleavage of C10/C16 ketoacyl-CoAs. It therefore performs pathway chemistry rather than merely being necessary. GO:0006635 is a fatty-acid catabolic process; no other BP exists in the seed or proposals. Same-role Ecoli FadA P21151 carries this BP with IDA/IMP/IBA and Pfr FadA P28790 with IEA; these query results establish convention, not biochemical evidence. No target GO-CAM index entry was found. The inferred participation does not imply a complete native oxidation route or identify its first-step dehydrogenase.",
          "supported_by": [
            {
              "reference_id": "file:genes/MYCTU/fadB/fadB-source-analysis/primary-scope.md",
              "supporting_text": "This qualitative thiolase assay showed activity when testing for degradation of 3-ketodecanoyl-CoA and 3-ketohexadecanoyl-CoA."
            }
          ]
        }
      },
      "independent_verdict": "SUPPORTED_WITH_STATED_LIMITS",
      "independent_reason": "Supported IC participation through the beta-chain KAT catalytic center and actual matched-complex C10/C16 ketoacyl-CoA cleavage. The review documents same-role comparators, parents and no overlapping BP/GO-CAM. Not a native complete-oxidation assertion."
    },
    {
      "gene": "MYCTU/fadB",
      "row": {
        "term": {
          "id": "GO:0036125",
          "label": "fatty acid beta-oxidation multienzyme complex"
        },
        "evidence_type": "IDA",
        "original_reference_id": "PMID:23496842",
        "review": {
          "action": "NEW",
          "summary": "The protein is a structurally resolved TFE subunit.",
          "reason": "Sequence-matched PDB 4B3H and the primary complex structure establish physical membership of the alpha2beta2 enzyme. This adds a complex location absent from the seed, not a redundant cellular location or an untested pathway completion claim.",
          "supported_by": [
            {
              "reference_id": "PMID:23496842",

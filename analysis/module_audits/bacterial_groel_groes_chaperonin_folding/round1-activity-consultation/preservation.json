  "changed_reviews": [
    {
      "file": "genes/MYCTU/groEL2/groEL2-ai-review.yaml",
      "index": 1,
      "term": "GO:0005515",
      "reference": "PMID:12198306",
      "before_action": "REMOVE",
      "after_action": "MODIFY",
      "reason": "The reported self-partner and asymmetric-unit dimer are consistent with identical-protein association. Crystal packing alone would not establish a native dimer, but PMID15327959 independently reports lower oligomers in biochemical characterization, and curated UniProt SUBUNIT records dimeric and other assemblies. Refine the generic binding row to GO0042802 rather than discard the supported self-association. This does not assign a fixed physiological stoichiometry or treat the Mtb assembly as equivalent to the E. coli tetradecamer."
    },
    {
      "file": "genes/MYCTU/groEL2/groEL2-ai-review.yaml",
      "index": 24,
      "term": "GO:0044183",
      "reference": "GO_REF:0000104",
      "before_action": "ACCEPT",
      "after_action": "ACCEPT",
      "reason": "Retain this parent specifically to cover the experimentally observed non-ATP folding mode: PMID15327959 reports partial substrate refolding by lower oligomers without ATP or GroES. GO0140662 captures the ATP-dependent mode but does not entail this distinct observed capacity; the broader GO0044183 therefore contributes information beyond a redundant parent annotation. No particular native oligomer or physiological dominance of the non-ATP mode is inferred."
    },
    {
      "file": "genes/ECOLI/groS/groS-ai-review.yaml",
      "index": 32,
      "term": "GO:0046872",
      "reference": "GO_REF:0000033",
      "before_action": "KEEP_AS_NON_CORE",
      "after_action": "MARK_AS_OVER_ANNOTATED",
      "reason": "PAINT places metal binding at PTN000080668 from valid mycobacterial Cpn10 evidence; the donor count is not the concern. PMID12837792 shows an E. coli GroES size shift at 20 mM CaCl2, an indirect assembly response rather than a binding-site or affinity measurement. The Mtb roof loop has additional acidic residues and directly observed coordination, while the corresponding E. coli Glu53 site is proposed. Together these limits make transfer of that binding property less secure than KEEP_AS_NON_CORE implied. MARK_AS_OVER_ANNOTATED preserves the real in vitro response while flagging the stronger target binding assertion. High calcium concentration alone does not prove an artifact, and no absence of binding or physiological calcium control is asserted."
    }
  ]

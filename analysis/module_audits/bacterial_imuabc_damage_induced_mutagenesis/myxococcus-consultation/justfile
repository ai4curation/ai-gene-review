set working-directory := "../../../.."

download-genome:
    curl --fail --location 'https://www.ebi.ac.uk/ena/browser/api/embl/CP000113.1?download=false' --output .cache/module-audit-logs/imuabc-20261107/myxococcus/CP000113.1.embl

identity:
    uv run --with biopython==1.85 python analysis/module_audits/bacterial_imuabc_damage_induced_mutagenesis/myxococcus-consultation/match_primary_sequence.py --genome .cache/module-audit-logs/imuabc-20261107/myxococcus/CP000113.1.embl --queries analysis/module_audits/bacterial_imuabc_damage_induced_mutagenesis/myxococcus-consultation/primary-promoter-queries.json --uniprot genes/MYXXD/MXAN_3991/MXAN_3991-uniprot.txt --output analysis/module_audits/bacterial_imuabc_damage_induced_mutagenesis/myxococcus-consultation/identity-results.json

preserve:
    uv run python analysis/module_audits/bacterial_imuabc_damage_induced_mutagenesis/myxococcus-consultation/preserve.py

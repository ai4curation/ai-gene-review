{"results":[{"entryType":"UniProtKB reviewed (Swiss-Prot)","primaryAccession":"O75648","secondaryAccessions":["A8K3U7","Q05C99","Q5W9C8","Q66K31","Q6ICC3","Q9NWC1"],"uniProtkbId":"MTU1_HUMAN","entryAudit":{"firstPublicDate":"2000-05-30","lastAnnotationUpdateDate":"2026-11-04","lastSequenceUpdateDate":"1999-05-01","entryVersion":178,"sequenceVersion":2},"annotationScore":5.0,"organism":{"scientificName":"Homo sapiens","commonName":"Human","taxonId":9606,"lineage":["Eukaryota","Metazoa","Chordata","Craniata","Vertebrata","Euteleostomi","Mammalia","Eutheria","Euarchontoglires","Primates","Haplorrhini","Catarrhini","Hominidae","Homo"]},"proteinExistence":"1: Evidence at protein level","proteinDescription":{"recommendedName":{"fullName":{"value":"Mitochondrial tRNA-specific 2-thiouridylase 1"},"ecNumbers":[{"evidences":[{"evidenceCode":"ECO:0000305","source":"PubMed","id":"15509579"}],"value":"2.8.1.14"}]},"alternativeNames":[{"fullName":{"value":"MTO2 homolog"}}]},"genes":[{"geneName":{"value":"TRMU"},"synonyms":[{"value":"MTU1"},{"value":"TRMT1"}]}],"comments":[{"texts":[{"evidences":[{"evidenceCode":"ECO:0000269","source":"PubMed","id":"15509579"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"15944150"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"16826519"}],"value":"Catalyzes the 2-thiolation of uridine at the wobble position (U34) of mitochondrial tRNA(Lys), tRNA(Glu) and tRNA(Gln). Required for the formation of 5-taurinomethyl-2-thiouridine (tm5s2U) of mitochondrial tRNA(Lys), tRNA(Glu), and tRNA(Gln) at the wobble position. ATP is required to activate the C2 atom of the wobble base"}],"commentType":"FUNCTION"},{"commentType":"CATALYTIC ACTIVITY","reaction":{"name":"5-taurinomethyluridine(34) in tRNA + S-sulfanyl-L-cysteinyl-[protein] + AH2 + ATP = 5-taurinomethyl-2-thiouridine(34) in tRNA + L-cysteinyl-[protein] + A + AMP + diphosphate + H(+)","reactionCrossReferences":[{"database":"Rhea","id":"RHEA:47040"},{"database":"Rhea","id":"RHEA-COMP:10131"},{"database":"Rhea","id":"RHEA-COMP:11726"},{"database":"Rhea","id":"RHEA-COMP:11732"},{"database":"Rhea","id":"RHEA-COMP:11733"},{"database":"ChEBI","id":"CHEBI:13193"},{"database":"ChEBI","id":"CHEBI:15378"},{"database":"ChEBI","id":"CHEBI:17499"},{"database":"ChEBI","id":"CHEBI:29950"},{"database":"ChEBI","id":"CHEBI:30616"},{"database":"ChEBI","id":"CHEBI:33019"},{"database":"ChEBI","id":"CHEBI:61963"},{"database":"ChEBI","id":"CHEBI:87171"},{"database":"ChEBI","id":"CHEBI:87172"},{"database":"ChEBI","id":"CHEBI:456215"}],"ecNumber":"2.8.1.14","evidences":[{"evidenceCode":"ECO:0000305","source":"PubMed","id":"15509579"}]},"physiologicalReactions":[{"directionType":"left-to-right","reactionCrossReference":{"database":"Rhea","id":"RHEA:47041"},"evidences":[{"evidenceCode":"ECO:0000305","source":"PubMed","id":"15509579"}]}]},{"commentType":"INTERACTION","interactions":[{"interactantOne":{"uniProtKBAccession":"O75648","intActId":"EBI-2876757"},"interactantTwo":{"uniProtKBAccession":"P11226","geneName":"MBL2","intActId":"EBI-5325353"},"numberOfExperiments":3,"organismDiffer":false}]},{"commentType":"SUBCELLULAR LOCATION","subcellularLocations":[{"location":{"evidences":[{"evidenceCode":"ECO:0000269","source":"PubMed","id":"15509579"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"15944150"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"16513084"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"16826519"}],"value":"Mitochondrion","id":"SL-0173"}}]},{"commentType":"ALTERNATIVE PRODUCTS","events":["Alternative splicing"],"isoforms":[{"name":{"value":"1"},"isoformIds":["O75648-1"],"isoformSequenceStatus":"Displayed"},{"name":{"value":"2"},"isoformIds":["O75648-2"],"sequenceIds":["VSP_035395"],"isoformSequenceStatus":"Described"},{"name":{"value":"3"},"isoformIds":["O75648-3"],"sequenceIds":["VSP_035391","VSP_035392","VSP_035395"],"isoformSequenceStatus":"Described"},{"name":{"value":"4"},"isoformIds":["O75648-4"],"sequenceIds":["VSP_035391","VSP_0
0000250","source":"UniProtKB","id":"P25745"}],"value":"During the reaction, ATP is used to activate the C2 atom of U34 by adenylation. After this, the persulfide sulfur on the catalytic cysteine is transferred to the C2 atom of the wobble base (U34) of mitochondrial tRNA(Lys), tRNA(Glu) and tRNA(Gln). The reaction probably involves hydrogen sulfide that is generated from the persulfide intermediate and that acts as a nucleophile towards the activated C2 atom on U34. Subsequently, a transient disulfide bond is formed between the two active site cysteine residues"}],"commentType":"MISCELLANEOUS"},{"texts":[{"evidences":[{"evidenceCode":"ECO:0000305"}],"value":"Belongs to the MnmA/TRMU family"}],"commentType":"SIMILARITY"},{"texts":[{"evidences":[{"evidenceCode":"ECO:0000305","source":"PubMed","id":"16513084"}],"value":"Was originally thought to be a 5-methylaminomethyl-2-methyltransferase involved in tRNA modification"}],"commentType":"CAUTION"}],"features":[{"type":"Chain","location":{"start":{"value":1,"modifier":"EXACT"},"end":{"value":421,"modifier":"EXACT"}},"description":"Mitochondrial tRNA-specific 2-thiouridylase 1","featureId":"PRO_0000121708"},{"type":"Region","location":{"start":{"value":96,"modifier":"EXACT"},"end":{"value":98,"modifier":"EXACT"}},"description":"Interaction with target base in tRNA","evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P25745"}]},{"type":"Region","location":{"start":{"value":171,"modifier":"EXACT"},"end":{"value":173,"modifier":"EXACT"}},"description":"Interaction with tRNA","evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P25745"}]},{"type":"Region","location":{"start":{"value":334,"modifier":"EXACT"},"end":{"value":335,"modifier":"EXACT"}},"description":"Interaction with tRNA","evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P25745"}]},{"type":"Region","location":{"start":{"value":395,"modifier":"EXACT"},"end":{"value":421,"modifier":"EXACT"}},"description":"Disor
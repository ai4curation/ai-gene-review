      {
        "id": "GO:0015761",
        "isObsolete": false,
        "name": "mannose transmembrane transport",
        "definition": {
          "text": "The process in which mannose is transported across a lipid bilayer, from one side of a membrane to the other. Mannose is the aldohexose manno-hexose, the C-2 epimer of glucose. The D-(+)-form is widely distributed in mannans and hemicelluloses and is of major importance in the core oligosaccharide of N-linked oligosaccharides of glycoproteins."
        },
        "synonyms": [
          {
            "name": "mannose transport",
            "type": "related"
          }
        ],

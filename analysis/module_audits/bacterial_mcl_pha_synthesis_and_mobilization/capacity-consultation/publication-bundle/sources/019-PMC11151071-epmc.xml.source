<?xml version="1.0" encoding="UTF-8"?><article xml:lang="en" article-type="review-article"><front><journal-meta><journal-id journal-id-type="pmc-domain-id">3786</journal-id><journal-id journal-id-type="pmc-domain">englifesci</journal-id><journal-title-group><journal-title>Engineering in Life Sciences</journal-title><abbrev-journal-title>Eng Life Sci</abbrev-journal-title></journal-title-group><publisher><publisher-name>Maximum Academic Press</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmcid">PMC11151071</article-id><article-id pub-id-type="pmcaid">11151071</article-id><article-id pub-id-type="pmcaiid">11151071</article-id><article-id pub-id-type="pmid">38845815</article-id><article-id pub-id-type="doi">10.1002/elsc.202300211</article-id><title-group><article-title>Current trends in medium‐chain‐length polyhydroxyalkanoates: Microbial production, purification, and characterization</article-title></title-group><contrib-group content-type="author"><contrib><name name-style="western"><surname>Hahn</surname><given-names initials="T">Thomas</given-names></name><xref ref-type="aff" rid="elsc1607-aff-0001">1</xref><xref ref-type="author-notes" rid="_fncrsp93pmc__">✉</xref></contrib><contrib><name name-style="western"><surname>Alzate</surname><given-names initials="MO">Melissa Ortega</given-names></name><xref ref-type="aff" rid="elsc1607-aff-0001">1</xref><xref ref-type="aff" rid="elsc1607-aff-0002">2</xref></contrib><contrib><name name-style="western"><surname>Leonhardt</surname><given-names initials="S">Steven</given-names></name><xref ref-type="aff" rid="elsc1607-aff-0001">1</xref></contrib><contrib><name name-style="western"><surname>Tamang</surname><given-names initials="P">Pravesh</given-names></name><xref ref-type="aff" rid="elsc1607-aff-0001">1</xref></contrib><contrib><name name-style="western"><surname>Zibek</surname><given-names initials="S">Susanne</given-names></name><xref ref-type="aff" rid="elsc1607-aff-0001">1</xref><xref ref-type="aff" rid="elsc1607-aff-0003">3</xref></contrib></contrib-group><aff id="elsc1607-aff-0001"><label>

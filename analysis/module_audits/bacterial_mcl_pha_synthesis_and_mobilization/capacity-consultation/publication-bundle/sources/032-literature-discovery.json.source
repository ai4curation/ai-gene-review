    },
    "resultList": {
      "result": [
        {
          "id": "1989978",
          "source": "MED",
          "pmid": "1989978",
          "doi": "10.1016/s0021-9258(18)52227-4",
          "title": "Metabolism of poly(3-hydroxyalkanoates) (PHAs) by Pseudomonas oleovorans. Identification and sequences of genes and function of the encoded proteins in the synthesis and degradation of PHA.",
          "authorString": "Huisman GW, Wonink E, Meima R, Kazemier B, Terpstra P, Witholt B.",
          "authorList": {
            "author": [
              {
                "fullName": "Huisman GW",
                "lastName": "Huisman",
                "firstName": "G W",
                "initials": "GW",
                "authorId": {
                  "type": "ORCID",
                  "value": "0000-0003-1955-1120"
                },
                "authorAffiliationDetailsList": {
                  "authorAffiliation": [
                    {
                      "affiliation": "Department of Biochemistry, University of Groningen, The Netherlands."
                    }
                  ]
                }
              },
              {
                "fullName": "Wonink E",
                "lastName": "Wonink",
                "firstName": "E",
                "initials": "E"
              },
              {

          "journalInfo": {
            "volume": "349",
            "journalIssueId": 3343037,
            "dateOfPublication": "2022 Apr",
            "monthOfPublication": 4,
            "yearOfPublication": 2022,
            "journal": {
              "medlineAbbreviation": "J Biotechnol",
              "title": "Journal of biotechnology",

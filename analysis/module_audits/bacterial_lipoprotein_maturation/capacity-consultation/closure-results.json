  "mechanistic_quotes": [
    {
      "reference_id": "PMID:42580408",
      "supporting_text": "both recombinant LnsA and LnsB are required, along with a phospholipid donor source",
      "interpretation": "Both partners required in Sa purified system.",
      "source_sha256": "80bfe316139f3aaaeb38c9b13d616ded8f600a7b83494a4caa8cb1775a0092fa"
    },
    {
      "reference_id": "PMID:42580408",
      "supporting_text": "S. epidermidis LnsA was unable to partner with S. aureus LnsB",
      "interpretation": "Measured reciprocal-pair failure; not generic family incompatibility.",
      "source_sha256": "80bfe316139f3aaaeb38c9b13d616ded8f600a7b83494a4caa8cb1775a0092fa"
    },
    {
      "reference_id": "PMID:42580408",
      "supporting_text": "S. epidermidis LnsA was catalytically competent with S. epidermidis LnsB",
      "interpretation": "Matched Se pair works in Sa host; not purified Se donor assay.",
      "source_sha256": "80bfe316139f3aaaeb38c9b13d616ded8f600a7b83494a4caa8cb1775a0092fa"
    },
    {
      "reference_id": "PMID:39495918",
      "supporting_text": "we purified Lpp(K58A)-Strep from the \u0394lnt strain carrying pBF9343_0945",
      "interpretation": "Purified reporter, not purified Lnb.",
      "source_sha256": "297646a7d6918a06f5a74dd7dc9057942513525cfeccf0d03d7d2ebd4b0e4849"
    },
    {
      "reference_id": "PMID:34253723",
      "supporting_text": "These data prove that the acyl chain transferred by Lit comes from the sn-2 position of the DAG in the BLP substrate.",
      "interpretation": "Intramolecular relocation retains two chains.",
      "source_sha256": "e6c76dfad23ab05dc87a91ef75e2f67694f5d74028ab11ce1e2f41d690e86267"
    },
    {
      "reference_id": "PMID:40626731",
      "supporting_text": "The wild-type preparation containing B. anthracis (LhaTBa) did not modify DA-LP* substrate",
      "interpretation": "Assay-specific negative constrains universal activity; no accession or PAINT placement invented.",
      "source_sha256": "c918795bdf640c5d03b69ec4df032995cca398eb0fa9cdfb9486a015a1f04e4a"
    },
    {
      "reference_id": "PMID:40626731",
      "supporting_text": "the integral membrane protein YpjA to transfer the ester-linked acetyl group from Ac-HepG to an amide-linked bond",
      "interpretation": "Lipid-carrier donor, not direct acetyl-CoA.",
      "source_sha256": "c918795bdf640c5d03b69ec4df032995cca398eb0fa9cdfb9486a015a1f04e4a"
